  const calcBtn = document.getElementById('vd-calc-btn');
  let mode = 'vd-ac1';

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      mode = tab.getAttribute('data-panel');
      document.getElementById(mode).classList.add('active');
      calculate();
    });
  });

  function getInputs(prefix) {
    return {
      voltage:  parseFloat(document.getElementById(prefix + '_voltage').value)  || 0,
      current:  parseFloat(document.getElementById(prefix + '_current').value)  || 0,
      length:   parseFloat(document.getElementById(prefix + '_length').value)   || 0,
      material: document.getElementById(prefix + '_material').value,
      awg:      document.getElementById(prefix + '_awg').value,
    };
  }

  function calculate() {
    let v, i, L, mat, awg, factor;
    if (mode === 'vd-ac1') {
      const d = getInputs('ac1'); v=d.voltage; i=d.current; L=d.length; mat=d.material; awg=d.awg; factor=2;
    } else if (mode === 'vd-ac3') {
      const d = getInputs('ac3'); v=d.voltage; i=d.current; L=d.length; mat=d.material; awg=d.awg; factor=1.7321;
    } else {
      const d = getInputs('dc');  v=d.voltage; i=d.current; L=d.length; mat=d.material; awg=d.awg; factor=2;
    }

    if (v<=0||i<=0||L<=0) return;

    const rPer1000 = AWG_R[mat][awg];
    const totalR   = (rPer1000 / 1000) * L * factor;
    const vDrop    = i * totalR;
    const dropPct  = (vDrop / v) * 100;
    const atLoad   = v - vDrop;
    const powerLoss = i * i * totalR;

    // display
    document.getElementById('vd-drop-v').textContent     = vDrop.toFixed(2) + ' V';
    document.getElementById('vd-drop-pct').textContent   = dropPct.toFixed(2) + '%';
    document.getElementById('vd-at-load').textContent    = atLoad.toFixed(2) + ' V';
    document.getElementById('vd-resistance').textContent = totalR.toFixed(4) + ' Ω';
    document.getElementById('vd-power-loss').textContent = powerLoss.toFixed(1) + ' W';

    const modeLabel = mode==='vd-ac1' ? 'AC Single-Phase' : mode==='vd-ac3' ? 'AC 3-Phase' : 'DC';
    document.getElementById('vd-res-sub').textContent =
      modeLabel + ' · ' + v + 'V · ' + i + 'A · ' + L + 'ft · ' + awg + ' AWG ' + mat;

    // NEC compliance
    const nec = document.getElementById('vd-nec');
    const necIcon = document.getElementById('vd-nec-icon');
    const necTitle = document.getElementById('vd-nec-title');
    const necMsg   = document.getElementById('vd-nec-msg');
    nec.className = 'vd-nec';
    if (dropPct <= 3) {
      nec.classList.add('pass');
      necIcon.textContent  = '✅';
      necTitle.textContent = 'NEC Compliant — ' + dropPct.toFixed(2) + '% (under 3%)';
      necMsg.textContent   = 'Meets NEC 210.19 recommendation for branch circuits. No wire upgrade needed for voltage drop compliance.';
    } else if (dropPct <= 5) {
      nec.classList.add('warn');
      necIcon.textContent  = '⚠️';
      necTitle.textContent = 'Exceeds 3% Recommendation — ' + dropPct.toFixed(2) + '%';
      necMsg.textContent   = 'Above the NEC 3% recommendation. Acceptable for feeders if combined total stays under 5%, but upgrade wire size for branch circuits.';
    } else {
      nec.classList.add('fail');
      necIcon.textContent  = '❌';
      necTitle.textContent = 'Excessive Drop — ' + dropPct.toFixed(2) + '% (over 5%)';
      necMsg.textContent   = 'Exceeds NEC 5% combined maximum. Equipment damage, overheating, and code issues likely. Upsize wire significantly.';
    }

    // Wire size recommendation — find min AWG for 3% and 2%
    function findMinAWG(targetPct) {
      for (const gauge of AWG_ORDER) {
        const r = (AWG_R[mat][gauge] / 1000) * L * factor;
        const d = (i * r / v) * 100;
        if (d <= targetPct) return gauge;
      }
      return '4/0+';
    }
    const min3 = findMinAWG(3);
    const min2 = findMinAWG(2);
    const currentIsOk = dropPct <= 3;

    document.getElementById('rec-current').textContent = awg + ' AWG ' + mat;
    document.getElementById('rec-min').textContent     = min3 + ' AWG' + (currentIsOk ? ' ✓' : ' ← upgrade needed');
    document.getElementById('rec-rec').textContent     = min2 + ' AWG (2% headroom)';
    document.getElementById('rec-min').className       = 'vd-rec-val ' + (currentIsOk ? 'ok' : 'ng');
  }

  // auto-calc on any input change
  document.querySelectorAll('.vd-field input, .vd-field select').forEach(el => {
    el.addEventListener('change', calculate);
    el.addEventListener('input',  calculate);
  });
  calcBtn.addEventListener('click', calculate);
  calculate();

  // TOC scroll
  const tocLinks = document.querySelectorAll('.vd-toc-list a');
  const sections = [];
  tocLinks.forEach(link => {
    const id  = link.getAttribute('href').replace('#','');
    const sec = document.getElementById(id);
    if (sec) sections.push({ link, sec });
  });
  function updateTOC() {
    const y = window.scrollY + 130;
    let active = sections[0];
    sections.forEach(s => { if (s.sec && s.sec.getBoundingClientRect().top + window.scrollY <= y) active = s; });
    tocLinks.forEach(l => l.classList.remove('vd-active'));
    if (active) active.link.classList.add('vd-active');
  }
  window.addEventListener('scroll', updateTOC, { passive: true });
  updateTOC();

  // FAQ accordion
  document.querySelectorAll('.vd-faq-q').forEach(q => {
    q.addEventListener('click', function () {
      const item    = this.closest('.vd-faq-item');
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.vd-faq-item').forEach(i => i.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
    });
  });

});
</script>
