.vd-tab.active{color:#1d4ed8;border-bottom-color:#1d4ed8;background:#fff;}
.vd-inner{display:grid;grid-template-columns:1fr 1fr;}
.vd-form-col{padding:2rem;border-right:1px solid #f0f4fa;}
.vd-res-col{padding:2rem;background:linear-gradient(160deg,#f8fafc 0%,#eff6ff 100%);}
.vd-panel{display:none;}
.vd-panel.active{display:block;}
.vd-panel-desc{font-size:.85rem;color:#64748b;margin-bottom:1.5rem;line-height:1.5;}

/* Fields */
.vd-field{margin-bottom:1.2rem;}
.vd-field label{display:block;font-weight:600;font-size:.9rem;color:#1e293b;margin-bottom:.4rem;}
.vd-field input,.vd-field select{width:100%;padding:12px 15px;border:1.5px solid #d1dae8;border-radius:8px;font-size:1rem;color:#0f172a;outline:none;transition:border-color .2s,box-shadow .2s;box-sizing:border-box;background:#fff;}
