.vd-field .vd-hint{font-size:.76rem;color:#94a3b8;margin-top:.3rem;line-height:1.4;}
.vd-row2{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}

.vd-btn{width:100%;background:linear-gradient(135deg,#1d4ed8 0%,#1e40af 100%);color:#fff;padding:15px;border:none;border-radius:9px;font-size:1rem;font-weight:700;cursor:pointer;margin-top:.75rem;transition:opacity .2s,transform .15s;}
.vd-btn:hover{opacity:.92;transform:translateY(-1px);}

/* Results */
.vd-res-head{font-size:1.15rem;font-weight:700;color:#0f172a;margin:0 0 .25rem;}
.vd-res-sub{font-size:.84rem;color:#64748b;margin:0 0 1.25rem;}

.vd-primary{background:linear-gradient(135deg,#1d4ed8,#1e40af);border-radius:10px;padding:1.35rem 1rem;text-align:center;box-shadow:0 6px 18px rgba(29,78,216,.22);margin-bottom:.75rem;}
.vd-primary-val{display:block;font-size:2.4rem;font-weight:800;color:#fff;line-height:1;margin-bottom:.2rem;}
.vd-primary-lbl{font-size:.88rem;color:rgba(255,255,255,.8);}

.vd-boxes{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-bottom:.85rem;}
.vd-box{background:#fff;border:1.5px solid #e8edf5;border-radius:10px;padding:.85rem .75rem;text-align:center;}
.vd-box-val{display:block;font-size:1.15rem;font-weight:800;color:#1d4ed8;margin-bottom:.15rem;}
.vd-box-lbl{font-size:.72rem;color:#64748b;font-weight:600;line-height:1.3;}

/* NEC compliance badge */
.vd-nec{border-radius:10px;padding:1rem 1.1rem;margin-bottom:.85rem;display:flex;align-items:flex-start;gap:.75rem;}
.vd-nec.pass{background:#f0fdf4;border:1.5px solid #86efac;}
.vd-nec.warn{background:#fffbeb;border:1.5px solid #fcd34d;}
.vd-nec.fail{background:#fff1f2;border:1.5px solid #fca5a5;}
.vd-nec-icon{font-size:1.4rem;flex-shrink:0;line-height:1;}
.vd-nec-text{font-size:.88rem;line-height:1.55;}
.vd-nec-text strong{display:block;font-size:.95rem;margin-bottom:.15rem;}

/* Wire recommendation */
.vd-rec{background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:.9rem 1rem;margin-bottom:.75rem;}
.vd-rec-title{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#94a3b8;margin-bottom:.5rem;}
.vd-rec-row{display:flex;justify-content:space-between;align-items:center;font-size:.84rem;padding:.25rem 0;border-bottom:1px solid #f8fafc;}
.vd-rec-row:last-child{border-bottom:none;}
.vd-rec-lbl{color:#64748b;}
.vd-rec-val{font-weight:700;color:#1e293b;}
.vd-rec-val.ok{color:#16a34a;}
.vd-rec-val.ng{color:#dc2626;}

/* Content sections */
.vd-section{background:#fff;border-radius:14px;border:1px solid #eef2f7;box-shadow:0 2px 12px rgba(0,0,0,.03);padding:2.25rem;margin-bottom:2rem;scroll-margin-top:6rem;}
.vd-section h2{font-size:1.65rem;color:#0f172a;margin:0 0 1.25rem;padding-bottom:.75rem;border-bottom:2px solid #f0f4fa;}
.vd-section h3{font-size:1.18rem;color:#1e293b;margin:1.75rem 0 .7rem;}
.vd-section p{color:#475569;line-height:1.75;margin-bottom:1.25rem;font-size:1rem;}
.vd-section ul,.vd-section ol{color:#475569;line-height:1.75;padding-left:1.5rem;margin-bottom:1.25rem;}
.vd-section li{margin-bottom:.5rem;}
.vd-section strong{color:#1e293b;}
.vd-section a{color:#1d4ed8;}
.vd-formula{background:#0f172a;color:#93c5fd;font-family:'Courier New',monospace;font-size:1rem;padding:1.1rem 1.4rem;border-radius:8px;margin:1.25rem 0;line-height:1.9;}
.vd-formula code{display:block;}
.vd-table{width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e8edf5;margin-bottom:1.5rem;}
.vd-table th{background:#1d4ed8;color:#fff;padding:13px 16px;text-align:left;font-size:.88rem;font-weight:600;}
.vd-table td{padding:11px 16px;border-bottom:1px solid #f1f5f9;font-size:.9rem;color:#334155;}
.vd-table tr:last-child td{border-bottom:none;}
.vd-table tr:nth-child(even) td{background:#f8fafc;}
.vd-info{background:#eff6ff;border-left:4px solid #1d4ed8;border-radius:0 8px 8px 0;padding:1rem 1.25rem;margin:1.25rem 0;font-size:.95rem;color:#1e40af;line-height:1.6;}
.vd-warn{background:#fffbeb;border-left:4px solid #d97706;border-radius:0 8px 8px 0;padding:1rem 1.25rem;margin:1.25rem 0;font-size:.95rem;color:#92400e;line-height:1.6;}

/* FAQ */
.vd-faq-item{border-bottom:1px solid #f0f4fa;padding-bottom:1.25rem;margin-bottom:1.25rem;}
.vd-faq-item:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0;}
.vd-faq-q{font-size:1.02rem;font-weight:700;color:#0f172a;margin-bottom:.6rem;cursor:pointer;display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;}
.vd-faq-q::after{content:'+';font-size:1.3rem;color:#1d4ed8;flex-shrink:0;}
.vd-faq-item.open .vd-faq-q::after{content:'−';}
.vd-faq-a{color:#475569;line-height:1.7;font-size:.97rem;display:none;}
.vd-faq-item.open .vd-faq-a{display:block;}

/* Sidebar */
.vd-sidebar{position:sticky;top:6rem;display:flex;flex-direction:column;gap:1.25rem;}
.vd-widget{background:#fff;border-radius:12px;border:1px solid #e8edf5;box-shadow:0 4px 18px rgba(0,0,0,.05);overflow:hidden;}
.vd-widget-head{background:linear-gradient(135deg,#1d4ed8,#1e40af);color:#fff;padding:1rem 1.25rem;}
.vd-widget-title{font-size:1rem;font-weight:700;}
.vd-widget-sub{font-size:.8rem;color:rgba(255,255,255,.75);}
.vd-widget-upd{font-size:.72rem;color:rgba(255,255,255,.6);margin-top:.35rem;}
.vd-widget-rows{padding:.4rem 0;}
.vd-widget-row{display:flex;justify-content:space-between;align-items:center;padding:.6rem 1.25rem;border-bottom:1px solid #f8fafc;transition:background .15s;}
.vd-widget-row:last-child{border-bottom:none;}
.vd-widget-row:hover{background:#eff6ff;}
.vd-wl{font-size:.82rem;font-weight:600;color:#334155;}
.vd-ws{font-size:.72rem;color:#94a3b8;}
.vd-wv{font-size:.95rem;font-weight:800;color:#1d4ed8;white-space:nowrap;text-align:right;}
.vd-widget-foot{padding:.85rem 1.25rem;border-top:1px solid #f0f4fa;background:#f8fafc;}
.vd-widget-foot p{font-size:.75rem;color:#64748b;margin:0 0 .5rem;line-height:1.3;}
.vd-widget-foot a{font-size:.83rem;font-weight:700;color:#1d4ed8;text-decoration:none;display:flex;align-items:center;gap:.35rem;}
.vd-widget-foot a:hover{text-decoration:underline;}
.vd-quick-widget{background:#fff;border-radius:12px;border:1px solid #e8edf5;box-shadow:0 2px 12px rgba(0,0,0,.04);overflow:hidden;}
.vd-quick-head{padding:.9rem 1.25rem;background:#f8fafc;border-bottom:1px solid #f0f4fa;font-size:.83rem;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.5px;}
.vd-quick-links{list-style:none;padding:.5rem 0;margin:0;}
.vd-quick-links li a{display:flex;align-items:center;gap:.5rem;padding:.65rem 1.25rem;font-size:.85rem;color:#475569;text-decoration:none;border-left:3px solid transparent;transition:all .15s;font-weight:500;}
.vd-quick-links li a:hover,.vd-quick-links li a.active{color:#1d4ed8;background:#eff6ff;border-left-color:#1d4ed8;}

/* Responsive */
@media(max-width:1200px){.vd-wrap{grid-template-columns:200px 1fr 240px;}}
@media(max-width:1024px){.vd-wrap{grid-template-columns:1fr;}.vd-toc,.vd-sidebar{position:static;}.vd-sidebar{display:grid;grid-template-columns:1fr 1fr;}}
@media(max-width:768px){.vd-wrap{padding:1rem 1rem 3rem;}.vd-inner{grid-template-columns:1fr;}.vd-form-col{border-right:none;border-bottom:1px solid #f0f4fa;}.vd-sidebar{grid-template-columns:1fr;}.vd-tabs{flex-direction:column;}.vd-tab{border-left:3px solid transparent;border-bottom:none;text-align:left;padding:.75rem 1.25rem;}.vd-tab.active{border-left-color:#1d4ed8;}.vd-row2{grid-template-columns:1fr;}.vd-boxes{grid-template-columns:1fr 1fr;}}
</style>

