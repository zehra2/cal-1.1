<%- include('../partials/header') %>
<style>
body{background:#f8fafc;}*{box-sizing:border-box;}
.about-wrap{max-width:900px;margin:0 auto;padding:48px 20px 64px;}
.about-bc{font-size:.8rem;color:#94a3b8;margin-bottom:1.5rem;}
.about-bc a{color:#64748b;text-decoration:none;}
/* Hero */
.about-hero{background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%);border-radius:16px;padding:48px 40px;margin-bottom:36px;position:relative;overflow:hidden;}
.about-hero::before{content:'';position:absolute;top:-40px;right:-40px;width:220px;height:220px;background:radial-gradient(circle,rgba(37,99,235,.18) 0%,transparent 70%);}
.about-hero h1{font-size:2.1rem;font-weight:900;color:#fff;margin:0 0 10px;line-height:1.2;}
.about-hero p{font-size:1.02rem;color:#94a3b8;line-height:1.7;margin:0 0 18px;max-width:640px;}
.about-hero .badge-row{display:flex;flex-wrap:wrap;gap:8px;}
.about-hero .badge{background:rgba(37,99,235,.18);border:1px solid rgba(37,99,235,.35);color:#93c5fd;font-size:.78rem;font-weight:600;padding:5px 14px;border-radius:20px;}
/* Stats */
.about-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:36px;}
.stat-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:22px 16px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.04);}
.stat-card .sv{display:block;font-size:1.9rem;font-weight:900;color:#1d4ed8;line-height:1;}
.stat-card .sl{font-size:.78rem;color:#64748b;font-weight:600;margin-top:4px;}
/* Sections */
.about-section{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:36px 32px;margin-bottom:24px;box-shadow:0 2px 8px rgba(0,0,0,.04);}
.about-section h2{font-size:1.4rem;font-weight:800;color:#0f172a;margin:0 0 16px;padding-bottom:12px;border-bottom:2px solid #eff6ff;}
.about-section h3{font-size:1.05rem;font-weight:700;color:#1e293b;margin:20px 0 8px;}
.about-section p{color:#475569;line-height:1.78;font-size:.97rem;margin-bottom:14px;}
.about-section p:last-child{margin-bottom:0;}
.about-section a{color:#1d4ed8;font-weight:600;text-decoration:none;}
.about-section a:hover{text-decoration:underline;}
.about-section strong{color:#1e293b;}
.about-section ul{color:#475569;padding-left:1.4rem;line-height:1.78;font-size:.97rem;margin-bottom:14px;}
.about-section ul li{margin-bottom:6px;}
/* Team card */
.team-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:20px 22px;display:flex;align-items:flex-start;gap:16px;margin:16px 0;}
.team-avatar{width:52px;height:52px;background:linear-gradient(135deg,#1d4ed8,#1e40af);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;}
.team-info h4{font-size:.97rem;font-weight:700;color:#0f172a;margin:0 0 3px;}
.team-info .role{font-size:.8rem;color:#1d4ed8;font-weight:600;margin-bottom:6px;}
.team-info p{font-size:.87rem;color:#64748b;margin:0;line-height:1.55;}
/* Values grid */
.values-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px;}
.value-card{background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:16px;}
.value-card .vi{font-size:1.4rem;margin-bottom:6px;}
.value-card h4{font-size:.93rem;font-weight:800;color:#1e40af;margin:0 0 5px;}
.value-card p{font-size:.84rem;color:#475569;margin:0;line-height:1.55;}
/* CTA */
.about-cta{background:linear-gradient(135deg,#1d4ed8,#1e40af);border-radius:14px;padding:32px;text-align:center;margin-top:24px;}
.about-cta h2{color:#fff;font-size:1.4rem;margin:0 0 8px;}
.about-cta p{color:rgba(255,255,255,.8);font-size:.96rem;margin:0 0 18px;}
.about-cta a{display:inline-block;background:#fff;color:#1d4ed8;font-weight:700;padding:11px 26px;border-radius:8px;text-decoration:none;font-size:.93rem;}
@media(max-width:768px){.about-stats{grid-template-columns:1fr 1fr;}.values-grid{grid-template-columns:1fr;}.about-hero{padding:28px 22px;}.about-hero h1{font-size:1.65rem;}.about-section{padding:24px 18px;}.about-wrap{padding:28px 14px 48px;}}
@media(max-width:480px){.about-stats{grid-template-columns:1fr 1fr;}.team-card{flex-direction:column;gap:10px;}}
</style>

