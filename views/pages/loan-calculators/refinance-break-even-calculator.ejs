            <div class="rb-stat"><span class="sv" id="rb-monthly-save">$0</span><span class="sl">Monthly Savings</span></div>
            <div class="rb-stat"><span class="sv" id="rb-total-save">$0</span><span class="sl">Lifetime Interest Saved</span></div>
          </div>
