<script>
function fmt(n){return '$'+Math.round(n).toLocaleString();}
function calcRB(){
  var balance  = parseFloat(document.getElementById('rb-balance').value)||0;
  var curRate  = (parseFloat(document.getElementById('rb-cur-rate').value)||0)/100/12;
  var mRem     = parseInt(document.getElementById('rb-months-rem').value)||0;
  var newRate  = (parseFloat(document.getElementById('rb-new-rate').value)||0)/100/12;
  var newTerm  = (parseInt(document.getElementById('rb-new-term').value)||0)*12;
  var costs    = parseFloat(document.getElementById('rb-costs').value)||0;

  if(balance<=0||curRate<=0||mRem<=0||newRate<=0||newTerm<=0){alert('Please fill all fields.');return;}

  // Current payment on remaining months
  var curPmt = curRate===0 ? balance/mRem : balance*curRate*Math.pow(1+curRate,mRem)/(Math.pow(1+curRate,mRem)-1);
  // New payment
  var newPmt = newRate===0 ? balance/newTerm : balance*newRate*Math.pow(1+newRate,newTerm)/(Math.pow(1+newRate,newTerm)-1);
  var monthlySave = curPmt - newPmt;

  // Break-even
  var beMonths = monthlySave > 0 ? Math.ceil(costs / monthlySave) : 9999;

  // Total interest current loan (remaining)
  var curTotalInt = (curPmt * mRem) - balance;
  // Total interest new loan
  var newTotalInt = (newPmt * newTerm) - balance;
  var lifetimeSave = curTotalInt - newTotalInt;

  document.getElementById('rb-be-months').textContent = beMonths < 9999 ? beMonths + ' months' : 'Never';
  document.getElementById('rb-old-pmt').textContent = fmt(curPmt);
  document.getElementById('rb-new-pmt').textContent = fmt(newPmt);
  document.getElementById('rb-monthly-save').textContent = monthlySave >= 0 ? fmt(monthlySave) : '-'+fmt(-monthlySave);
  document.getElementById('rb-total-save').textContent = lifetimeSave > 0 ? fmt(lifetimeSave) : '-'+fmt(-lifetimeSave);

  var verdict = document.getElementById('rb-verdict');
  var detail  = document.getElementById('rb-detail');

  if(beMonths <= 24 && monthlySave > 0){
    verdict.className = 'rb-verdict good';
    verdict.textContent = 'Refinancing looks WORTHWHILE — break-even in under 2 years';
  } else if(beMonths <= 48 && monthlySave > 0){
    verdict.className = 'rb-verdict neutral';
    verdict.textContent = 'Refinancing MAY be worthwhile — depends on how long you stay';
  } else {
    verdict.className = 'rb-verdict bad';
    verdict.textContent = monthlySave <= 0 ? 'New rate is NOT lower — refinancing not recommended at this rate' : 'Break-even is very long — consider only if staying ' + Math.ceil(beMonths/12) + '+ years';
  }

  detail.innerHTML = 'Monthly savings: <strong>' + fmt(Math.abs(monthlySave)) + '</strong> &nbsp;|&nbsp; Closing costs recovered after <strong>' + (beMonths < 9999 ? beMonths + ' months (' + (beMonths/12).toFixed(1) + ' years)' : 'N/A') + '</strong>' + (lifetimeSave > 0 ? ' &nbsp;|&nbsp; Total interest saved over new loan life: <strong>' + fmt(lifetimeSave) + '</strong>' : ' &nbsp;|&nbsp; Note: Extending term increases total interest paid even with lower rate.');

  document.getElementById('rb-result').style.display = 'block';
}
</script>
