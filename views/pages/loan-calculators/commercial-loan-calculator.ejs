    <ul>
      <li><a href="/real-estate/dscr-calculator">DSCR Calculator</a> &mdash; Analyze residential investment Debt Service Coverage Ratios.</li>
      <li><a href="/loan-calculators/sba-loan-calculator">SBA 7(a) Loan Calculator</a> &mdash; Small business government-guaranteed financing calculator.</li>
      <li><a href="/real-estate/cap-rate-calculator">Cap Rate Calculator</a> &mdash; Calculate Capitalization Rate and property valuations.</li>
      <li><a href="/real-estate/cash-on-cash-return-calculator">Cash-on-Cash Return Calculator</a> &mdash; Calculate leveraged real estate return on invested equity.</li>
    </ul>
  </div>
</main>

<script>
function calculateCommercialLoan() {
  var price = parseFloat(document.getElementById('commPrice').value) || 0;
  var loan = parseFloat(document.getElementById('commLoan').value) || 0;
  var rate = (parseFloat(document.getElementById('commRate').value) || 7.25) / 100;
  var amortYears = parseInt(document.getElementById('commAmort').value) || 25;
  var balloonYears = parseInt(document.getElementById('commBalloon').value) || 10;
  var ioYears = parseInt(document.getElementById('commIo').value) || 0;
  var noi = parseFloat(document.getElementById('commNoi').value) || 0;

  var r = rate / 12;
  var n = amortYears * 12;
  var monthlyPi = 0;
  var monthlyIo = loan * r;

  if (r > 0 && n > 0 && loan > 0) {
    monthlyPi = loan * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
  }

  // Calculate Balloon balance after balloonYears
  var balance = loan;
  var totalInterestTerm = 0;
  var totalMonths = Math.min(balloonYears, amortYears) * 12;
  var ioMonths = ioYears * 12;

  for (var m = 1; m <= totalMonths; m++) {
    var interestPayment = balance * r;
    totalInterestTerm += interestPayment;
    if (m > ioMonths) {
      var principalPayment = monthlyPi - interestPayment;
      balance -= principalPayment;
    }
  }

  var balloonBalance = balloonYears >= amortYears ? 0 : Math.max(0, balance);
  var annualDebtService = ioYears > 0 ? (monthlyIo * 12) : (monthlyPi * 12);
  var dscr = annualDebtService > 0 ? (noi / annualDebtService) : 0;
  var debtYield = loan > 0 ? (noi / loan) * 100 : 0;
  var ltv = price > 0 ? (loan / price) * 100 : 0;
  var requiredEquity = Math.max(0, price - loan);

  var dscrRating = 'Weak (< 1.15x)';
  if (dscr >= 1.35) dscrRating = 'Strong (1.35x+)';
  else if (dscr >= 1.20) dscrRating = 'Qualifies (1.20x - 1.34x)';

  document.getElementById('resMonthlyPi').textContent = '$' + Math.round(monthlyPi).toLocaleString() + ' / mo';
  if (ioYears > 0) {
    document.getElementById('resIoLabel').textContent = ioYears + '-Yr I/O: $' + Math.round(monthlyIo).toLocaleString() + ' / mo, then Amortized';
  } else {
    document.getElementById('resIoLabel').textContent = 'Fully Amortizing ' + amortYears + '-Year Schedule';
  }

  document.getElementById('resBalloonAmt').textContent = balloonBalance > 0 ? '$' + Math.round(balloonBalance).toLocaleString() : '$0 (Fully Paid)';
  document.getElementById('resDscr').textContent = dscr.toFixed(2) + 'x (' + dscrRating + ')';
  document.getElementById('resDebtYield').textContent = debtYield.toFixed(2) + '%';
  document.getElementById('resLtv').textContent = ltv.toFixed(1) + '%';
  document.getElementById('resTermInterest').textContent = '$' + Math.round(totalInterestTerm).toLocaleString();
  document.getElementById('resEquity').textContent = '$' + Math.round(requiredEquity).toLocaleString();
}

document.querySelectorAll('#commPrice, #commLoan, #commRate, #commAmort, #commBalloon, #commIo, #commNoi').forEach(function(el) {
  el.addEventListener('input', calculateCommercialLoan);
  el.addEventListener('change', calculateCommercialLoan);
});
calculateCommercialLoan();
</script>
