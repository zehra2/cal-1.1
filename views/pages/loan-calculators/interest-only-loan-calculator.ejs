<script>
document.addEventListener('DOMContentLoaded', function () {

  const tabs   = document.querySelectorAll('.io-tab');
  const panels = document.querySelectorAll('.io-panel');
  let mode = 'io-mortgage';

  tabs.forEach(t => {
    t.addEventListener('click', () => {
      tabs.forEach(x => x.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      t.classList.add('active');
      mode = t.getAttribute('data-panel');
      document.getElementById(mode).classList.add('active');
      calculate();
    });
  });

  const fmtC  = v => '$' + Math.round(v).toLocaleString('en-US');
  const fmtCd = v => '$' + Number(v).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const fmtN  = (v,d=2) => Number(v).toFixed(d);

  function pmt(rate, nper, pv) {
    if (rate === 0) return pv / nper;
    return pv * (rate * Math.pow(1+rate, nper)) / (Math.pow(1+rate, nper) - 1);
  }

  function calculate() {
    if (mode === 'io-mortgage') calcMortgage();
    else if (mode === 'io-heloc') calcHELOC();
    else calcConstruction();
  }

  // ── MORTGAGE ──
  function calcMortgage() {
    const principal  = parseFloat(document.getElementById('m_amount').value)   || 0;
    const annualRate = parseFloat(document.getElementById('m_rate').value)      || 0;
    const ioYears    = parseInt(document.getElementById('m_io_years').value)    || 0;
    const termYears  = parseInt(document.getElementById('m_term').value)        || 30;
    const extra      = parseFloat(document.getElementById('m_extra').value)     || 0;
    if (principal <= 0 || annualRate <= 0) return;

    const monthlyRate  = annualRate / 100 / 12;
    const ioMonths     = ioYears * 12;
    const totalMonths  = termYears * 12;
    const amortMonths  = totalMonths - ioMonths;

    // IO payment (starting interest-only payment + optional extra principal)
    const ioPayment    = principal * monthlyRate;
    const totalIOPay   = ioPayment + extra;

    // Balance after IO period, and true interest accrued during IO period.
    // Tracked month-by-month because extra principal payments shrink the
    // balance (and therefore the interest due) each month — a flat
    // principal × rate × months estimate overstates interest whenever
    // extra > 0.
    let balance = principal;
    let totalIOInterest = 0;
    for (let m = 0; m < ioMonths; m++) {
      totalIOInterest += balance * monthlyRate;
      balance -= extra;
      if (balance < 0) balance = 0;
    }

    // Amortized payment after IO period
    const amortPayment = amortMonths > 0 ? pmt(monthlyRate, amortMonths, balance) : 0;

    // Totals
    const totalAmortInterest = (amortPayment * amortMonths) - balance;
    const totalInterest      = totalIOInterest + totalAmortInterest;
    const totalPaid          = totalIOInterest + extra * ioMonths + amortPayment * amortMonths;

    const shock = amortPayment - ioPayment;
    const shockPct = ioPayment > 0 ? (shock / ioPayment * 100) : 0;

    updateDisplay(ioPayment, amortPayment, shock, shockPct, totalInterest, totalPaid, principal,
      ioYears + ' yrs', amortMonths / 12 + ' yrs',
      fmtC(totalIOInterest), fmtC(totalAmortInterest),
      'IO Period: ' + ioYears + ' yrs · Amortization: ' + (amortMonths/12) + ' yrs');

    buildAmortTable(principal, monthlyRate, ioMonths, amortPayment, extra);
  }

  // ── HELOC ──
  function calcHELOC() {
    const balance   = parseFloat(document.getElementById('h_balance').value)   || 0;
    const annualRate= parseFloat(document.getElementById('h_rate').value)      || 0;
    const drawRem   = parseInt(document.getElementById('h_draw_rem').value)    || 0;
    const repayYrs  = parseInt(document.getElementById('h_repay').value)       || 20;
    if (balance <= 0 || annualRate <= 0) return;

    const monthlyRate   = annualRate / 100 / 12;
    const ioMonths      = drawRem * 12;
    const repayMonths   = repayYrs * 12;

    const ioPayment     = balance * monthlyRate;
    const repayPayment  = repayMonths > 0 ? pmt(monthlyRate, repayMonths, balance) : 0;
    const totalIOInt    = ioPayment * ioMonths;
    const totalRepayInt = (repayPayment * repayMonths) - balance;
    const totalInterest = totalIOInt + totalRepayInt;
    const totalPaid     = totalIOInt + repayPayment * repayMonths;
    const shock         = repayPayment - ioPayment;
    const shockPct      = ioPayment > 0 ? (shock / ioPayment * 100) : 0;

    updateDisplay(ioPayment, repayPayment, shock, shockPct, totalInterest, totalPaid, balance,
      drawRem + ' yrs remaining', repayYrs + ' yrs',
      fmtC(totalIOInt), fmtC(totalRepayInt),
      'Draw period: ' + drawRem + ' yrs remaining · Repay: ' + repayYrs + ' yrs');

    buildAmortTable(balance, monthlyRate, ioMonths, repayPayment, 0);
  }

  // ── CONSTRUCTION ──
  function calcConstruction() {
    const total      = parseFloat(document.getElementById('c_total').value)     || 0;
    const cRate      = parseFloat(document.getElementById('c_rate').value)      || 0;
    const months     = parseInt(document.getElementById('c_months').value)      || 12;
    const permRate   = parseFloat(document.getElementById('c_perm_rate').value) || 0;
    const permTerm   = parseInt(document.getElementById('c_perm_term').value)   || 30;
    const drawPct    = parseFloat(document.getElementById('c_draw_pct').value)  || 50;
    if (total <= 0 || cRate <= 0) return;

    const avgDraw        = total * (drawPct / 100);
    const constMonthly   = cRate / 100 / 12;
    const avgIOPayment   = avgDraw * constMonthly;
    const totalConstInt  = avgIOPayment * months;

    const permMonthly    = permRate / 100 / 12;
    const permMonths     = permTerm * 12;
    const permPayment    = pmt(permMonthly, permMonths, total);
    const totalPermInt   = (permPayment * permMonths) - total;
    const totalInterest  = totalConstInt + totalPermInt;
    const totalPaid      = totalConstInt + permPayment * permMonths;
    const shock          = permPayment - avgIOPayment;
    const shockPct       = avgIOPayment > 0 ? (shock / avgIOPayment * 100) : 0;

    updateDisplay(avgIOPayment, permPayment, shock, shockPct, totalInterest, totalPaid, total,
      months + ' mos build', permTerm + ' yrs',
      fmtC(totalConstInt), fmtC(totalPermInt),
      'Build: ' + months + ' months IO · Permanent: ' + permTerm + ' yr mortgage');

    buildAmortTable(total, permMonthly, 0, permPayment, 0);
  }

  function updateDisplay(ioPay, fullPay, shock, shockPct, totalInt, totalPaid, principal,
                         ioPeriod, amPeriod, ioIntStr, amIntStr, subText) {
    document.getElementById('io-primary-val').textContent = fmtC(ioPay) + '/mo';
    document.getElementById('io-res-sub').textContent     = subText;
    document.getElementById('io-box1').textContent        = fmtC(fullPay) + '/mo';
    document.getElementById('io-box2').textContent        = shock >= 0 ? '+' + fmtC(shock) : fmtC(shock);
    document.getElementById('io-box3').textContent        = fmtC(totalInt);
    document.getElementById('io-box4').textContent        = fmtC(totalPaid);

    // Phase comparison
    document.getElementById('ph-io-period').textContent  = ioPeriod;
    document.getElementById('ph-io-pay').textContent     = fmtC(ioPay) + '/month';
    document.getElementById('ph-am-period').textContent  = amPeriod;
    document.getElementById('ph-am-pay').textContent     = fmtC(fullPay) + '/month';
    document.getElementById('ph-io-int').textContent     = ioIntStr;
    document.getElementById('ph-am-int').textContent     = amIntStr;

    const shockEl = document.getElementById('ph-shock');
    if (shock > 0) {
      shockEl.textContent = '⚠️ Payment shock: +' + fmtC(shock) + '/month (+' + fmtN(shockPct,1) + '%) when IO period ends.';
      shockEl.style.display = 'block';
    } else {
      shockEl.style.display = 'none';
    }

    // Cost bar
    const ioIntAmt = parseFloat(ioIntStr.replace(/[$,]/g,'')) || 0;
    const amIntAmt = parseFloat(amIntStr.replace(/[$,]/g,'')) || 0;
    const total3   = ioIntAmt + amIntAmt + principal;
    if (total3 > 0) {
      document.getElementById('bar-io-int').style.width = (ioIntAmt/total3*100).toFixed(1) + '%';
      document.getElementById('bar-am-int').style.width = (amIntAmt/total3*100).toFixed(1) + '%';
      document.getElementById('bar-princ').style.width  = (principal/total3*100).toFixed(1) + '%';
      const pioLabel = (ioIntAmt/total3*100) > 8 ? 'IO Int ' + (ioIntAmt/total3*100).toFixed(0)+'%' : '';
      const pamLabel = (amIntAmt/total3*100) > 8 ? 'Int '+(amIntAmt/total3*100).toFixed(0)+'%' : '';
      const pprLabel = (principal/total3*100) > 8 ? 'Principal '+(principal/total3*100).toFixed(0)+'%' : '';
      document.getElementById('bar-io-int').textContent = pioLabel;
      document.getElementById('bar-am-int').textContent = pamLabel;
      document.getElementById('bar-princ').textContent  = pprLabel;
    }
  }

  // ── AMORTIZATION TABLE ──
  function buildAmortTable(principal, monthlyRate, ioMonths, amortPayment, extra) {
    const tbody   = document.getElementById('io-amort-body');
    tbody.innerHTML = '';
    let balance   = principal;
    const maxRows = Math.min(ioMonths + 360, 480); // cap at 40 years
    let prevPhase = 'IO';

    for (let m = 1; m <= maxRows; m++) {
      const inIO        = m <= ioMonths;
      const interest    = balance * monthlyRate;
      let principalPmt  = 0;
      let payment;

      if (inIO) {
        principalPmt = extra;
        payment      = interest + extra;
      } else {
        payment      = amortPayment;
        principalPmt = Math.min(payment - interest, balance);
      }
      balance -= principalPmt;
      if (balance < 0.01) balance = 0;

      const phase      = inIO ? 'IO' : 'Amort.';
      const tr         = document.createElement('tr');

      // Highlight phase switch
      if (prevPhase === 'IO' && phase === 'Amort.') {
        tr.className = 'io-phase-switch';
      }
      prevPhase = phase;

      tr.innerHTML =
        '<td>' + m + '</td>' +
        '<td>' + phase + '</td>' +
        '<td>' + fmtCd(payment) + '</td>' +
        '<td>' + fmtCd(principalPmt) + '</td>' +
        '<td>' + fmtCd(interest) + '</td>' +
        '<td>' + fmtCd(balance) + '</td>';
      tbody.appendChild(tr);

      if (balance <= 0) break;
    }
  }

  // ── AUTO-CALC ON INPUT ──
  document.querySelectorAll('.io-field input, .io-field select').forEach(el => {
    el.addEventListener('input',  calculate);
    el.addEventListener('change', calculate);
  });
  document.getElementById('io-calc-btn').addEventListener('click', calculate);
  calculate();

  // ── AMORTIZATION TOGGLE ──
  document.getElementById('io-amort-toggle').addEventListener('click', function () {
    const wrap  = document.getElementById('io-amort-wrap');
    const arrow = document.getElementById('io-amort-arrow');
    if (wrap.classList.contains('show')) {
      wrap.classList.remove('show');
      arrow.textContent = '▼';
      this.querySelector('span').textContent = '📊 Show Full Amortization Schedule';
    } else {
      wrap.classList.add('show');
      arrow.textContent = '▲';
      this.querySelector('span').textContent = '📊 Hide Amortization Schedule';
    }
  });

  // ── TOC SCROLL ──
  const tocLinks = document.querySelectorAll('.io-toc-list a');
  const sections = [];
  tocLinks.forEach(link => {
    const id  = link.getAttribute('href').replace('#', '');
    const sec = document.getElementById(id);
    if (sec) sections.push({ link, sec });
  });
  function updateTOC() {
    const y = window.scrollY + 130;
    let active = sections[0];
    sections.forEach(s => { if (s.sec && s.sec.getBoundingClientRect().top + window.scrollY <= y) active = s; });
    tocLinks.forEach(l => l.classList.remove('io-toc-active'));
    if (active) active.link.classList.add('io-toc-active');
  }
  window.addEventListener('scroll', updateTOC, { passive: true });
  updateTOC();

  // ── FAQ ACCORDION ──
  document.querySelectorAll('.io-faq-q').forEach(q => {
    q.addEventListener('click', function () {
      const item    = this.closest('.io-faq-item');
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.io-faq-item').forEach(i => i.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
    });
  });

});
</script>
