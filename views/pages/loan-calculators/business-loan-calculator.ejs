<script>
// ==========================================================================
// COMMERCIAL BUSINESS LOAN DUAL ENGINE JAVASCRIPT
// ==========================================================================

const fmtCurr = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

function calculateBizLoan() {
  const principal = parseFloat(document.getElementById('b_loan_amount').value) || 0;
  const rateA = parseFloat(document.getElementById('b_rate_a').value) || 0;
  const termA = parseInt(document.getElementById('b_term_a').value, 10) || 10;
  const nameA = document.getElementById('b_name_a').value || 'Scenario A';

  const rateB = parseFloat(document.getElementById('b_rate_b').value) || 0;
  const termB = parseInt(document.getElementById('b_term_b').value, 10) || 5;
  const nameB = document.getElementById('b_name_b').value || 'Scenario B';

  if (principal <= 0 || rateA <= 0 || rateB <= 0 || termA <= 0 || termB <= 0) return;

  // Calculation Function
  function calcPmt(P, annualRate, years) {
    const r = (annualRate / 100) / 12;
    const n = years * 12;
    let pmt = 0;
    if (r > 0 && n > 0) {
      pmt = P * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    } else if (n > 0) {
      pmt = P / n;
    }
    const total = pmt * n;
    const interest = total - P;
    return { pmt, total, interest, n };
  }

  const resA = calcPmt(principal, rateA, termA);
  const resB = calcPmt(principal, rateB, termB);

  // Update DOM Labels
  document.getElementById('lbl_a_badge').textContent = nameA;
  document.getElementById('lbl_b_badge').textContent = nameB;
  document.getElementById('res_lbl_a').textContent = nameA + ' Payment';
  document.getElementById('res_lbl_b').textContent = nameB + ' Payment';

  // Update Scenario A Values
  document.getElementById('res_pmt_a').textContent = fmtCurr.format(resA.pmt);
  document.getElementById('res_int_a').textContent = fmtCurr.format(resA.interest);
  document.getElementById('res_tot_a').textContent = fmtCurr.format(resA.total);
  document.getElementById('res_dscr_a').textContent = fmtCurr.format(resA.pmt * 1.25);

  // Update Scenario B Values
  document.getElementById('res_pmt_b').textContent = fmtCurr.format(resB.pmt);
  document.getElementById('res_int_b').textContent = fmtCurr.format(resB.interest);
  document.getElementById('res_tot_b').textContent = fmtCurr.format(resB.total);
  document.getElementById('res_dscr_b').textContent = fmtCurr.format(resB.pmt * 1.25);

  // Cash Flow & Interest Differences
  const pmtDiff = Math.abs(resA.pmt - resB.pmt);
  const intDiff = Math.abs(resA.interest - resB.interest);

  const lowerPmtName = resA.pmt < resB.pmt ? nameA : nameB;
  const lowerIntName = resA.interest < resB.interest ? nameA : nameB;

  document.getElementById('savings_banner').innerHTML = `<span>💡 <strong>Cash Flow Analysis:</strong> <strong>${lowerPmtName}</strong> saves <strong>${fmtCurr.format(pmtDiff)}/month</strong> in cash flow, while <strong>${lowerIntName}</strong> saves <strong>${fmtCurr.format(intDiff)}</strong> in total lifetime interest.</span>`;

  // Bars Comparison
  const maxTotal = Math.max(resA.total, resB.total);
  const barA = (resA.total / maxTotal) * 100;
  document.getElementById('bar_fill_a').style.width = barA + '%';
  document.getElementById('bar_lbl_a').textContent = `${nameA} Total Cost: ${fmtCurr.format(resA.total)}`;
  document.getElementById('bar_lbl_b').textContent = `${nameB} Total Cost: ${fmtCurr.format(resB.total)}`;
}

function toggleFaq(trigger) {
  const card = trigger.closest('.faq-card');
  const isOpen = card.classList.contains('open');
  document.querySelectorAll('.faq-card').forEach(c => c.classList.remove('open'));
  if (!isOpen) {
    card.classList.add('open');
  }
}

document.addEventListener('DOMContentLoaded', function() {
  calculateBizLoan();
});
</script>
