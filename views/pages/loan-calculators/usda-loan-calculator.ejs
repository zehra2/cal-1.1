<%- include('../../partials/header') %>
<main id="main-content" class="container">
  <div class="calculator-header">
    <h1>USDA Loan Calculator (<%= currentYear %>)</h1>
    <p class="lead-description">
      Estimate your monthly payment on a <strong>0% down USDA Rural Development mortgage</strong>. Calculates the mandatory 1.00% Upfront Guarantee Fee, 0.35% Annual Guarantee Fee, property taxes, and compares USDA savings against FHA and Conventional loans.
    </p>
  </div>

  <div class="calculator-layout">
    <!-- LEFT INPUT PANEL -->
    <div class="calculator-panel">
      <h2 class="panel-title">USDA Mortgage Parameters</h2>

      <div class="form-group">
        <label for="usdaPrice">Home Purchase Price ($):</label>
        <input type="number" id="usdaPrice" class="form-control" value="325000" min="10000" step="5000">
        <span class="field-hint">Eligible rural / suburban home purchase price.</span>
      </div>

      <div class="form-group">
        <label for="usdaDownPct">Down Payment (%):</label>
        <select id="usdaDownPct" class="form-control">
          <option value="0" selected>0% Down ($0 Out of Pocket &ndash; Standard)</option>
          <option value="3">3.0% Down Payment</option>
          <option value="5">5.0% Down Payment</option>
          <option value="10">10.0% Down Payment</option>
        </select>
      </div>

      <div class="form-group">
        <label for="usdaFinanceFee">Finance 1.00% Upfront Guarantee Fee?</label>
        <select id="usdaFinanceFee" class="form-control">
          <option value="yes" selected>Yes &ndash; Add 1.00% to Financed Balance</option>
          <option value="no">No &ndash; Pay Upfront in Cash at Settlement</option>
        </select>
      </div>

      <div class="form-group">
        <label for="usdaLoanTerm">Loan Term:</label>
        <select id="usdaLoanTerm" class="form-control">
          <option value="30" selected>30-Year Fixed (Standard USDA)</option>
          <option value="15">15-Year Fixed</option>
        </select>
      </div>

      <div class="form-group">
        <label for="usdaRate">Interest Rate (% APR):</label>
        <input type="number" id="usdaRate" class="form-control" value="6.25" min="1.0" max="15.0" step="0.05">
        <span class="field-hint">Current 2026 prevailing 30-year USDA fixed benchmark rate.</span>
      </div>

      <div class="form-group">
        <label for="usdaTaxRate">Annual Property Tax Rate (%):</label>
        <input type="number" id="usdaTaxRate" class="form-control" value="1.15" min="0" max="4.0" step="0.05">
      </div>

      <div class="form-group">
        <label for="usdaInsurance">Annual Homeowners Insurance ($):</label>
        <input type="number" id="usdaInsurance" class="form-control" value="1350" min="0" step="50">
      </div>

      <div class="form-group">
        <label for="usdaHoa">Monthly HOA / Road Maintenance Fees ($):</label>
        <input type="number" id="usdaHoa" class="form-control" value="0" min="0" step="25">
      </div>
    </div>

    <!-- RIGHT RESULTS PANEL -->
    <div class="calculator-panel results-panel">
      <h2 class="panel-title">Your Estimated USDA Monthly Payment</h2>

      <div class="highlight-metric">
        <div class="metric-label">Total Monthly Housing Payment (PITI + USDA Fee)</div>
        <div class="metric-value primary-value" id="resUsdaTotalMonthly">$0</div>
        <div class="metric-sub" id="resUsdaPIBreakdown">Principal &amp; Interest: $0 / mo</div>
      </div>

      <div class="results-grid">
        <div class="result-card">
          <div class="result-title">USDA Annual Fee (0.35%)</div>
          <div class="result-number" id="resUsdaMonthlyFee">$0 / mo</div>
          <div class="result-desc">Paid monthly over life of loan</div>
        </div>

        <div class="result-card">
          <div class="result-title">Upfront Fee (1.00%)</div>
          <div class="result-number" id="resUsdaUpfrontFee">$0</div>
          <div class="result-desc" id="resUsdaFinancedDesc">Total Financed: $0</div>
        </div>

        <div class="result-card">
          <div class="result-title">Down Payment Required</div>
          <div class="result-number" id="resUsdaDownAmt">$0</div>
          <div class="result-desc">0% Down Financing Option</div>
        </div>

        <div class="result-card success-card">
          <div class="result-title">Monthly MIP Savings vs FHA</div>
          <div class="result-number text-success" id="resUsdaFhaSavings">+$55 / mo</div>
          <div class="result-desc">0.35% USDA vs 0.55% FHA fee</div>
        </div>
      </div>

      <div class="summary-breakdown">
        <h3>USDA Loan Amortization Summary</h3>
        <table class="summary-table">
          <tr><td>Home Purchase Price:</td><td id="resSumUsdaPrice">$0</td></tr>
          <tr><td>Down Payment (Cash at Settlement):</td><td id="resSumUsdaDown">$0</td></tr>
          <tr><td>Upfront Guarantee Fee (1.00%):</td><td id="resSumUsdaUpfront">$0</td></tr>
          <tr><td>Total Financed Mortgage Principal:</td><td id="resSumUsdaPrincipal">$0</td></tr>
          <tr><td>Total Lifetime Interest Paid:</td><td id="resSumUsdaInterest">$0</td></tr>
          <tr><td>Total Lifetime USDA Annual Fees (0.35%):</td><td id="resSumUsdaTotalFees">$0</td></tr>
          <tr class="highlight-row"><td><strong>Total 30-Year Housing Outlay:</strong></td><td><strong id="resSumUsdaGrandTotal">$0</strong></td></tr>
        </table>
      </div>
    </div>
  </div>

  <!-- CONTENT & GUIDES -->
  <div class="calculator-content-body">
    <div class="quick-answer-card">
      <h2>How the USDA Rural Development Loan Program Works in <%= currentYear %></h2>
      <p>
        The <strong>USDA Rural Housing Loan</strong> (Section 502 Guaranteed Loan) is a government-backed mortgage program managed by the United States Department of Agriculture. Its primary purpose is to promote homeownership in rural and suburban communities by providing <strong>100% financing (0% down payment)</strong> with below-market interest rates and the lowest monthly mortgage insurance fees of any government loan program (<strong>0.35% annual fee</strong> vs. FHA's 0.55%).
      </p>
    </div>

    <h2>2026 USDA Guarantee Fee Structure Explained</h2>
    <p>Every USDA loan incorporates two fee elements to protect the lender against default:</p>
    <ul>
      <li><strong>Upfront Guarantee Fee (1.00%):</strong> A one-time charge equal to 1.00% of the loan amount ($3,250 on a $325,000 purchase). 99% of USDA borrowers choose to roll this fee directly into their total loan balance so no cash is required at closing.</li>
      <li><strong>Annual Guarantee Fee (0.35%):</strong> Paid in 12 monthly installments. On a $325,000 base loan, the annual fee is $1,137.50 per year, or just <strong>$94.79 per month</strong>—saving borrowers over $600 per year compared to an equivalent FHA loan.</li>
    </ul>

    <h2>USDA vs. FHA vs. Conventional 97%: Comprehensive 2026 Comparison</h2>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Loan Program</th>
            <th>Min Down Payment</th>
            <th>Upfront Fee</th>
            <th>Annual Insurance Fee</th>
            <th>Geographic Restriction</th>
            <th>Income Limits</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>USDA Rural Loan</strong></td>
            <td class="text-success"><strong>0% ($0)</strong></td>
            <td><strong>1.00%</strong></td>
            <td class="text-success"><strong>0.35% (Lowest)</strong></td>
            <td>Eligible Rural/Suburban areas</td>
            <td>Max 115% Area Median Income</td>
          </tr>
          <tr>
            <td><strong>FHA Loan</strong></td>
            <td>3.5% ($11,375 on $325k)</td>
            <td>1.75% ($5,687)</td>
            <td>0.55% ($149/mo)</td>
            <td>Nationwide (No restriction)</td>
            <td>None</td>
          </tr>
          <tr>
            <td><strong>Conventional 97%</strong></td>
            <td>3.0% ($9,750 on $325k)</td>
            <td>$0 (None)</td>
            <td>0.50% &ndash; 1.00% (PMI)</td>
            <td>Nationwide (No restriction)</td>
            <td>80% AMI for HomeReady</td>
          </tr>
          <tr>
            <td><strong>VA Loan</strong></td>
            <td class="text-success"><strong>0% ($0)</strong></td>
            <td>2.15% (Funding Fee)</td>
            <td class="text-success"><strong>$0 (No Monthly Fee)</strong></td>
            <td>Nationwide (Military only)</td>
            <td>None</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>USDA Eligibility Guidelines: Property &amp; Income Checks</h2>
    <p>To secure approval for a USDA guaranteed home loan, both the borrower and the property must satisfy federal criteria:</p>
    <ul>
      <li><strong>Geographic Eligibility:</strong> The property must be located in a USDA-designated rural area. Over 97% of US landmass qualifies, including thousands of thriving suburbs located outside major metropolitan centers.</li>
      <li><strong>Household Income Limits (115% AMI):</strong> The total combined income of all adult household members cannot exceed 115% of the local Area Median Income (AMI). Baseline limit is $110,650 for 1–4 member households, with generous deductions for child care and dependents.</li>
      <li><strong>Credit &amp; Debt-to-Income (DTI):</strong> Standard underwriting targets a 640 FICO score and a 29/41 DTI ratio (housing payment &le; 29% of gross income; total debt &le; 41%), though GUS automated approvals frequently allow DTI ratios up to 45%+.</li>
    </ul>

        <h2>USDA Direct vs. USDA Guaranteed Loans: Key Differences</h2>
    <p>The Department of Agriculture administers two separate loan channels:</p>
    <ul>
      <li><strong>USDA Guaranteed Loan (Section 502 Guaranteed):</strong> Funded by approved private lenders (banks, mortgage brokers) and insured by the USDA. Available to moderate-income households (up to 115% AMI). This calculator models the Section 502 Guaranteed loan.</li>
      <li><strong>USDA Direct Loan (Section 502 Direct):</strong> Funded directly by the federal government for low and very low-income families (50% to 80% AMI). Features payment assistance subsidies that can reduce effective interest rates down to as low as 1.0% for qualifying households.</li>
    </ul>

    <h2>USDA Property Standards &amp; Inspection Checklist</h2>
    <p>To qualify for USDA financing, the home must serve as safe, sanitary, and structurally sound housing:</p>
    <ul>
      <li><strong>Thermal &amp; Roof Standards:</strong> Functional insulation, weather-stripped windows, and a roof with at least 3 to 5 years of remaining useful life.</li>
      <li><strong>Well &amp; Septic Separation:</strong> Private water wells must meet minimum distance separation requirements from septic tanks and drain fields (typically 50 to 100 feet depending on state health codes).</li>
      <li><strong>Access Requirements:</strong> The property must have direct, paved or all-weather gravel road access with a legally recorded road maintenance agreement if private.</li>
    </ul>

<h2>Frequently Asked Questions (FAQ)</h2>
    <div class="faq-item">
      <h4>What is the minimum down payment for a USDA loan in 2026?</h4>
      <p>USDA loans require 0% down payment (100% financing). Qualified homebuyers can purchase a primary residence in an eligible rural or suburban area with zero cash out of pocket toward the down payment.</p>
    </div>
    <div class="faq-item">
      <h4>How much is the USDA upfront guarantee fee?</h4>
      <p>The USDA Upfront Guarantee Fee is a flat 1.00% of the base loan amount. On a $300,000 home with 0% down, the fee is $3,000. Most borrowers finance this directly into their loan balance, creating an initial principal of $303,000.</p>
    </div>
    <div class="faq-item">
      <h4>What is the USDA annual guarantee fee rate?</h4>
      <p>The USDA annual guarantee fee is 0.35% of the remaining principal balance, divided into 12 monthly installments. On a $300,000 loan, this is approximately $87.50 per month, which is substantially lower than FHA annual MIP (0.55%) or conventional PMI (0.50% to 1.00%).</p>
    </div>
    <div class="faq-item">
      <h4>What are USDA income limits for 2026?</h4>
      <p>To qualify for a USDA Guaranteed loan, your total household income cannot exceed 115% of the Area Median Income (AMI). For a 1-to-4 person household in standard US counties, the baseline income limit is approximately $110,650, reaching $146,000+ in higher-cost suburban markets.</p>
    </div>
    <div class="faq-item">
      <h4>What properties qualify for USDA financing?</h4>
      <p>The home must be located in an area designated as 'rural' by the USDA (which includes towns with populations under 35,000 and many suburban outskirts), must be modest in size, and must serve as the borrower's primary single-family residence.</p>
    </div>
    <div class="faq-item">
      <h4>What credit score is needed for a USDA loan?</h4>
      <p>Most lenders require a minimum credit score of 640 for automated underwriting approval through the USDA Guaranteed Underwriting System (GUS). Borrowers with scores below 640 may qualify through manual underwriting with compensating factors.</p>
    </div>
    <div class="faq-item">
      <h4>Can seller concessions cover USDA closing costs?</h4>
      <p>Yes. The USDA allows sellers to contribute up to 6.0% of the sales price toward the buyer's closing costs, discount points, prepaid taxes, and insurance escrows.</p>
    </div>
    <div class="faq-item">
      <h4>Does the USDA annual fee ever cancel?</h4>
      <p>Unlike conventional PMI which cancels at 20% equity, the USDA annual fee (0.35%) remains for the entire life of the loan. However, because the rate is so low, it remains one of the most affordable government-backed mortgage options available.</p>
    </div>

    <h2>Explore Related Mortgage &amp; Loan Calculators</h2>
    <ul>
      <li><a href="/loan-calculators/va-loan-calculator">VA Loan Calculator</a> &mdash; Estimate 0% down military home payments and fee waivers.</li>
      <li><a href="/loan-calculators/fha-loan-calculator">FHA Loan Calculator</a> &mdash; Calculate 3.5% down mortgage payments and 1.75% UFMIP.</li>
      <li><a href="/loan-calculators/land-loan-calculator">Land Loan Calculator</a> &mdash; Calculate payments for acreage and rural lots.</li>
      <li><a href="/loan-calculators/debt-to-income-calculator">Debt-to-Income (DTI) Calculator</a> &mdash; Check if your ratios satisfy USDA 29/41 underwriting rules.</li>
    </ul>
  </div>
</main>

<script>
function calculateUsdaLoan() {
  var price = parseFloat(document.getElementById('usdaPrice').value) || 0;
  var downPct = (parseFloat(document.getElementById('usdaDownPct').value) || 0) / 100;
  var financeFee = document.getElementById('usdaFinanceFee').value === 'yes';
  var years = parseInt(document.getElementById('usdaLoanTerm').value) || 30;
  var rate = (parseFloat(document.getElementById('usdaRate').value) || 6.25) / 100;
  var taxRate = (parseFloat(document.getElementById('usdaTaxRate').value) || 1.15) / 100;
  var annualIns = parseFloat(document.getElementById('usdaInsurance').value) || 1350;
  var monthlyHoa = parseFloat(document.getElementById('usdaHoa').value) || 0;

  var downPayment = price * downPct;
  var baseLoan = Math.max(0, price - downPayment);
  var upfrontFee = baseLoan * 0.010;
  var totalPrincipal = baseLoan + (financeFee ? upfrontFee : 0);

  // Monthly USDA Annual Fee (0.35% / 12)
  var monthlyUsdaFee = (baseLoan * 0.0035) / 12;

  // Monthly Principal & Interest
  var r = rate / 12;
  var n = years * 12;
  var monthlyPI = 0;
  if (r > 0 && n > 0 && totalPrincipal > 0) {
    monthlyPI = totalPrincipal * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
  }

  var monthlyTax = (price * taxRate) / 12;
  var monthlyIns = annualIns / 12;
  var totalMonthly = monthlyPI + monthlyUsdaFee + monthlyTax + monthlyIns + monthlyHoa;

  var totalInterest = (monthlyPI * n) - totalPrincipal;
  var totalFees = monthlyUsdaFee * n;
  var grandTotal = downPayment + (!financeFee ? upfrontFee : 0) + (monthlyPI * n) + totalFees + (price * taxRate * years) + (annualIns * years);

  // FHA comparison (0.55% MIP)
  var fhaMonthlyMip = (baseLoan * 0.0055) / 12;
  var monthlyFhaSavings = Math.max(0, fhaMonthlyMip - monthlyUsdaFee);

  // Update UI
  document.getElementById('resUsdaTotalMonthly').textContent = '$' + Math.round(totalMonthly).toLocaleString() + ' / mo';
  document.getElementById('resUsdaPIBreakdown').textContent = 'P&I: $' + Math.round(monthlyPI).toLocaleString() + ' / mo';
  document.getElementById('resUsdaMonthlyFee').textContent = '$' + Math.round(monthlyUsdaFee).toLocaleString() + ' / mo';
  document.getElementById('resUsdaUpfrontFee').textContent = '$' + Math.round(upfrontFee).toLocaleString();
  document.getElementById('resUsdaFinancedDesc').textContent = 'Total Financed: $' + Math.round(totalPrincipal).toLocaleString();
  document.getElementById('resUsdaDownAmt').textContent = '$' + Math.round(downPayment).toLocaleString() + ' (' + (downPct * 100).toFixed(0) + '%)';
  document.getElementById('resUsdaFhaSavings').textContent = '+$' + Math.round(monthlyFhaSavings).toLocaleString() + ' / mo';

  document.getElementById('resSumUsdaPrice').textContent = '$' + Math.round(price).toLocaleString();
  document.getElementById('resSumUsdaDown').textContent = '$' + Math.round(downPayment).toLocaleString();
  document.getElementById('resSumUsdaUpfront').textContent = '$' + Math.round(upfrontFee).toLocaleString() + (financeFee ? ' (Financed)' : ' (Cash)');
  document.getElementById('resSumUsdaPrincipal').textContent = '$' + Math.round(totalPrincipal).toLocaleString();
  document.getElementById('resSumUsdaInterest').textContent = '$' + Math.round(totalInterest).toLocaleString();
  document.getElementById('resSumUsdaTotalFees').textContent = '$' + Math.round(totalFees).toLocaleString();
  document.getElementById('resSumUsdaGrandTotal').textContent = '$' + Math.round(grandTotal).toLocaleString();
}

document.querySelectorAll('#usdaPrice, #usdaDownPct, #usdaFinanceFee, #usdaLoanTerm, #usdaRate, #usdaTaxRate, #usdaInsurance, #usdaHoa').forEach(function(el) {
  el.addEventListener('input', calculateUsdaLoan);
  el.addEventListener('change', calculateUsdaLoan);
});

calculateUsdaLoan();
</script>
