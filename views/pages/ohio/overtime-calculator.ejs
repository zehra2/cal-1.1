</main>

<script>
(function () {
  var FED_2026 = {
    single: {
      std: 15750,
      brackets: [
        [12400, 0.10], [50400, 0.12], [105700, 0.22],
        [201775, 0.24], [256225, 0.32], [640600, 0.35], [Infinity, 0.37]
      ]
    },
    mfj: {
      std: 31500,
      brackets: [
        [24800, 0.10], [100800, 0.12], [211400, 0.22],
        [403550, 0.24], [512450, 0.32], [768700, 0.35], [Infinity, 0.37]
      ]
    },
    hoh: {
      std: 23625,
      brackets: [
        [17700, 0.10], [67450, 0.12], [105700, 0.22],
        [201775, 0.24], [256200, 0.32], [640600, 0.35], [Infinity, 0.37]
      ]
    }
  };

  function calcTaxes(annualGross, filing, cityRate, sditRate) {
    var cfg = FED_2026[filing] || FED_2026.single;
    var rem = Math.max(0, annualGross - cfg.std);
    var fed = 0, prev = 0;
    for (var i = 0; i < cfg.brackets.length; i++) {
      var cap = cfg.brackets[i][0], r = cfg.brackets[i][1];
      if (rem <= prev) break;
      fed += (Math.min(rem, cap) - prev) * r;
      prev = cap;
    }
    var ss = Math.min(annualGross, 176100) * 0.062;
    var med = annualGross * 0.0145 + Math.max(0, annualGross - (filing === 'mfj' ? 250000 : 200000)) * 0.009;
    var fica = ss + med;

    var ex = annualGross <= 40000 ? 2400 : (annualGross <= 80000 ? 2150 : 1900);
    var ohTaxable = Math.max(0, annualGross - ex);
    var oh = ohTaxable <= 26050 ? 0 : (ohTaxable - 26050) * 0.0275;
    var local = annualGross * (cityRate + sditRate);
    return { fed: fed, fica: fica, oh: oh, local: local, net: Math.max(0, annualGross - fed - fica - oh - local) };
  }

  function fmt(n) {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calculate() {
    var rate = Math.max(0, parseFloat(document.getElementById('ot-rate').value) || 0);
    var regHrs = Math.max(0, parseFloat(document.getElementById('ot-reg-hrs').value) || 0);
    var otHrs = Math.max(0, parseFloat(document.getElementById('ot-15-hrs').value) || 0);
    var dtHrs = Math.max(0, parseFloat(document.getElementById('ot-20-hrs').value) || 0);
    var freq = parseInt(document.getElementById('ot-freq').value, 10) || 52;
    var filing = document.getElementById('ot-filing').value;
    var cityRate = (parseFloat(document.getElementById('ot-city').value) || 0) / 100;
    var sditRate = Math.max(0, parseFloat(document.getElementById('ot-sdit').value) || 0) / 100;

    document.getElementById('hint-ot-rate').textContent = fmt(rate * 1.5) + '/hr';
    document.getElementById('hint-dt-rate').textContent = fmt(rate * 2.0) + '/hr';

    var wksPerCheck = freq === 26 ? 2 : 1;
    var regPay = regHrs * rate * wksPerCheck;
    var otPay = otHrs * rate * 1.5 * wksPerCheck;
    var dtPay = dtHrs * rate * 2.0 * wksPerCheck;
    var premPay = otPay + dtPay;
    var totalGrossCheck = regPay + premPay;

    var annualTotal = totalGrossCheck * freq;
    var annualBase = regPay * freq;

    var taxTotal = calcTaxes(annualTotal, filing, cityRate, sditRate);
    var taxBase = calcTaxes(annualBase, filing, cityRate, sditRate);

    var netCheck = taxTotal.net / freq;
    var baseNetCheck = taxBase.net / freq;
    var extraNet = Math.max(0, netCheck - baseNetCheck);
    var totalPremHrsCheck = (otHrs + dtHrs) * wksPerCheck;
    var netPerOtHr = totalPremHrsCheck > 0 ? extraNet / totalPremHrsCheck : 0;
    var keepPct = premPay > 0 ? (extraNet / premPay) * 100 : 0;

    var periodLabel = freq === 26 ? 'Bi-Weekly' : 'Weekly';
    document.getElementById('ot-net-lbl').textContent = 'Estimated ' + periodLabel + ' Net Pay (With Overtime)';
    document.getElementById('ot-net-val').textContent = fmt(netCheck);
    document.getElementById('ot-net-sub').textContent = 'Total Gross: ' + fmt(totalGrossCheck) + ' (' + fmt(regPay) + ' reg + ' + fmt(premPay) + ' OT/DT)';

    document.getElementById('ot-extra-net').textContent = '+' + fmt(extraNet);
    document.getElementById('ot-extra-note').textContent = 'vs. ' + fmt(baseNetCheck) + ' net with 0 OT hrs';
    document.getElementById('ot-net-hr').textContent = totalPremHrsCheck > 0 ? fmt(netPerOtHr) + ' / hr' : '—';
    document.getElementById('ot-keep-pct').textContent = totalPremHrsCheck > 0 ? 'You keep ' + keepPct.toFixed(1) + '% of each OT dollar' : 'Add overtime hours to see net OT rate';

    document.getElementById('ot-bd-title').textContent = periodLabel + ' Pay & Tax Withholding Breakdown';
    document.getElementById('bd-reg').textContent = fmt(regPay);
    document.getElementById('bd-ot').textContent = fmt(premPay);
    document.getElementById('bd-fed').textContent = '-' + fmt(taxTotal.fed / freq);
    document.getElementById('bd-fica').textContent = '-' + fmt(taxTotal.fica / freq);
    document.getElementById('bd-oh').textContent = '-' + fmt(taxTotal.oh / freq);
    document.getElementById('bd-city').textContent = '-' + fmt(taxTotal.local / freq);
    document.getElementById('bd-net').textContent = fmt(netCheck);
  }

  ['ot-rate', 'ot-reg-hrs', 'ot-15-hrs', 'ot-20-hrs', 'ot-freq', 'ot-filing', 'ot-city', 'ot-sdit'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    }
  });
  document.getElementById('ot-calc-btn').addEventListener('click', calculate);
  document.getElementById('ot-reset-btn').addEventListener('click', function () {
    document.getElementById('ot-rate').value = '26.00';
    document.getElementById('ot-reg-hrs').value = '40';
    document.getElementById('ot-15-hrs').value = '8';
    document.getElementById('ot-20-hrs').value = '0';
    document.getElementById('ot-freq').value = '52';
    document.getElementById('ot-filing').value = 'single';
    document.getElementById('ot-city').value = '2.5';
    document.getElementById('ot-sdit').value = '0';
    calculate();
  });

  calculate();
})();
</script>

