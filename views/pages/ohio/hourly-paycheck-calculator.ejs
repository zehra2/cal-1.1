</main>

<script>
(function () {
  var FED_2026 = {
    single: {
      std: 15750,
      brackets: [
        [12400, 0.10], [50400, 0.12], [105700, 0.22],
        [201775, 0.24], [256225, 0.32], [640600, 0.35], [Infinity, 0.37]
      ]
    },
    mfj: {
      std: 31500,
      brackets: [
        [24800, 0.10], [100800, 0.12], [211400, 0.22],
        [403550, 0.24], [512450, 0.32], [768700, 0.35], [Infinity, 0.37]
      ]
    },
    hoh: {
      std: 23625,
      brackets: [
        [17700, 0.10], [67450, 0.12], [105700, 0.22],
        [201775, 0.24], [256200, 0.32], [640600, 0.35], [Infinity, 0.37]
      ]
    }
  };

  function calcFedTax(taxable, filing) {
    var cfg = FED_2026[filing] || FED_2026.single;
    var rem = Math.max(0, taxable - cfg.std);
    var tax = 0;
    var prev = 0;
    for (var i = 0; i < cfg.brackets.length; i++) {
      var cap = cfg.brackets[i][0];
      var rate = cfg.brackets[i][1];
      if (rem <= prev) break;
      var slice = Math.min(rem, cap) - prev;
      tax += slice * rate;
      prev = cap;
    }
    return tax;
  }

  function calcOhioStateTax(ohTaxableBase) {
    var exemption = ohTaxableBase <= 40000 ? 2400 : (ohTaxableBase <= 80000 ? 2150 : 1900);
    var ohTaxable = Math.max(0, ohTaxableBase - exemption);
    if (ohTaxable <= 26050) return 0;
    return (ohTaxable - 26050) * 0.0275;
  }

  function getCityRate() {
    var val = document.getElementById('oh-city').value;
    if (val === 'custom') return Math.max(0, parseFloat(document.getElementById('oh-city-custom').value) || 0) / 100;
    return (parseFloat(val) || 0) / 100;
  }

  function fmt(n) {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calculate() {
    var rate = Math.max(0, parseFloat(document.getElementById('oh-rate').value) || 0);
    var regHrs = Math.max(0, parseFloat(document.getElementById('oh-hours').value) || 0);
    var otHrs = Math.max(0, parseFloat(document.getElementById('oh-ot').value) || 0);
    var freq = parseInt(document.getElementById('oh-freq').value, 10) || 26;
    var filing = document.getElementById('oh-filing').value;
    var cityRate = getCityRate();
    var sditRate = Math.max(0, parseFloat(document.getElementById('oh-sdit').value) || 0) / 100;
    var k401Pct = Math.max(0, Math.min(50, parseFloat(document.getElementById('oh-401k').value) || 0)) / 100;
    var healthPerCheck = Math.max(0, parseFloat(document.getElementById('oh-health').value) || 0);

    var weeklyGross = (regHrs * rate) + (otHrs * rate * 1.5);
    var annualGross = weeklyGross * 52;
    var checkGross = annualGross / freq;

    var check401k = checkGross * k401Pct;
    var annual401k = check401k * freq;
    var annualHealth = healthPerCheck * freq;

    var annualFedWages = Math.max(0, annualGross - annual401k - annualHealth);
    var annualFicaWages = Math.max(0, annualGross - annualHealth);

    var annualFedTax = calcFedTax(annualFedWages, filing);
    var annualSS = Math.min(annualFicaWages, 176100) * 0.062;
    var annualMed = annualFicaWages * 0.0145 + Math.max(0, annualFicaWages - (filing === 'mfj' ? 250000 : 200000)) * 0.009;
    var annualOhTax = calcOhioStateTax(annualFedWages);
    var annualCityTax = annualFicaWages * cityRate;
    var annualSditTax = annualFedWages * sditRate;

    var checkFed = annualFedTax / freq;
    var checkFica = (annualSS + annualMed) / freq;
    var checkOh = annualOhTax / freq;
    var checkLocal = (annualCityTax + annualSditTax) / freq;
    var checkPreTax = check401k + healthPerCheck;
    var checkNet = Math.max(0, checkGross - checkPreTax - checkFed - checkFica - checkOh - checkLocal);

    var annualNet = checkNet * freq;
    var totalHoursPerCheck = ((regHrs + otHrs) * 52) / freq;
    var effNetHourly = totalHoursPerCheck > 0 ? checkNet / totalHoursPerCheck : 0;
    var effTaxPct = annualGross > 0 ? ((annualFedTax + annualSS + annualMed + annualOhTax + annualCityTax + annualSditTax) / annualGross) * 100 : 0;

    var periodName = freq === 52 ? 'Weekly' : (freq === 26 ? 'Bi-Weekly' : 'Semi-Monthly');
    document.getElementById('out-period-lbl').textContent = 'Estimated ' + periodName + ' Net Take-Home Pay';
    document.getElementById('out-net-pay').textContent = fmt(checkNet);
    document.getElementById('out-net-sub').textContent = 'Gross: ' + fmt(checkGross) + ' | Effective Net Hourly: ' + fmt(effNetHourly) + '/hr';

    document.getElementById('out-ann-gross').textContent = '$' + Math.round(annualGross).toLocaleString('en-US');
    document.getElementById('out-eff-tax').textContent = 'Effective tax rate: ' + effTaxPct.toFixed(1) + '%';
    document.getElementById('out-ann-net').textContent = '$' + Math.round(annualNet).toLocaleString('en-US');
    document.getElementById('out-monthly-net').textContent = '~$' + Math.round(annualNet / 12).toLocaleString('en-US') + ' / month avg';

    document.getElementById('bd-title').textContent = 'Per-Paycheck Deductions Breakdown (' + periodName + ')';
    document.getElementById('bd-gross').textContent = fmt(checkGross);
    document.getElementById('bd-pretax').textContent = '-' + fmt(checkPreTax);
    document.getElementById('bd-fed').textContent = '-' + fmt(checkFed);
    document.getElementById('bd-fica').textContent = '-' + fmt(checkFica);
    document.getElementById('bd-oh').textContent = '-' + fmt(checkOh);
    document.getElementById('bd-local').textContent = '-' + fmt(checkLocal);
    document.getElementById('bd-net').textContent = fmt(checkNet);
  }

  document.getElementById('oh-city').addEventListener('change', function (e) {
    document.getElementById('oh-custom-city-row').style.display = e.target.value === 'custom' ? 'grid' : 'none';
    calculate();
  });

  ['oh-rate', 'oh-hours', 'oh-ot', 'oh-freq', 'oh-filing', 'oh-city-custom', 'oh-sdit', 'oh-401k', 'oh-health'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    }
  });
  document.getElementById('oh-calc-btn').addEventListener('click', calculate);
  document.getElementById('oh-reset-btn').addEventListener('click', function () {
    document.getElementById('oh-rate').value = '24.00';
    document.getElementById('oh-hours').value = '40';
    document.getElementById('oh-ot').value = '0';
    document.getElementById('oh-freq').value = '26';
    document.getElementById('oh-filing').value = 'single';
    document.getElementById('oh-city').value = '2.5';
    document.getElementById('oh-custom-city-row').style.display = 'none';
    document.getElementById('oh-city-custom').value = '2.0';
    document.getElementById('oh-sdit').value = '0';
    document.getElementById('oh-401k').value = '5';
    document.getElementById('oh-health').value = '65';
    calculate();
  });

  calculate();
})();
</script>

