<script>
(function(){
  const FED={single:[[0,11925,.10],[11925,48475,.12],[48475,103350,.22],[103350,197300,.24],[197300,250525,.32],[250525,626350,.35],[626350,Infinity,.37]],married_jointly:[[0,23850,.10],[23850,96950,.12],[96950,206700,.22],[206700,394600,.24],[394600,501050,.32],[501050,751600,.35],[751600,Infinity,.37]],married_separately:[[0,11925,.10],[11925,48475,.12],[48475,103350,.22],[103350,197300,.24],[197300,250525,.32],[250525,375800,.35],[375800,Infinity,.37]],head_household:[[0,17000,.10],[17000,64850,.12],[64850,103350,.22],[103350,197300,.24],[197300,250500,.32],[250500,626350,.35],[626350,Infinity,.37]],qualifying_widow:[[0,23850,.10],[23850,96950,.12],[96950,206700,.22],[206700,394600,.24],[394600,501050,.32],[501050,751600,.35],[751600,Infinity,.37]]};
  function fedTax(inc,st){let t=0;for(const[lo,hi,r]of(FED[st]||FED.single)){if(inc<=lo)break;t+=(Math.min(inc,hi)-lo)*r;}return t;}
  function ohioTax(inc){if(inc<=26050)return 0;if(inc<=46100)return(inc-26050)*.02765;if(inc<=92150)return 554.28+(inc-46100)*.03226;if(inc<=115300)return 2040.90+(inc-92150)*.03688;return 2895.12+(inc-115300)*.03990;}
  const fmt=v=>'$'+Math.abs(v).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');
  const fmtI=v=>'$'+Math.round(Math.abs(v)).toLocaleString();
  const fmtP=v=>v.toFixed(1)+'%';
  const $=id=>document.getElementById(id);
  $('s-muni').addEventListener('change',()=>{$('s-custom-wrap').style.display=$('s-muni').value==='custom'?'':'none';calc();});
  function getLocal(){const m=$('s-muni').value;return m==='custom'?(parseFloat($('s-custom').value)||0)/100:parseFloat(m)/100||0;}
  function netForPeriods(annual,status,localRate,perPretax26){
    const annTaxable=Math.max(0,annual-perPretax26*26);
    const annFed=fedTax(annTaxable,status);
    const annState=ohioTax(annTaxable);
    const annLocal=annual*localRate;
    const annSS=Math.min(annual,176100)*0.062;
    const annMed=annual*0.0145;
    const annTax=annFed+annState+annLocal+annSS+annMed+perPretax26*26;
    const annNet=annual-annTax;
    return{annual:annNet,weekly:annNet/52,biweekly:annNet/26,semimonthly:annNet/24,monthly:annNet/12,
           perFed26:annFed/26,perState26:annState/26,perLocal26:annLocal/26,perSS26:annSS/26,perMed26:annMed/26,
           gross26:annual/26,annGross:annual,annTax,eff:annual>0?(annTax/annual)*100:0};
  }
  function calc(){
    const annual=parseFloat($('s-annual').value)||0;
    const status=$('s-status').value;
    const localRate=getLocal();
    const pretax=(parseFloat($('s-401k').value)||0)+(parseFloat($('s-health').value)||0)+(parseFloat($('s-other').value)||0);
    const r=netForPeriods(annual,status,localRate,pretax);
    const freq=$('s-display-freq').value;
    const freqMap={weekly:r.weekly,biweekly:r.biweekly,semimonthly:r.semimonthly,monthly:r.monthly,annual:r.annual};
    const freqL={weekly:'Weekly',biweekly:'Biweekly',semimonthly:'Semi-Monthly',monthly:'Monthly',annual:'Annual'};
    $('s-net').textContent=fmt(freqMap[freq]);
    $('s-net-lbl').textContent=freqL[freq]+' Take-Home Pay';
    $('s-wk').textContent=fmtI(r.weekly);$('s-bw').textContent=fmtI(r.biweekly);
    $('s-sm').textContent=fmtI(r.semimonthly);$('s-mo').textContent=fmtI(r.monthly);
    $('s-ln-gross').textContent=fmt(r.gross26);
    $('s-ln-pretax').textContent=pretax>0?'−'+fmt(pretax):'$0.00';
    $('s-ln-fed').textContent='−'+fmt(r.perFed26);
    $('s-ln-state').textContent='−'+fmt(r.perState26);
    $('s-ln-local').textContent='−'+fmt(r.perLocal26);
    $('s-ln-ss').textContent='−'+fmt(r.perSS26);
    $('s-ln-med').textContent='−'+fmt(r.perMed26);
    $('s-ln-net').textContent=fmt(r.biweekly);
    $('s-ann-gross').textContent=fmtI(r.annGross);
    $('s-ann-tax').textContent='−'+fmtI(r.annTax);
    $('s-eff').textContent=fmtP(r.eff);
    $('s-ann-net').textContent=fmtI(r.annual);
    const mSel=$('s-muni');
    const mLbl=mSel.value!=='0'&&mSel.value!=='custom'?mSel.options[mSel.selectedIndex].text.split('(')[0].trim():'No Local Tax';
    $('s-local-lbl').textContent=mSel.value!=='0'?mLbl+' Tax':'Municipal Tax';
    $('s-res-sub').textContent=fmtI(annual)+'/yr · '+freqL[freq]+' view';
  }
  document.querySelectorAll('.osc-body input,.osc-body select').forEach(e=>{e.addEventListener('input',calc);e.addEventListener('change',calc);});
  $('osc-btn').addEventListener('click',calc);
  document.querySelectorAll('.osc-faq-q').forEach(q=>{q.addEventListener('click',function(){const i=this.closest('.osc-faq-item'),w=i.classList.contains('open');document.querySelectorAll('.osc-faq-item').forEach(x=>x.classList.remove('open'));if(!w)i.classList.add('open');});});
  calc();
})();
</script>
