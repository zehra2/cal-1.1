<%- include('../../partials/header') %>
<div class="calculator-page">
    <h1>Determinant Calculator</h1>
    <p class="description">Calculate the determinant of a 2×2, 3×3, or 4×4 square matrix.</p>

    <form class="calculator-form" onsubmit="event.preventDefault(); computeDet();">
        <div class="form-group">
            <label for="size">Matrix Size:</label>
            <select id="size" name="size" onchange="renderDetGrid()">
                <option value="2" selected>2 × 2</option>
                <option value="3">3 × 3</option>
                <option value="4">4 × 4</option>
            </select>
        </div>

        <h3>Enter Matrix Values:</h3>
        <div id="detInputs" style="overflow-x:auto;"></div>
        <button type="submit" class="btn">Calculate Determinant</button>
    </form>

    <div id="detResult" class="result-section" style="display:none;">
        <h2>Result</h2>
        <div class="result-item highlight">
            <strong>Determinant:</strong> <span id="detVal">0</span>
        </div>
    </div>
</div>
<script>
function renderDetGrid() {
  var n = parseInt(document.getElementById('size').value, 10);
  var html = '';
  for (var i = 0; i < n; i++) {
    html += '<div style="display:flex;gap:10px;margin-bottom:10px;">';
    for (var j = 0; j < n; j++) {
      html += '<input type="number" step="any" id="d_' + i + '_' + j + '" style="width:80px;" value="' + (i === j ? '1' : '0') + '">';
    }
    html += '</div>';
  }
  document.getElementById('detInputs').innerHTML = html;
}
function det(m) {
  var n = m.length;
  if (n === 1) return m[0][0];
  if (n === 2) return m[0][0] * m[1][1] - m[0][1] * m[1][0];
  var sum = 0;
  for (var c = 0; c < n; c++) {
    var sub = m.slice(1).map(function(row) { return row.filter(function(_, j) { return j !== c; }); });
    sum += (c % 2 === 0 ? 1 : -1) * m[0][c] * det(sub);
  }
  return sum;
}
function computeDet() {
  var n = parseInt(document.getElementById('size').value, 10);
  var m = [];
  for (var i = 0; i < n; i++) {
    var row = [];
    for (var j = 0; j < n; j++) row.push(parseFloat(document.getElementById('d_' + i + '_' + j).value) || 0);
    m.push(row);
  }
  var val = Math.round(det(m) * 10000) / 10000;
  document.getElementById('detVal').textContent = val;
  document.getElementById('detResult').style.display = 'block';
}
renderDetGrid();
</script>
<%- include('../../partials/footer') %>
