<script>
(function () {
  var DEFAULTS = {
    size: 8, cpw: 2.95, prod: 1350, rate: 0.18, ownership: '0',
    rebate: 1500, nem: 90, escal: 3.5, deg: 0.5, maint: 2500
  };
  var els = {
    size: document.getElementById('solar-size'),
    cpw: document.getElementById('solar-cpw'),
    prod: document.getElementById('solar-prod'),
    rate: document.getElementById('solar-rate'),
    ownership: document.getElementById('solar-ownership'),
    rebate: document.getElementById('solar-rebate'),
    nem: document.getElementById('solar-nem'),
    escal: document.getElementById('solar-escal'),
    deg: document.getElementById('solar-deg'),
    maint: document.getElementById('solar-maint')
  };

  function fmtUSD(n) {
    var sign = n < 0 ? '-' : '';
    return sign + '$' + Math.round(Math.abs(n)).toLocaleString('en-US');
  }

  function calculate() {
    var size = Math.max(0.5, parseFloat(els.size.value) || 0);
    var cpw = Math.max(0.5, parseFloat(els.cpw.value) || 0);
    var prod = Math.max(100, parseFloat(els.prod.value) || 0);
    var rate = Math.max(0.01, parseFloat(els.rate.value) || 0);
    var creditPct = parseFloat(els.ownership.value) || 0;
    var rebate = Math.max(0, parseFloat(els.rebate.value) || 0);
    var nem = Math.min(100, Math.max(10, parseFloat(els.nem.value) || 90)) / 100;
    var escal = Math.max(0, parseFloat(els.escal.value) || 0) / 100;
    var deg = Math.max(0, parseFloat(els.deg.value) || 0) / 100;
    var maint = Math.max(0, parseFloat(els.maint.value) || 0);

    var grossCost = size * 1000 * cpw;
    var fedCredit = grossCost * (creditPct / 100);
    var netCost = Math.max(0, grossCost - fedCredit - rebate);

    var yr1Kwh = size * prod;
    var effRate = rate * nem;
    var yr1Savings = yr1Kwh * effRate;
    var simplePayback = yr1Savings > 0 ? netCost / yr1Savings : 0;

    var cumSavings = 0;
    var cumKwh = 0;
    var paybackYear = null;
    for (var y = 1; y <= 25; y++) {
      var yearKwh = yr1Kwh * Math.pow(1 - deg, y - 1);
      var yearRate = effRate * Math.pow(1 + escal, y - 1);
      var yearSave = yearKwh * yearRate;
      var prevCum = cumSavings;
      cumSavings += yearSave;
      cumKwh += yearKwh;
      if (paybackYear === null && cumSavings >= netCost && yearSave > 0) {
        paybackYear = (y - 1) + ((netCost - prevCum) / yearSave);
      }
    }

    var net25 = cumSavings - netCost - maint;
    var roiPct = netCost > 0 ? (net25 / netCost) * 100 : 0;
    var lcoe = cumKwh > 0 ? (netCost + maint) / cumKwh : 0;

    document.getElementById('out-payback').textContent =
      paybackYear !== null ? paybackYear.toFixed(1) + ' Years' : '25+ Years';
    document.getElementById('out-payback-sub').textContent =
      'Simple payback: ' + simplePayback.toFixed(1) + ' yrs (before ' + (escal * 100).toFixed(1) + '%/yr rate inflation)';

    document.getElementById('out-net-cost').textContent = fmtUSD(netCost);
    document.getElementById('out-gross-note').textContent = 'Gross installed: ' + fmtUSD(grossCost);

    document.getElementById('out-yr1-save').textContent = fmtUSD(yr1Savings);
    document.getElementById('out-yr1-kwh').textContent = Math.round(yr1Kwh).toLocaleString('en-US') + ' kWh/yr generated';

    var netEl = document.getElementById('out-25yr-net');
    netEl.textContent = fmtUSD(net25);
    netEl.style.color = net25 >= 0 ? '#047857' : '#b91c1c';
    document.getElementById('out-25yr-gross').textContent = 'Cumulative savings: ' + fmtUSD(cumSavings);

    document.getElementById('out-roi').textContent = roiPct.toFixed(1) + '%';
    document.getElementById('out-annual-roi').textContent = '~' + (roiPct / 25).toFixed(1) + '% avg annual return';

    document.getElementById('bd-gross').textContent = fmtUSD(grossCost);
    document.getElementById('bd-fed').textContent = '-' + fmtUSD(fedCredit);
    document.getElementById('bd-rebate').textContent = '-' + fmtUSD(rebate);
    document.getElementById('bd-eff-rate').textContent = '$' + effRate.toFixed(3) + '/kWh';
    document.getElementById('bd-25yr-kwh').textContent = Math.round(cumKwh).toLocaleString('en-US') + ' kWh';
    document.getElementById('bd-lcoe').textContent = '$' + lcoe.toFixed(3) + '/kWh';
  }

  Object.keys(els).forEach(function (k) {
    els[k].addEventListener('input', calculate);
    els[k].addEventListener('change', calculate);
  });
  document.getElementById('solar-calc-btn').addEventListener('click', calculate);
  document.getElementById('solar-reset-btn').addEventListener('click', function () {
    Object.keys(DEFAULTS).forEach(function (k) { els[k].value = DEFAULTS[k]; });
    calculate();
  });

  calculate();
})();
</script>

