<script>
function fmtC(v){return (v<0?'−':'')+'$'+Math.round(Math.abs(v)).toLocaleString();}
function fmtP(v){return (v<0?'−':'')+Math.abs(v).toFixed(1)+'%';}
function calcPJ(){
  var cost    = parseFloat(document.getElementById('pj-cost').value)||0;
  var ongoing = parseFloat(document.getElementById('pj-ongoing').value)||0;
  var rev     = parseFloat(document.getElementById('pj-rev').value)||0;
  var save    = parseFloat(document.getElementById('pj-save').value)||0;
  var prod    = parseFloat(document.getElementById('pj-prod').value)||0;
  var risk    = parseFloat(document.getElementById('pj-risk').value)||0;
  var yrs     = parseInt(document.getElementById('pj-yrs').value)||3;
  var disc    = parseFloat(document.getElementById('pj-disc').value)||8;
  var annBen  = rev+save+prod+risk;
  var totalCost  = cost+(ongoing*yrs);
  var totalBen   = annBen*yrs;
  var net        = totalBen-totalCost;
  var roi        = cost>0?(net/cost)*100:0;
  var ann        = yrs>0?(Math.pow(1+roi/100,1/yrs)-1)*100:roi;
  var paybackMo  = annBen>0?((cost/(annBen-ongoing))*12):0;
  // NPV
  var r = disc/100;
  var npv = -cost;
  for(var i=1;i<=yrs;i++) npv += (annBen-ongoing)/Math.pow(1+r,i);
  document.getElementById('pj-roi').textContent     = fmtP(roi);
  document.getElementById('pj-roi-lbl').textContent = yrs+'-Year Project ROI';
  document.getElementById('pj-payback').textContent = paybackMo>0 ? paybackMo.toFixed(1)+' mo' : '—';
  document.getElementById('pj-npv-box').textContent = fmtC(npv);
  document.getElementById('pj-npv-box').style.color = npv>=0?'#0f766e':'#dc2626';
  document.getElementById('pj-ann').textContent     = fmtP(ann);
  document.getElementById('pj-net-box').textContent = fmtC(net);
  document.getElementById('pjl-cost').textContent   = fmtC(cost);
  document.getElementById('pjl-ongoing').textContent= '−'+fmtC(ongoing*yrs);
  document.getElementById('pjl-ben').textContent    = fmtC(totalBen);
  document.getElementById('pjl-net').textContent    = fmtC(net);
  document.getElementById('pjl-net').className      = 'lv '+(net>=0?'pos':'neg');
  document.getElementById('pjl-npv').textContent    = fmtC(npv);
  document.getElementById('pjl-npv').className      = 'lv '+(npv>=0?'pos':'neg');
  document.getElementById('pjl-roi').textContent    = fmtP(roi);
  document.getElementById('pjl-disc-lbl').textContent = disc;
  document.getElementById('pj-result').style.display='block';
}
['pj-cost','pj-ongoing','pj-rev','pj-save','pj-prod','pj-risk','pj-yrs','pj-disc'].forEach(function(id){
  var el=document.getElementById(id);
  if(el){el.addEventListener('input',calcPJ);el.addEventListener('change',calcPJ);}
});
calcPJ();
document.querySelectorAll('.sec-faq-q').forEach(function(q){
  q.addEventListener('click',function(){
    var i=this.closest('.sec-faq-item'),w=i.classList.contains('open');
    document.querySelectorAll('.sec-faq-item').forEach(function(x){x.classList.remove('open');});
    if(!w)i.classList.add('open');
  });
});
</script>
