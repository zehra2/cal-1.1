<script>
function fmtC(val) {
  var sign = val < 0 ? '−$' : '$';
  return sign + Math.abs(Math.round(val)).toLocaleString('en-US');
}

function calculateBreakEven() {
  var fixedCosts   = parseFloat(document.getElementById('beFixedCosts').value) || 0;
  var price        = parseFloat(document.getElementById('beUnitPrice').value) || 0;
  var varCost      = parseFloat(document.getElementById('beUnitVarCost').value) || 0;
  var currentUnits = parseFloat(document.getElementById('beCurrentUnits').value) || 0;
  var targetProfit = parseFloat(document.getElementById('beTargetProfit').value) || 0;

  var unitCm = Math.max(0, price - varCost);
  var cmRatio = price > 0 ? (unitCm / price) : 0;
  var vcRatio = price > 0 ? (varCost / price) : 0;

  var breakEvenUnits = 0;
  var breakEvenRevenue = 0;

  if (unitCm > 0) {
    breakEvenUnits = fixedCosts / unitCm;
    breakEvenRevenue = breakEvenUnits * price;
  }

  var targetUnits = 0;
  var targetRevenue = 0;
  if (unitCm > 0) {
    targetUnits = (fixedCosts + targetProfit) / unitCm;
    targetRevenue = targetUnits * price;
  }

  var currentRevenue   = currentUnits * price;
  var currentVarCosts  = currentUnits * varCost;
  var currentTotalCm   = currentUnits * unitCm;
  var currentNetIncome = currentTotalCm - fixedCosts;

  var marginSafetyPct = 0;
  var safetyUnits = currentUnits - breakEvenUnits;
  if (currentUnits > 0) {
    marginSafetyPct = (safetyUnits / currentUnits) * 100;
  }

  // Update Hero Metric
  var beUnitsEl = document.getElementById('resBeUnits');
  if (beUnitsEl) beUnitsEl.textContent = Math.ceil(breakEvenUnits).toLocaleString() + ' Units';

  var beRevEl = document.getElementById('resBeRevenue');
  if (beRevEl) beRevEl.textContent = 'Break-Even Revenue: ' + fmtC(breakEvenRevenue);

  // Update 4 Cards
  var unitCmEl = document.getElementById('resBeUnitCm');
  if (unitCmEl) unitCmEl.textContent = '$' + unitCm.toFixed(2) + ' / unit';

  var cmRatioEl = document.getElementById('resBeCmRatio');
  if (cmRatioEl) cmRatioEl.textContent = (cmRatio * 100).toFixed(1) + '% CM Ratio';

  var targetUnitsEl = document.getElementById('resBeTargetUnits');
  if (targetUnitsEl) targetUnitsEl.textContent = Math.ceil(targetUnits).toLocaleString() + ' Units';

  var targetRevEl = document.getElementById('resBeTargetRevenue');
  if (targetRevEl) targetRevEl.textContent = 'Target Revenue: ' + fmtC(targetRevenue);

  var safetyEl = document.getElementById('resBeMarginSafety');
  var safetyUnitsEl = document.getElementById('resBeSafetyUnits');
  if (safetyEl && safetyUnitsEl) {
    safetyEl.textContent = marginSafetyPct.toFixed(1) + '%';
    if (marginSafetyPct >= 0) {
      safetyEl.className = 'result-number text-success';
      safetyUnitsEl.textContent = '+' + Math.round(safetyUnits).toLocaleString() + ' Units Cushion';
    } else {
      safetyEl.className = 'result-number text-danger';
      safetyUnitsEl.textContent = Math.round(safetyUnits).toLocaleString() + ' Units Below BEP';
    }
  }

  var curProfitEl = document.getElementById('resBeCurrentProfit');
  var curRevEl = document.getElementById('resBeCurrentRevenue');
  if (curProfitEl && curRevEl) {
    curProfitEl.textContent = (currentNetIncome >= 0 ? '+' : '−') + fmtC(Math.abs(currentNetIncome));
    curProfitEl.className = currentNetIncome >= 0 ? 'result-number text-success' : 'result-number text-danger';
    curRevEl.textContent = 'Gross Revenue: ' + fmtC(currentRevenue);
  }

  // Update Table
  var setTxt = function(id, txt) {
    var el = document.getElementById(id);
    if (el) el.textContent = txt;
  };

  setTxt('resSumRevenue', fmtC(currentRevenue));
  setTxt('resSumVarCosts', '−' + fmtC(currentVarCosts));
  setTxt('resSumTotalCm', fmtC(currentTotalCm));
  setTxt('resSumFixedCosts', '−' + fmtC(fixedCosts));

  var profitLabelEl = document.getElementById('resSumProfitLabel');
  var netIncomeEl = document.getElementById('resSumNetIncome');
  if (profitLabelEl && netIncomeEl) {
    if (currentNetIncome >= 0) {
      profitLabelEl.textContent = 'Net Operating Profit:';
      netIncomeEl.textContent = '+' + fmtC(currentNetIncome);
      netIncomeEl.className = 'text-success';
    } else {
      profitLabelEl.textContent = 'Net Operating Loss:';
      netIncomeEl.textContent = '−' + fmtC(Math.abs(currentNetIncome));
      netIncomeEl.className = 'text-danger';
    }
  }

  setTxt('resSumCmRatio', (cmRatio * 100).toFixed(1) + '%');
  setTxt('resSumVcRatio', (vcRatio * 100).toFixed(1) + '%');
}

// Preset Handler
var presetSelect = document.getElementById('bePreset');
if (presetSelect) {
  presetSelect.addEventListener('change', function() {
    var opt = this.options[this.selectedIndex];
    if (opt && opt.value !== 'custom') {
      if (opt.dataset.fixed)  document.getElementById('beFixedCosts').value   = opt.dataset.fixed;
      if (opt.dataset.price)  document.getElementById('beUnitPrice').value    = opt.dataset.price;
      if (opt.dataset.var)    document.getElementById('beUnitVarCost').value  = opt.dataset.var;
      if (opt.dataset.units)  document.getElementById('beCurrentUnits').value = opt.dataset.units;
      if (opt.dataset.profit) document.getElementById('beTargetProfit').value = opt.dataset.profit;
    }
    calculateBreakEven();
  });
}

function resetDefaults() {
  document.getElementById('bePreset').value       = 'custom';
  document.getElementById('beFixedCosts').value   = '25000';
  document.getElementById('beUnitPrice').value    = '120';
  document.getElementById('beUnitVarCost').value  = '45';
  document.getElementById('beCurrentUnits').value = '500';
  document.getElementById('beTargetProfit').value = '15000';
  calculateBreakEven();
}

// Live real-time calculation listeners on all inputs
document.querySelectorAll('#beFixedCosts, #beUnitPrice, #beUnitVarCost, #beCurrentUnits, #beTargetProfit').forEach(function(el) {
  el.addEventListener('input', calculateBreakEven);
  el.addEventListener('change', calculateBreakEven);
});

// Run initial calculation immediately on load
calculateBreakEven();

// FAQ Accordion
document.querySelectorAll('.faq-question').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var box = this.closest('.faq-box');
    var isOpen = box.classList.contains('open');
    document.querySelectorAll('.faq-box').forEach(function(b) { b.classList.remove('open'); });
    if (!isOpen) {
      box.classList.add('open');
    }
  });
});
</script>
