<style>
body{background:#f5f7fa;}
.roi-wrap{max-width:1320px;margin:0 auto;padding:2rem 1.5rem 4rem;display:grid;grid-template-columns:220px 1fr 260px;gap:2rem;align-items:start;}
/* TOC */
.roi-toc{position:sticky;top:6rem;background:#fff;border-radius:12px;border:1px solid #e2e8f0;box-shadow:0 2px 10px rgba(0,0,0,.04);overflow:hidden;}
.roi-toc-head{background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;padding:.9rem 1.25rem;font-weight:700;font-size:.82rem;text-transform:uppercase;letter-spacing:.07em;}
.roi-toc ul{list-style:none;padding:.6rem 0;margin:0;}
.roi-toc ul li a{display:block;padding:.45rem 1.25rem;font-size:.82rem;color:#475569;text-decoration:none;border-left:3px solid transparent;transition:all .15s;}
.roi-toc ul li a:hover,.roi-toc ul li a.active{color:#16a34a;background:#f0fdf4;border-left-color:#16a34a;}
.roi-toc-div{height:1px;background:#f1f5f9;margin:.4rem 0;}
.roi-toc-sub{padding:.4rem 1.25rem;font-size:.72rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;}
/* Main */
.roi-main{min-width:0;}
.roi-bc{font-size:.78rem;color:#94a3b8;margin-bottom:.75rem;}
.roi-bc a{color:#64748b;text-decoration:none;}
.roi-bc a:hover{color:#16a34a;}
.roi-hero h1{font-size:2rem;color:#0f172a;margin:0 0 .5rem;line-height:1.25;}
.roi-hero p{font-size:.97rem;color:#64748b;line-height:1.68;margin:0 0 1.5rem;border-left:3px solid #16a34a;padding-left:.9rem;}
/* Rating bar */
.roi-rating{display:flex;align-items:center;gap:10px;margin-bottom:1.5rem;flex-wrap:wrap;}
.roi-stars{color:#f59e0b;font-size:1rem;letter-spacing:1px;}
.roi-rating-text{font-size:.82rem;color:#64748b;}
/* Calculator card */
.roi-card{background:#fff;border-radius:14px;border:1px solid #e2e8f0;box-shadow:0 4px 20px rgba(0,0,0,.06);overflow:hidden;margin-bottom:2rem;}
.roi-card-head{background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;padding:1.1rem 1.5rem;display:flex;align-items:center;gap:.75rem;}
.roi-card-head h2{font-size:1.05rem;font-weight:700;margin:0;}
/* Tabs */
.roi-tabs{display:flex;flex-wrap:wrap;border-bottom:1px solid #e2e8f0;background:#f8fafc;}
.roi-tab{flex:1;min-width:80px;padding:.7rem .4rem;font-size:.76rem;font-weight:600;color:#64748b;border:none;background:none;cursor:pointer;border-bottom:3px solid transparent;transition:all .2s;text-align:center;}
.roi-tab.active{color:#16a34a;border-bottom-color:#16a34a;background:#fff;}
.roi-tab:hover{color:#15803d;}
/* Form/result split */
.roi-body{display:grid;grid-template-columns:1fr 1fr;}
.roi-form{padding:1.5rem;border-right:1px solid #f1f5f9;}
.roi-result{padding:1.5rem;background:linear-gradient(160deg,#f0fdf4,#dcfce7 100%);}
.roi-panel{display:none;}.roi-panel.active{display:block;}
/* Fields */
.rf{margin-bottom:.95rem;}
.rf label{display:block;font-size:.84rem;font-weight:600;color:#1e293b;margin-bottom:.35rem;}
.rf input,.rf select{width:100%;padding:10px 13px;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.92rem;color:#0f172a;outline:none;box-sizing:border-box;background:#fff;transition:border-color .2s;}
.rf input:focus,.rf select:focus{border-color:#16a34a;}
.rf .hint{font-size:.72rem;color:#94a3b8;margin-top:.25rem;}
.rf2{display:grid;grid-template-columns:1fr 1fr;gap:.85rem;}
.roi-btn{width:100%;background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;padding:12px;border:none;border-radius:8px;font-size:.95rem;font-weight:700;cursor:pointer;margin-top:.5rem;transition:opacity .2s,transform .15s;}
.roi-btn:hover{opacity:.92;transform:translateY(-1px);}
/* Results */
.rr-head{font-size:1rem;font-weight:700;color:#0f172a;margin:0 0 .2rem;}
.rr-sub{font-size:.8rem;color:#64748b;margin:0 0 1rem;}
.rr-primary{background:linear-gradient(135deg,#16a34a,#15803d);border-radius:10px;padding:1.25rem 1rem;text-align:center;box-shadow:0 4px 14px rgba(22,163,74,.22);margin-bottom:.75rem;}
.rr-primary-val{display:block;font-size:2.5rem;font-weight:900;color:#fff;line-height:1;margin-bottom:.2rem;}
.rr-primary-lbl{font-size:.82rem;color:rgba(255,255,255,.85);}
.rr-boxes{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-bottom:.75rem;}
.rr-box{background:#fff;border:1.5px solid #bbf7d0;border-radius:9px;padding:.75rem;text-align:center;}
.rr-box-val{display:block;font-size:1.05rem;font-weight:800;color:#16a34a;margin-bottom:.15rem;}
.rr-box-lbl{font-size:.68rem;color:#64748b;font-weight:600;line-height:1.3;}
.rr-lines{background:#fff;border:1px solid #bbf7d0;border-radius:9px;padding:.8rem 1rem;margin-bottom:.6rem;}
.rr-line{display:flex;justify-content:space-between;padding:.3rem 0;border-bottom:1px solid #f0fdf4;font-size:.84rem;}
.rr-line:last-child{border-bottom:none;font-weight:700;padding-top:.45rem;}
.rr-line .ll{color:#64748b;}.rr-line .lv{font-weight:600;color:#1e293b;}
.rr-line .lv.pos{color:#16a34a;}.rr-line .lv.neg{color:#dc2626;}
.rr-disc{font-size:.7rem;color:#94a3b8;margin-top:.4rem;line-height:1.4;}
/* Content sections */
.roi-section{background:#fff;border-radius:13px;border:1px solid #e2e8f0;padding:2rem;margin-bottom:1.75rem;scroll-margin-top:5rem;}
.roi-section h2{font-size:1.45rem;color:#0f172a;margin:0 0 1rem;padding-bottom:.7rem;border-bottom:2px solid #f0fdf4;}
.roi-section h3{font-size:1.05rem;color:#1e293b;margin:1.4rem 0 .55rem;}
.roi-section p{color:#475569;line-height:1.75;font-size:.96rem;margin-bottom:.95rem;}
.roi-section p:last-child{margin-bottom:0;}
.roi-section a{color:#16a34a;font-weight:600;}
.roi-section strong{color:#1e293b;}
.roi-section ul,.roi-section ol{color:#475569;padding-left:1.4rem;line-height:1.75;font-size:.96rem;margin-bottom:.95rem;}
.roi-section li{margin-bottom:.4rem;}
/* Formula box */
.roi-formula{background:#0f172a;color:#94a3b8;font-family:'Courier New',monospace;font-size:.9rem;padding:1rem 1.25rem;border-radius:8px;margin:1rem 0;line-height:1.9;}
.roi-formula code{display:block;}
.roi-formula code span{color:#6ee7b7;}
/* Table */
.roi-table{width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:1.25rem;}
.roi-table th{background:#16a34a;color:#fff;padding:10px 14px;font-size:.84rem;font-weight:600;text-align:left;}
.roi-table td{padding:9px 14px;border-bottom:1px solid #f1f5f9;font-size:.87rem;color:#334155;}
.roi-table tr:last-child td{border-bottom:none;}
.roi-table tr:nth-child(even) td{background:#f8fafc;}
/* Info/tip boxes */
.roi-info{background:#f0fdf4;border-left:4px solid #16a34a;border-radius:0 8px 8px 0;padding:.9rem 1.1rem;margin:1rem 0;font-size:.92rem;color:#065f46;line-height:1.6;}
.roi-warn{background:#fffbeb;border-left:4px solid #f59e0b;border-radius:0 8px 8px 0;padding:.9rem 1.1rem;margin:1rem 0;font-size:.92rem;color:#92400e;line-height:1.6;}
/* FAQ */
.roi-faq-item{border-bottom:1px solid #f1f5f9;padding:.85rem 0;}
.roi-faq-item:last-child{border-bottom:none;padding-bottom:0;}
.roi-faq-q{font-size:.95rem;font-weight:700;color:#0f172a;cursor:pointer;display:flex;justify-content:space-between;gap:1rem;}
.roi-faq-q::after{content:'+';font-size:1.2rem;color:#16a34a;flex-shrink:0;}
.roi-faq-item.open .roi-faq-q::after{content:'−';}
.roi-faq-a{display:none;color:#475569;font-size:.9rem;line-height:1.68;padding-top:.5rem;}
.roi-faq-item.open .roi-faq-a{display:block;}
/* Download CTA */
.roi-download{background:linear-gradient(135deg,#1e293b,#0f172a);border-radius:14px;padding:2rem;margin-bottom:1.75rem;display:flex;align-items:center;gap:1.5rem;}
.roi-download-icon{font-size:3rem;flex-shrink:0;}
.roi-download h3{color:#fff;font-size:1.1rem;font-weight:800;margin:0 0 .4rem;}
.roi-download p{color:#94a3b8;font-size:.87rem;margin:0 0 1rem;line-height:1.55;}
.roi-download a.dl-btn{display:inline-block;background:#16a34a;color:#fff;padding:10px 22px;border-radius:8px;font-weight:700;font-size:.88rem;text-decoration:none;}
.roi-download a.dl-btn:hover{background:#15803d;}
.roi-download .file-meta{font-size:.75rem;color:#64748b;margin-top:.4rem;}
/* Sidebar */
.roi-sidebar{position:sticky;top:6rem;display:flex;flex-direction:column;gap:1.25rem;}
.roi-widget{background:#fff;border-radius:12px;border:1px solid #e2e8f0;box-shadow:0 2px 10px rgba(0,0,0,.05);overflow:hidden;}
.roi-widget-head{background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;padding:.9rem 1.2rem;}
.roi-widget-head .wt{font-size:.95rem;font-weight:700;}
.roi-widget-head .ws{font-size:.75rem;color:rgba(255,255,255,.75);margin-top:.15rem;}
.roi-widget-rows{padding:.35rem 0;}
.roi-widget-row{display:flex;justify-content:space-between;padding:.55rem 1.2rem;border-bottom:1px solid #f8fafc;transition:background .15s;}
.roi-widget-row:last-child{border-bottom:none;}
.roi-widget-row:hover{background:#f0fdf4;}
.rwl{font-size:.82rem;font-weight:600;color:#334155;}
.rws{font-size:.7rem;color:#94a3b8;}
.rwv{font-size:.9rem;font-weight:800;color:#16a34a;text-align:right;}
.roi-quick-widget{background:#fff;border-radius:12px;border:1px solid #e2e8f0;box-shadow:0 2px 10px rgba(0,0,0,.04);overflow:hidden;}
.roi-quick-head{padding:.8rem 1.2rem;background:#f8fafc;border-bottom:1px solid #f1f5f9;font-size:.78rem;font-weight:700;color:#16a34a;text-transform:uppercase;letter-spacing:.05em;}
.roi-quick-links{list-style:none;padding:.4rem 0;margin:0;}
.roi-quick-links li a{display:flex;align-items:center;gap:.5rem;padding:.6rem 1.2rem;font-size:.83rem;color:#475569;text-decoration:none;border-left:3px solid transparent;transition:all .15s;}
.roi-quick-links li a:hover,.roi-quick-links li a.active{color:#16a34a;background:#f0fdf4;border-left-color:#16a34a;}
/* Related calc grid */
.related-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.75rem;}
.related-grid a{display:block;background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:9px;padding:.85rem;text-align:center;font-size:.85rem;font-weight:700;color:#15803d;text-decoration:none;transition:all .2s;}
.related-grid a:hover{background:#dcfce7;transform:translateY(-2px);box-shadow:0 4px 12px rgba(22,163,74,.12);}
/* Responsive */
@media(max-width:1200px){.roi-wrap{grid-template-columns:200px 1fr 240px;}}
@media(max-width:1024px){.roi-wrap{grid-template-columns:1fr;}.roi-toc,.roi-sidebar{position:static;}.roi-sidebar{display:grid;grid-template-columns:1fr 1fr;}}
@media(max-width:768px){.roi-wrap{padding:1rem 1rem 3rem;}.roi-body{grid-template-columns:1fr;}.roi-form{border-right:none;border-bottom:1px solid #f1f5f9;}.roi-sidebar{grid-template-columns:1fr;}.rf2{grid-template-columns:1fr;}.roi-download{flex-direction:column;gap:1rem;}.roi-hero h1{font-size:1.6rem;}.roi-tabs{overflow-x:auto;flex-wrap:nowrap;-webkit-overflow-scrolling:touch;}.roi-tab{min-width:auto;white-space:nowrap;padding:.65rem .6rem;font-size:.72rem;}}
</style>
