<script>
(function(){
  /* ── Helpers ── */
  var fmtC = function(v){return (v<0?'−':'')+'$'+Math.round(Math.abs(v)).toLocaleString('en-US');};
  var fmtD = function(v){return (v<0?'−':'')+'$'+Math.abs(v).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');};
  var fmtP = function(v){return (v<0?'−':'')+Math.abs(v).toFixed(2)+'%';};
  var $ = function(id){return document.getElementById(id);};

  function setResults(roi, net, invest, ret, years, taxRate, extra){
    var annualized = years>0 ? (Math.pow(1+roi/100,1/years)-1)*100 : roi;
    var payback    = net>0 ? invest/(net/years) : 0;
    var afterTaxNet= net*(1-taxRate/100);
    var afterTaxROI= invest>0 ? (afterTaxNet/invest)*100 : 0;
    $('roi-pct').textContent      = fmtP(roi);
    $('roi-pct').style.color      = roi>=0?'#fff':'#fca5a5';
    $('roi-net').textContent      = fmtC(net);
    $('roi-payback').textContent  = payback>0 ? payback.toFixed(1)+' yrs' : '—';
    $('roi-annualized').textContent = fmtP(annualized);
    $('roi-after-tax').textContent  = fmtP(afterTaxROI);
    $('rl-invest').textContent    = fmtC(invest);
    $('rl-return').textContent    = fmtC(ret);
    $('rl-net').textContent       = fmtC(net);
    $('rl-net').className         = 'lv '+(net>=0?'pos':'neg');
    $('rl-tax').textContent       = '−'+fmtC(net*(taxRate/100));
    $('rl-aftertax').textContent  = fmtC(afterTaxNet);
    $('rl-aftertax').className    = 'lv '+(afterTaxNet>=0?'pos':'neg');
    $('rl-roi').textContent       = fmtP(roi);
    $('rl-roi').className         = 'lv '+(roi>=0?'pos':'neg');
  }

  /* ── Basic ROI ── */
  window.calcBasic = function(){
    var invest = parseFloat($('b-invest').value)||0;
    var ret    = parseFloat($('b-return').value)||0;
    var years  = parseFloat($('b-years').value)||1;
    var tax    = parseFloat($('b-tax').value)||0;
    var net    = ret-invest;
    var roi    = invest>0?(net/invest)*100:0;
    setResults(roi,net,invest,ret,years,tax);
    $('roi-sub').textContent='Basic ROI · '+years+' yr hold · '+tax+'% tax';
  };

  /* ── Real Estate ROI ── */
  window.calcRealEstate = function(){
    var price    = parseFloat($('re-price').value)||0;
    var down     = parseFloat($('re-down').value)||0;
    var closing  = parseFloat($('re-closing').value)||0;
    var repairs  = parseFloat($('re-repairs').value)||0;
    var rent     = parseFloat($('re-rent').value)||0;
    var expenses = parseFloat($('re-expenses').value)||0;
    var appr     = parseFloat($('re-appr').value)||0;
    var years    = parseInt($('re-years').value)||1;
    var cashInvested = down+closing+repairs;
    var annualCF    = (rent-expenses)*12;
    var totalCF     = annualCF*years;
    var salePrice   = price*Math.pow(1+appr/100,years);
    var apprGain    = salePrice-price;
    var totalReturn = cashInvested+totalCF+apprGain;
    var net  = totalCF+apprGain;
    var roi  = cashInvested>0?(net/cashInvested)*100:0;
    var cocRoi= cashInvested>0?(annualCF/cashInvested)*100:0;
    setResults(roi,net,cashInvested,totalReturn,years,0);
    $('roi-sub').textContent='Real Estate ROI · CoC: '+cocRoi.toFixed(1)+'%/yr · '+years+' yr hold';
  };

  /* ── Marketing ROI ── */
  window.calcMarketing = function(){
    var spend   = parseFloat($('mk-spend').value)||0;
    var revenue = parseFloat($('mk-revenue').value)||0;
    var margin  = parseFloat($('mk-margin').value)||100;
    var months  = parseInt($('mk-months').value)||1;
    var grossProfit = revenue*(margin/100);
    var net  = revenue-spend;
    var roi  = spend>0?(net/spend)*100:0;
    var roas = spend>0?revenue/spend:0;
    setResults(roi,net,spend,revenue,months/12,0);
    $('roi-sub').textContent='Marketing ROI · ROAS: '+roas.toFixed(2)+'x · Gross profit: '+fmtC(grossProfit);
  };

  /* ── Solar ROI ── */
  window.calcSolar = function(){
    var cost      = parseFloat($('sl-cost').value)||0;
    var kw        = parseFloat($('sl-kw').value)||10;
    var itc       = parseFloat($('sl-itc').value)||30;
    var rebate    = parseFloat($('sl-rebate').value)||0;
    var savings   = parseFloat($('sl-savings').value)||0;
    var years     = parseInt($('sl-years').value)||25;
    var escalation= parseFloat($('sl-escalation').value)||3;

    var netCost = cost - (cost * itc/100) - rebate;
    var totalSavings = 0;
    var paybackYear = 0;
    var cumulative = 0;
    for(var i=1;i<=years;i++){
      var yearSaving = savings * Math.pow(1+escalation/100, i-1);
      totalSavings += yearSaving;
      cumulative += yearSaving;
      if(paybackYear===0 && cumulative >= netCost) paybackYear = i;
    }
    var net = totalSavings - netCost;
    var roi = netCost>0 ? (net/netCost)*100 : 0;
    var annRoi = years>0 ? (Math.pow(1+roi/100,1/years)-1)*100 : roi;
    setResults(roi,net,netCost,netCost+totalSavings,years,0);
    $('roi-sub').textContent='Solar ROI · Payback: '+(paybackYear>0?paybackYear+' yrs':'N/A')+' · '+kw+' kW system';
  };

  /* ── Amazon FBA ROI ── */
  window.calcAmazon = function(){
    var prodCost  = parseFloat($('az-cost').value)||0;
    var price     = parseFloat($('az-price').value)||0;
    var referral  = parseFloat($('az-referral').value)||15;
    var fbaFee    = parseFloat($('az-fba').value)||0;
    var ppc       = parseFloat($('az-ppc').value)||0;
    var units     = parseInt($('az-units').value)||1;
    var other     = parseFloat($('az-other').value)||0;

    var referralFee = price * (referral/100);
    var totalCostPerUnit = prodCost + referralFee + fbaFee + ppc + other;
    var profitPerUnit = price - totalCostPerUnit;
    var roiPerUnit = totalCostPerUnit>0 ? (profitPerUnit/totalCostPerUnit)*100 : 0;
    var monthlyProfit = profitPerUnit * units;
    var monthlyRevenue = price * units;
    var monthlyInvest = totalCostPerUnit * units;

    setResults(roiPerUnit, monthlyProfit, monthlyInvest, monthlyRevenue, 1/12, 0);
    $('roi-sub').textContent='Amazon FBA · '+fmtD(profitPerUnit)+'/unit profit · '+fmtC(monthlyProfit)+'/mo';
  };

  /* ── Project ROI ── */
  window.calcProject = function(){
    var cost     = parseFloat($('pj-cost').value)||0;
    var benefits = parseFloat($('pj-benefits').value)||0;
    var years    = parseInt($('pj-years').value)||1;
    var discount = parseFloat($('pj-discount').value)||0;
    var totalBen = benefits*years;
    var net  = totalBen-cost;
    var roi  = cost>0?(net/cost)*100:0;
    // NPV
    var r = discount/100;
    var npv = -cost;
    for(var i=1;i<=years;i++) npv += benefits/Math.pow(1+r,i);
    setResults(roi,net,cost,cost+totalBen,years,0);
    $('roi-sub').textContent='Project ROI · NPV: '+fmtC(npv)+' · '+years+' yr project';
  };

  /* ── Tab switching ── */
  document.querySelectorAll('.roi-tab').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.querySelectorAll('.roi-tab').forEach(function(b){b.classList.remove('active');});
      document.querySelectorAll('.roi-panel').forEach(function(p){p.classList.remove('active');});
      btn.classList.add('active');
      var t = btn.getAttribute('data-tab');
      var panel = $('tab-' + t);
      if (panel) panel.classList.add('active');
      if (t === 'basic') calcBasic();
      else if (t === 'realestate') calcRealEstate();
      else if (t === 'marketing') calcMarketing();
      else if (t === 'solar') calcSolar();
      else if (t === 'amazon') calcAmazon();
      else if (t === 'project') calcProject();
    });
  });

  /* ── Live input real-time calculation listeners ── */
  document.querySelectorAll('#tab-basic input').forEach(function(el){ el.addEventListener('input', calcBasic); el.addEventListener('change', calcBasic); });
  document.querySelectorAll('#tab-realestate input').forEach(function(el){ el.addEventListener('input', calcRealEstate); el.addEventListener('change', calcRealEstate); });
  document.querySelectorAll('#tab-marketing input').forEach(function(el){ el.addEventListener('input', calcMarketing); el.addEventListener('change', calcMarketing); });
  document.querySelectorAll('#tab-solar input').forEach(function(el){ el.addEventListener('input', calcSolar); el.addEventListener('change', calcSolar); });
  document.querySelectorAll('#tab-amazon input').forEach(function(el){ el.addEventListener('input', calcAmazon); el.addEventListener('change', calcAmazon); });
  document.querySelectorAll('#tab-project input').forEach(function(el){ el.addEventListener('input', calcProject); el.addEventListener('change', calcProject); });

  /* ── FAQ ── */
  document.querySelectorAll('.roi-faq-q').forEach(function(q){
    q.addEventListener('click',function(){
      var item=this.closest('.roi-faq-item'), was=item.classList.contains('open');
      document.querySelectorAll('.roi-faq-item').forEach(function(i){i.classList.remove('open');});
      if(!was) item.classList.add('open');
    });
  });

  /* ── TOC scroll spy ── */
  var links=document.querySelectorAll('.roi-toc a');
  var secs=[];
  links.forEach(function(a){
    var href=a.getAttribute('href');
    if(!href || href.charAt(0)!=='#') return;
    var id=href.replace('#','');
    var el=document.getElementById(id);
    if(el) secs.push({a:a,el:el});
  });
  window.addEventListener('scroll',function(){
    var y=window.scrollY+140;
    var cur=secs[0];
    secs.forEach(function(s){if(s.el.getBoundingClientRect().top+window.scrollY<=y)cur=s;});
    links.forEach(function(a){a.classList.remove('active');});
    if(cur) cur.a.classList.add('active');
  },{passive:true});

  /* Initial calc */
  calcBasic();
})();
</script>
