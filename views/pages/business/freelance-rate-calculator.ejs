          <tr><td><strong>Digital Marketing / SEO</strong></td>    <td>$40 – $65/hr</td>  <td>$70 – $110/hr</td> <td>$120 – $200/hr</td></tr>
          <tr><td><strong>Video Production / Editing</strong></td> <td>$40 – $65/hr</td>  <td>$70 – $100/hr</td> <td>$100 – $175/hr</td></tr>
