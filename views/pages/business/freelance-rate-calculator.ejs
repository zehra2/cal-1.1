<%- include('../../partials/header') %>
<style>
/* ── Page base ── */
body { background:#f5f7fa; }

.fr-page-wrap {
  max-width:1320px; margin:0 auto; padding:2rem 1.5rem 4rem;
  display:grid; grid-template-columns:220px 1fr 260px; gap:2rem; align-items:start;
}

/* ══ LEFT TOC ══ */
.fr-toc {
  position:sticky; top:6rem; background:#fff; border-radius:12px;
  border:1px solid #e8edf5; box-shadow:0 2px 12px rgba(0,0,0,.04); overflow:hidden;
}
.fr-toc-head {
  background:linear-gradient(135deg,#0369a1 0%,#075985 100%);
  color:#fff; padding:1rem 1.25rem; font-weight:700; font-size:.85rem;
  text-transform:uppercase; letter-spacing:.8px;
}
.fr-toc-list { list-style:none; padding:.75rem 0; margin:0; }
.fr-toc-list li a {
  display:block; padding:.5rem 1.25rem; font-size:.84rem; color:#475569;
  text-decoration:none; border-left:3px solid transparent; transition:all .18s; line-height:1.4;
}
.fr-toc-list li a:hover,.fr-toc-list li a.fr-toc-active { color:#0369a1; background:#f0f9ff; border-left-color:#0369a1; }
.fr-toc-div  { height:1px; background:#f1f5f9; margin:.5rem 0; }
.fr-toc-rlbl { padding:.5rem 1.25rem; font-size:.78rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.5px; }
.fr-toc-rlist { list-style:none; padding:0; margin:0 0 .75rem; }
.fr-toc-rlist li a { display:block; padding:.4rem 1.25rem; font-size:.82rem; color:#64748b; text-decoration:none; transition:color .15s; }
.fr-toc-rlist li a:hover { color:#0369a1; }

/* ══ MAIN ══ */
.fr-main { min-width:0; }

.fr-hero { margin-bottom:2rem; }
.fr-hero h1 { font-size:2.1rem; color:#0f172a; margin:0 0 .6rem; line-height:1.25; }
.fr-hero .fr-desc { font-size:1.05rem; color:#64748b; line-height:1.65; margin:0 0 .75rem; border-left:4px solid #7dd3fc; padding-left:1rem; }
.fr-breadcrumb { font-size:.8rem; color:#94a3b8; margin-bottom:.75rem; }
.fr-breadcrumb a { color:#64748b; text-decoration:none; }
.fr-breadcrumb a:hover { color:#0369a1; }

/* ══ CALCULATOR CARD ══ */
.fr-card {
  background:#fff; border-radius:14px; box-shadow:0 4px 24px rgba(0,0,0,.05);
  border:1px solid #eef2f7; margin-bottom:2.5rem; overflow:hidden;
}
.fr-tabs { display:flex; border-bottom:1px solid #e2e8f0; background:#f8fafc; }
.fr-tab {
  flex:1; text-align:center; padding:1rem .5rem; font-size:.9rem; font-weight:600;
  color:#64748b; cursor:pointer; border-bottom:3px solid transparent; transition:all .2s;
  background:none; border-top:none; border-left:none; border-right:none;
}
.fr-tab:hover  { color:#0369a1; background:#f0f9ff; }
.fr-tab.active { color:#0369a1; border-bottom-color:#0369a1; background:#fff; }

.fr-inner { display:grid; grid-template-columns:1fr 1fr; }
.fr-form-col { padding:2rem; border-right:1px solid #f0f4fa; }
.fr-res-col  { padding:2rem; background:linear-gradient(160deg,#f8fafc 0%,#f0f9ff 100%); }

.fr-panel { display:none; }
.fr-panel.active { display:block; }
.fr-panel-desc { font-size:.85rem; color:#64748b; margin-bottom:1.5rem; line-height:1.5; }

.fr-field { margin-bottom:1.25rem; }
.fr-field label { display:block; font-weight:600; font-size:.9rem; color:#1e293b; margin-bottom:.4rem; }
.fr-field input {
  width:100%; padding:12px 15px; border:1.5px solid #d1dae8; border-radius:8px;
  font-size:1rem; color:#0f172a; outline:none; transition:border-color .2s,box-shadow .2s;
  box-sizing:border-box; background:#fff;
}
.fr-field input:focus { border-color:#0369a1; box-shadow:0 0 0 3px rgba(3,105,161,.12); }
.fr-field .fr-hint { font-size:.76rem; color:#94a3b8; margin-top:.3rem; line-height:1.4; }
.fr-field .fr-opt  { font-size:.7rem; font-weight:400; color:#94a3b8; margin-left:.3rem; }
.fr-row2 { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }

.fr-btn {
  width:100%; background:linear-gradient(135deg,#0369a1 0%,#075985 100%);
  color:#fff; padding:15px; border:none; border-radius:9px; font-size:1rem;
  font-weight:700; cursor:pointer; margin-top:.5rem; transition:opacity .2s,transform .15s;
}
.fr-btn:hover { opacity:.92; transform:translateY(-1px); }

/* ── Results ── */
.fr-res-head { font-size:1.15rem; font-weight:700; color:#0f172a; margin:0 0 .25rem; }
.fr-res-sub  { font-size:.84rem; color:#64748b; margin:0 0 1.25rem; }

.fr-primary-box {
  background:linear-gradient(135deg,#0369a1,#075985);
  border-radius:10px; padding:1.35rem 1rem; text-align:center;
  box-shadow:0 6px 18px rgba(3,105,161,.22); margin-bottom:.75rem;
}
.fr-primary-val { display:block; font-size:2.4rem; font-weight:800; color:#fff; line-height:1; margin-bottom:.2rem; }
.fr-primary-lbl { font-size:.88rem; color:rgba(255,255,255,.8); }

.fr-rate-boxes { display:grid; grid-template-columns:1fr 1fr; gap:.7rem; margin-bottom:1rem; }
.fr-rate-box { background:#fff; border:1.5px solid #e8edf5; border-radius:10px; padding:.9rem .75rem; text-align:center; }
.fr-rate-val { display:block; font-size:1.2rem; font-weight:800; color:#0369a1; margin-bottom:.15rem; }
.fr-rate-lbl { font-size:.72rem; color:#64748b; font-weight:600; line-height:1.3; }

/* Rate breakdown bar */
.fr-breakdown { margin-top:1rem; background:#fff; padding:.9rem; border-radius:10px; border:1px solid #e2e8f0; }
.fr-bkd-title { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#94a3b8; margin-bottom:.5rem; }
.fr-bkd-rows  { display:flex; flex-direction:column; gap:.4rem; }
.fr-bkd-row   { display:flex; justify-content:space-between; align-items:center; font-size:.82rem; padding:.25rem 0; border-bottom:1px solid #f8fafc; }
.fr-bkd-row:last-child { border-bottom:none; font-weight:800; color:#0369a1; }
.fr-bkd-label { color:#64748b; }
.fr-bkd-val   { font-weight:600; color:#1e293b; }

/* Viability gauge */
.fr-gauge { margin-top:1rem; background:#fff; padding:.9rem; border-radius:10px; border:1px solid #e2e8f0; display:none; }
.fr-gauge.show { display:block; }
.fr-gauge-title { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#94a3b8; margin-bottom:.5rem; }
.fr-gauge-bar { display:flex; height:8px; border-radius:4px; overflow:hidden; background:#e2e8f0; position:relative; margin-bottom:.4rem; }
.fr-gauge-fill { position:absolute; left:0; top:0; height:100%; background:linear-gradient(90deg,#ef4444,#f59e0b,#22c55e); width:100%; }
.fr-gauge-marker { position:absolute; top:-3px; width:4px; height:14px; background:#0f172a; border-radius:2px; box-shadow:0 0 0 2px #fff; transition:left .4s; }
.fr-gauge-labels { display:flex; justify-content:space-between; font-size:.69rem; color:#94a3b8; font-weight:600; }
.fr-gauge-verdict { font-size:.82rem; margin-top:.6rem; color:#475569; line-height:1.5; }

/* ══ CONTENT SECTIONS ══ */
.fr-section {
  background:#fff; border-radius:14px; border:1px solid #eef2f7;
  box-shadow:0 2px 12px rgba(0,0,0,.03); padding:2.25rem;
  margin-bottom:2rem; scroll-margin-top:6rem;
}
.fr-section h2 { font-size:1.65rem; color:#0f172a; margin:0 0 1.25rem; padding-bottom:.75rem; border-bottom:2px solid #f0f4fa; }
.fr-section h3 { font-size:1.18rem; color:#1e293b; margin:1.75rem 0 .7rem; }
.fr-section p  { color:#475569; line-height:1.75; margin-bottom:1.25rem; font-size:1rem; }
.fr-section ul,.fr-section ol { color:#475569; line-height:1.75; padding-left:1.5rem; margin-bottom:1.25rem; }
.fr-section li { margin-bottom:.5rem; }
.fr-section strong { color:#1e293b; }
.fr-section a  { color:#0369a1; }

.fr-formula { background:#0f172a; color:#7dd3fc; font-family:'Courier New',monospace; font-size:1rem; padding:1.1rem 1.4rem; border-radius:8px; margin:1.25rem 0; line-height:1.9; }
.fr-formula code { display:block; }

.fr-table { width:100%; border-collapse:collapse; border-radius:10px; overflow:hidden; border:1px solid #e8edf5; margin-bottom:1.5rem; }
.fr-table th { background:#0369a1; color:#fff; padding:13px 16px; text-align:left; font-size:.88rem; font-weight:600; }
.fr-table td { padding:11px 16px; border-bottom:1px solid #f1f5f9; font-size:.9rem; color:#334155; }
.fr-table tr:last-child td { border-bottom:none; }
.fr-table tr:nth-child(even) td { background:#f8fafc; }

.fr-info-box { background:#f0f9ff; border-left:4px solid #0369a1; border-radius:0 8px 8px 0; padding:1rem 1.25rem; margin:1.25rem 0; font-size:.95rem; color:#075985; line-height:1.6; }
.fr-warn-box { background:#fffbeb; border-left:4px solid #d97706; border-radius:0 8px 8px 0; padding:1rem 1.25rem; margin:1.25rem 0; font-size:.95rem; color:#92400e; line-height:1.6; }

/* FAQ accordion */
.fr-faq-item { border-bottom:1px solid #f0f4fa; padding-bottom:1.25rem; margin-bottom:1.25rem; }
.fr-faq-item:last-child { border-bottom:none; margin-bottom:0; padding-bottom:0; }
.fr-faq-q { font-size:1.02rem; font-weight:700; color:#0f172a; margin-bottom:.6rem; cursor:pointer; display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; }
.fr-faq-q::after { content:'+'; font-size:1.3rem; color:#0369a1; flex-shrink:0; }
.fr-faq-item.open .fr-faq-q::after { content:'−'; }
.fr-faq-a { color:#475569; line-height:1.7; font-size:.97rem; display:none; }
.fr-faq-item.open .fr-faq-a { display:block; }

/* ══ RIGHT SIDEBAR ══ */
.fr-sidebar { position:sticky; top:6rem; display:flex; flex-direction:column; gap:1.25rem; }

.fr-widget { background:#fff; border-radius:12px; border:1px solid #e8edf5; box-shadow:0 4px 18px rgba(0,0,0,.05); overflow:hidden; }
.fr-widget-head { background:linear-gradient(135deg,#0369a1,#075985); color:#fff; padding:1rem 1.25rem; }
.fr-widget-title    { font-size:1rem; font-weight:700; }
.fr-widget-subtitle { font-size:.8rem; color:rgba(255,255,255,.75); }
.fr-widget-updated  { font-size:.72rem; color:rgba(255,255,255,.6); margin-top:.35rem; }

.fr-rate-rows { padding:.4rem 0; }
.fr-rate-row  { display:flex; justify-content:space-between; align-items:center; padding:.6rem 1.25rem; border-bottom:1px solid #f8fafc; transition:background .15s; }
.fr-rate-row:last-child { border-bottom:none; }
.fr-rate-row:hover { background:#f0f9ff; }
.fr-rl { font-size:.82rem; font-weight:600; color:#334155; }
.fr-rs { font-size:.72rem; color:#94a3b8; }
.fr-rv { font-size:1rem; font-weight:800; color:#0369a1; white-space:nowrap; }

.fr-widget-foot { padding:.85rem 1.25rem; border-top:1px solid #f0f4fa; background:#f8fafc; }
.fr-widget-foot p { font-size:.75rem; color:#64748b; margin:0 0 .5rem; line-height:1.3; }
.fr-widget-foot a { font-size:.83rem; font-weight:700; color:#0369a1; text-decoration:none; display:flex; align-items:center; gap:.35rem; }
.fr-widget-foot a:hover { text-decoration:underline; }

.fr-quick-widget { background:#fff; border-radius:12px; border:1px solid #e8edf5; box-shadow:0 2px 12px rgba(0,0,0,.04); overflow:hidden; }
.fr-quick-head  { padding:.9rem 1.25rem; background:#f8fafc; border-bottom:1px solid #f0f4fa; font-size:.83rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:.5px; }
.fr-quick-links { list-style:none; padding:.5rem 0; margin:0; }
.fr-quick-links li a { display:flex; align-items:center; gap:.5rem; padding:.65rem 1.25rem; font-size:.85rem; color:#475569; text-decoration:none; border-left:3px solid transparent; transition:all .15s; font-weight:500; }
.fr-quick-links li a:hover,.fr-quick-links li a.active { color:#0369a1; background:#f0f9ff; border-left-color:#0369a1; }

/* ── Responsive ── */
@media(max-width:1200px){ .fr-page-wrap{ grid-template-columns:200px 1fr 240px; } }
@media(max-width:1024px){
  .fr-page-wrap{ grid-template-columns:1fr; }
  .fr-toc,.fr-sidebar{ position:static; }
  .fr-sidebar{ display:grid; grid-template-columns:1fr 1fr; }
}
@media(max-width:768px){
  .fr-page-wrap{ padding:1rem 1rem 3rem; }
  .fr-inner{ grid-template-columns:1fr; }
  .fr-form-col{ border-right:none; border-bottom:1px solid #f0f4fa; }
  .fr-sidebar{ grid-template-columns:1fr; }
  .fr-tabs{ flex-direction:column; }
  .fr-tab{ border-left:3px solid transparent; border-bottom:none; text-align:left; padding:.75rem 1.25rem; }
  .fr-tab.active{ border-left-color:#0369a1; }
  .fr-row2{ grid-template-columns:1fr; }
  .fr-rate-boxes{ grid-template-columns:1fr 1fr; }
}
</style>

<main id="main-content">
<div class="fr-page-wrap">

  <!-- ══ LEFT TOC ══ -->
  <aside class="fr-toc">
    <div class="fr-toc-head">📋 In This Article</div>
    <ul class="fr-toc-list">
      <li><a href="#calculator" class="fr-toc-active">Freelance Rate Calculator</a></li>
      <li><a href="#how-to-use">How to Use</a></li>
      <li><a href="#the-formula">The Rate Formula</a></li>
      <li><a href="#taxe">US Taxes for Freelancers</a></li>
      <li><a href="#benchmark"><%= currentYear %> Rate Benchmarks</a></li>
      <li><a href="#undercharging">Why Freelancers Undercharge</a></li>
      <li><a href="#raise-rate">How to Raise Your Rate</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>
    <div class="fr-toc-div"></div>
    <div class="fr-toc-rlbl">Related Tools</div>
    <ul class="fr-toc-rlist">
      <li><a href="<%= baseUrl %>/business/profit-margin-calculator">Profit Margin Calculator</a></li>
      <li><a href="<%= baseUrl %>/business/markup-calculator">Markup Calculator</a></li>
      <li><a href="<%= baseUrl %>/loan-calculators/business-loan-calculator">Business Loan</a></li>
      <li><a href="<%= baseUrl %>/ohio/overtime-calculator">Overtime Calculator</a></li>
    </ul>
  </aside>

  <!-- ══ MAIN ══ -->
  <div class="fr-main">

    <!-- HERO -->
    <div class="fr-hero">
      <div class="fr-breadcrumb">
        <a href="<%= baseUrl %>/index.php">Home</a> ›
        <a href="<%= baseUrl %>/business/">Business</a> ›
        Freelance Rate Calculator
      </div>
      <h1>Freelance Rate Calculator (<%= currentYear %>)</h1>
      <p class="fr-desc">
        Calculate your <strong>minimum viable hourly rate</strong>, day rate, and project price — based on
        your real income goals, US self-employment taxes, business expenses, and actual billable hours.
        Stop guessing. Start charging what you're worth.
      </p>
    </div>

    <!-- ══ CALCULATOR ══ -->
    <div class="fr-card" id="calculator">
      <div class="fr-tabs">
        <button class="fr-tab active" data-panel="fr-p-hourly">⏱ Hourly Rate</button>
        <button class="fr-tab"        data-panel="fr-p-day">📅 Day Rate</button>
        <button class="fr-tab"        data-panel="fr-p-project">📦 Project Price</button>
      </div>

      <div class="fr-inner">

        <!-- FORM COLUMN -->
        <div class="fr-form-col">

          <!-- Panel: Hourly Rate -->
          <div id="fr-p-hourly" class="fr-panel active">
            <p class="fr-panel-desc">Calculate the minimum hourly rate you must charge to hit your income goal after taxes and expenses.</p>
            <div class="fr-row2">
              <div class="fr-field">
                <label for="fr_income">Target Net Income ($/yr)</label>
                <input type="number" id="fr_income" value="75000" min="1" step="1000">
                <div class="fr-hint">Take-home pay you want after all taxes</div>
              </div>
              <div class="fr-field">
                <label for="fr_expenses">Annual Business Expenses ($)</label>
                <input type="number" id="fr_expenses" value="6000" min="0" step="100">
                <div class="fr-hint">Software, equipment, insurance, accounting</div>
              </div>
            </div>
            <div class="fr-row2">
              <div class="fr-field">
                <label for="fr_hours">Billable Hours / Week</label>
                <input type="number" id="fr_hours" value="25" min="1" max="60" step="1">
                <div class="fr-hint">Realistic client-facing hours (not total work hours)</div>
              </div>
              <div class="fr-field">
                <label for="fr_tax">Combined Tax Rate (%)</label>
                <input type="number" id="fr_tax" value="30" min="0" max="60" step="0.5">
                <div class="fr-hint">SE tax (15.3%) + federal income tax. Typically 25–38% total</div>
              </div>
            </div>
            <div class="fr-row2">
              <div class="fr-field">
                <label for="fr_weeks">Working Weeks / Year</label>
                <input type="number" id="fr_weeks" value="48" min="1" max="52" step="1">
                <div class="fr-hint">52 minus vacation &amp; sick weeks (default: 48)</div>
              </div>
              <div class="fr-field">
                <label for="fr_buffer">Vacancy Buffer (%) <span class="fr-opt">(optional)</span></label>
                <input type="number" id="fr_buffer" value="15" min="0" max="50" step="1">
                <div class="fr-hint">% of time without billable work (gaps, pitching)</div>
              </div>
            </div>
          </div>

          <!-- Panel: Day Rate -->
          <div id="fr-p-day" class="fr-panel">
            <p class="fr-panel-desc">Find your day rate directly from your hourly rate, or calculate a standalone day rate for client negotiations.</p>
            <div class="fr-row2">
              <div class="fr-field">
                <label for="fr_d_income">Target Net Income ($/yr)</label>
                <input type="number" id="fr_d_income" value="75000" min="1" step="1000">
                <div class="fr-hint">What you want to take home after taxes</div>
              </div>
              <div class="fr-field">
                <label for="fr_d_expenses">Annual Business Expenses ($)</label>
                <input type="number" id="fr_d_expenses" value="6000" min="0" step="100">
                <div class="fr-hint">All operating costs of your freelance business</div>
              </div>
            </div>
            <div class="fr-row2">
              <div class="fr-field">
                <label for="fr_d_hrs_day">Hours per Work Day</label>
                <input type="number" id="fr_d_hrs_day" value="8" min="1" max="16" step="0.5">
                <div class="fr-hint">Your billable hours in a day (typically 6–8)</div>
              </div>
              <div class="fr-field">
                <label for="fr_d_tax">Combined Tax Rate (%)</label>
                <input type="number" id="fr_d_tax" value="30" min="0" max="60" step="0.5">
                <div class="fr-hint">SE tax + federal + state income tax</div>
              </div>
            </div>
            <div class="fr-row2">
              <div class="fr-field">
                <label for="fr_d_days">Billable Days / Year</label>
                <input type="number" id="fr_d_days" value="200" min="1" max="260" step="1">
                <div class="fr-hint">260 working days minus vacation, holidays &amp; gaps</div>
              </div>
            </div>
          </div>

          <!-- Panel: Project Price -->
          <div id="fr-p-project" class="fr-panel">
            <p class="fr-panel-desc">Turn your hourly rate into a fixed project price. Add a scope creep buffer to protect your margin.</p>
            <div class="fr-row2">
              <div class="fr-field">
                <label for="fr_p_hourly">Your Hourly Rate ($)</label>
                <input type="number" id="fr_p_hourly" value="95" min="1" step="1">
                <div class="fr-hint">Your calculated or market hourly rate</div>
              </div>
              <div class="fr-field">
                <label for="fr_p_hours">Estimated Project Hours</label>
                <input type="number" id="fr_p_hours" value="40" min="1" step="1">
                <div class="fr-hint">Your realistic estimate for this project</div>
              </div>
            </div>
            <div class="fr-row2">
              <div class="fr-field">
                <label for="fr_p_buffer">Scope Creep Buffer (%)</label>
                <input type="number" id="fr_p_buffer" value="20" min="0" max="100" step="5">
                <div class="fr-hint">Add 15–25% to protect against scope expansion</div>
              </div>
              <div class="fr-field">
                <label for="fr_p_revisions">Revision Rounds Included</label>
                <input type="number" id="fr_p_revisions" value="2" min="0" max="20" step="1">
                <div class="fr-hint">Each revision round adds ~10% of base time</div>
              </div>
            </div>
          </div>

          <button class="fr-btn" id="fr-calc-btn">⚡ Calculate My Rate</button>
        </div>

        <!-- RESULTS COLUMN -->
        <div class="fr-res-col">
          <h3 class="fr-res-head">Your Rate</h3>
          <p class="fr-res-sub" id="fr-res-sub">Based on your inputs</p>

          <div class="fr-primary-box">
            <span class="fr-primary-val" id="fr-primary-val">$95/hr</span>
            <span class="fr-primary-lbl" id="fr-primary-lbl">Minimum Hourly Rate</span>
          </div>

          <div class="fr-rate-boxes" id="fr-rate-boxes">
            <div class="fr-rate-box">
              <span class="fr-rate-val" id="fr-box1-val">$760</span>
              <span class="fr-rate-lbl" id="fr-box1-lbl">Day Rate (8 hrs)</span>
            </div>
            <div class="fr-rate-box">
              <span class="fr-rate-val" id="fr-box2-val">$15,200</span>
              <span class="fr-rate-lbl" id="fr-box2-lbl">Monthly Revenue</span>
            </div>
            <div class="fr-rate-box">
              <span class="fr-rate-val" id="fr-box3-val">$182,400</span>
              <span class="fr-rate-lbl" id="fr-box3-lbl">Annual Revenue Target</span>
            </div>
            <div class="fr-rate-box">
              <span class="fr-rate-val" id="fr-box4-val">$75,000</span>
              <span class="fr-rate-lbl" id="fr-box4-lbl">Est. Take-Home</span>
            </div>
          </div>

