<script>
document.addEventListener('DOMContentLoaded', function () {

  const tabs    = document.querySelectorAll('.fr-tab');
  const panels  = document.querySelectorAll('.fr-panel');
  const calcBtn = document.getElementById('fr-calc-btn');

  let currentPanel = 'fr-p-hourly';

  // ── Helpers ──
  const fmtC  = v => '$' + Math.round(v).toLocaleString('en-US');
  const fmtCd = v => '$' + Number(v).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
  const fmtCr = v => '$' + Math.round(v).toLocaleString('en-US') + '/hr';

  // ── Tab switching ──
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      currentPanel = tab.getAttribute('data-panel');
      document.getElementById(currentPanel).classList.add('active');
      calculate();
    });
  });

  // ── Main calculate dispatcher ──
  function calculate() {
    if (currentPanel === 'fr-p-hourly')  calcHourly();
    else if (currentPanel === 'fr-p-day') calcDay();
    else calcProject();
  }

  // ── Hourly Rate ──
  function calcHourly() {
    const income   = parseFloat(document.getElementById('fr_income').value)   || 0;
    const expenses = parseFloat(document.getElementById('fr_expenses').value) || 0;
    const hours    = parseFloat(document.getElementById('fr_hours').value)    || 0;
    const tax      = parseFloat(document.getElementById('fr_tax').value)      || 0;
    const weeks    = parseFloat(document.getElementById('fr_weeks').value)    || 0;
    const buffer   = parseFloat(document.getElementById('fr_buffer').value)   || 0;

    if (income <= 0 || hours <= 0 || weeks <= 0) {
      document.getElementById('fr-res-sub').textContent = 'Enter valid inputs to calculate.';
      return;
    }

    const taxRate    = tax / 100;
    const bufferRate = buffer / 100;

    // Step 1: gross revenue to cover income + expenses + tax
    const grossNeeded = (income + expenses) / (1 - taxRate);
    // Step 2: gross up for vacancy buffer
    const totalNeeded = bufferRate < 1 ? grossNeeded / (1 - bufferRate) : grossNeeded;
    // Step 3: annual billable hours
    const annualHours = hours * weeks;
    // Step 4: hourly rate
    const hourlyRate  = annualHours > 0 ? totalNeeded / annualHours : 0;
    const dayRate     = hourlyRate * 8;
    const monthlyRev  = totalNeeded / 12;
    const taxAmt      = grossNeeded - income - expenses;
    const bufferAmt   = totalNeeded - grossNeeded;

    showPrimary(fmtCr(hourlyRate), 'Minimum Hourly Rate');
    document.getElementById('fr-box1-val').textContent = fmtC(dayRate);
    document.getElementById('fr-box1-lbl').textContent = 'Day Rate (8 hrs)';
    document.getElementById('fr-box2-val').textContent = fmtC(monthlyRev);
    document.getElementById('fr-box2-lbl').textContent = 'Monthly Revenue Target';
    document.getElementById('fr-box3-val').textContent = fmtC(totalNeeded);
    document.getElementById('fr-box3-lbl').textContent = 'Annual Revenue Target';
    document.getElementById('fr-box4-val').textContent = fmtC(income);
    document.getElementById('fr-box4-lbl').textContent = 'Est. Take-Home';
    document.getElementById('fr-res-sub').textContent  = annualHours + ' billable hours/year · ' + hours + ' hrs/week × ' + weeks + ' weeks';

    document.getElementById('bkd-income').textContent   = fmtC(income);
    document.getElementById('bkd-expenses').textContent = fmtC(expenses);
    document.getElementById('bkd-taxes').textContent    = fmtC(taxAmt);
    document.getElementById('bkd-buffer').textContent   = fmtC(bufferAmt);
    document.getElementById('bkd-gross').textContent    = fmtC(totalNeeded);

    updateGauge(hourlyRate);
  }

  // ── Day Rate ──
  function calcDay() {
    const income   = parseFloat(document.getElementById('fr_d_income').value)    || 0;
    const expenses = parseFloat(document.getElementById('fr_d_expenses').value)  || 0;
    const hrsDay   = parseFloat(document.getElementById('fr_d_hrs_day').value)   || 0;
    const tax      = parseFloat(document.getElementById('fr_d_tax').value)       || 0;
    const days     = parseFloat(document.getElementById('fr_d_days').value)      || 0;

    if (income <= 0 || days <= 0 || hrsDay <= 0) {
      document.getElementById('fr-res-sub').textContent = 'Enter valid inputs to calculate.';
      return;
    }

    const taxRate     = tax / 100;
    const grossNeeded = (income + expenses) / (1 - taxRate);
    const dayRate     = days > 0 ? grossNeeded / days : 0;
    const hourlyRate  = hrsDay > 0 ? dayRate / hrsDay : 0;
    const weeklyRev   = grossNeeded / 52;
    const monthlyRev  = grossNeeded / 12;
    const taxAmt      = grossNeeded - income - expenses;

    showPrimary(fmtC(dayRate) + '/day', 'Minimum Day Rate');
    document.getElementById('fr-box1-val').textContent = fmtCr(hourlyRate);
    document.getElementById('fr-box1-lbl').textContent = 'Implied Hourly Rate';
    document.getElementById('fr-box2-val').textContent = fmtC(weeklyRev);
    document.getElementById('fr-box2-lbl').textContent = 'Weekly Revenue (avg)';
    document.getElementById('fr-box3-val').textContent = fmtC(monthlyRev);
    document.getElementById('fr-box3-lbl').textContent = 'Monthly Revenue Target';
    document.getElementById('fr-box4-val').textContent = fmtC(grossNeeded);
    document.getElementById('fr-box4-lbl').textContent = 'Annual Revenue Target';
    document.getElementById('fr-res-sub').textContent  = days + ' billable days/year at ' + hrsDay + ' hrs/day';

    document.getElementById('bkd-income').textContent   = fmtC(income);
    document.getElementById('bkd-expenses').textContent = fmtC(expenses);
    document.getElementById('bkd-taxes').textContent    = fmtC(taxAmt);
    document.getElementById('bkd-buffer').textContent   = '—';
    document.getElementById('bkd-gross').textContent    = fmtC(grossNeeded);

    updateGauge(hourlyRate);
  }

  // ── Project Price ──
  function calcProject() {
    const hourly    = parseFloat(document.getElementById('fr_p_hourly').value)    || 0;
    const estHours  = parseFloat(document.getElementById('fr_p_hours').value)     || 0;
    const buffer    = parseFloat(document.getElementById('fr_p_buffer').value)    || 0;
    const revisions = parseFloat(document.getElementById('fr_p_revisions').value) || 0;

    if (hourly <= 0 || estHours <= 0) {
      document.getElementById('fr-res-sub').textContent = 'Enter hourly rate and estimated hours.';
      return;
    }

    const revHours    = revisions * estHours * 0.10;
    const totalHours  = estHours + revHours;
    const basePrice   = totalHours * hourly;
    const bufferAmt   = basePrice * (buffer / 100);
    const projectPrice = basePrice + bufferAmt;
    const minPrice    = estHours * hourly;   // no buffer, no revisions
    const maxPrice    = projectPrice * 1.15; // 15% above recommended

    showPrimary(fmtC(projectPrice), 'Recommended Project Price');
    document.getElementById('fr-box1-val').textContent = fmtC(minPrice);
    document.getElementById('fr-box1-lbl').textContent = 'Minimum (no buffer)';
    document.getElementById('fr-box2-val').textContent = fmtC(maxPrice);
    document.getElementById('fr-box2-lbl').textContent = 'Premium Price (+15%)';
    document.getElementById('fr-box3-val').textContent = Math.round(totalHours) + ' hrs';
    document.getElementById('fr-box3-lbl').textContent = 'Total Hours (incl. revisions)';
    document.getElementById('fr-box4-val').textContent = fmtCr(hourly);
    document.getElementById('fr-box4-lbl').textContent = 'Your Hourly Rate';
    document.getElementById('fr-res-sub').textContent  = estHours + ' est. hrs + ' + revisions + ' revision rounds + ' + buffer + '% buffer';

    document.getElementById('bkd-income').textContent   = fmtC(estHours * hourly);
    document.getElementById('bkd-expenses').textContent = fmtC(revHours * hourly);
    document.getElementById('bkd-taxes').textContent    = fmtC(bufferAmt);
    document.getElementById('bkd-buffer').textContent   = '—';
    document.getElementById('bkd-gross').textContent    = fmtC(projectPrice);

    // Relabel breakdown rows for project mode
    const rows = document.querySelectorAll('.fr-bkd-row .fr-bkd-label');
    if (rows.length >= 5) {
      rows[0].textContent = 'Base (Est. Hours × Rate)';
      rows[1].textContent = 'Revision Rounds';
      rows[2].textContent = 'Scope Buffer';
      rows[3].textContent = '';
      rows[4].textContent = '→ Recommended Project Price';
    }

    document.getElementById('fr-gauge').classList.remove('show');
  }

  function showPrimary(val, lbl) {
    document.getElementById('fr-primary-val').textContent = val;
    document.getElementById('fr-primary-lbl').textContent = lbl;
  }

  function updateGauge(rate) {
    const gauge  = document.getElementById('fr-gauge');
    const marker = document.getElementById('fr-gauge-marker');
    const verdict = document.getElementById('fr-gauge-verdict');
    gauge.classList.add('show');

    // Scale: $20 = 0%, $200 = 100%
    let pct = ((rate - 20) / (200 - 20)) * 100;
    pct = Math.max(0, Math.min(100, pct));
    marker.style.left = pct + '%';

    let msg = '';
    if (rate < 40)       msg = '<strong>Entry-level range.</strong> Viable for VAs, basic data entry, and very junior work. Most US freelance fields require higher rates to be sustainable.';
    else if (rate < 70)  msg = '<strong>Junior to mid-level range.</strong> Competitive for generalists and moderately experienced freelancers in most fields.';
    else if (rate < 120) msg = '<strong>Solid mid-level rate.</strong> Typical for experienced freelancers with a defined niche and 3–7 years of experience.';
    else if (rate < 175) msg = '<strong>Senior range.</strong> Expected for specialists, experts, and consultants with strong portfolios and client outcomes.';
    else                 msg = '<strong>Expert / Consultant level.</strong> Typical for highly specialized experts, senior strategists, and consultants with proven ROI.';
    verdict.innerHTML = msg;
  }

  // ── Auto-calculate on input ──
  const allInputs = document.querySelectorAll('.fr-field input');
  allInputs.forEach(el => el.addEventListener('input', calculate));
  calcBtn.addEventListener('click', calculate);
  calculate(); // init

  // ── TOC scroll highlight ──
  const tocLinks = document.querySelectorAll('.fr-toc-list a');
  const sections = [];
  tocLinks.forEach(link => {
    const id  = link.getAttribute('href').replace('#', '');
    const sec = document.getElementById(id);
    if (sec) sections.push({ link, sec });
  });
  function updateTOC() {
    const y = window.scrollY + 130;
    let active = sections[0];
    sections.forEach(s => { if (s.sec && s.sec.getBoundingClientRect().top + window.scrollY <= y) active = s; });
    tocLinks.forEach(l => l.classList.remove('fr-toc-active'));
    if (active) active.link.classList.add('fr-toc-active');
  }
  window.addEventListener('scroll', updateTOC, { passive: true });
  updateTOC();

  // ── FAQ accordion ──
  document.querySelectorAll('.fr-faq-q').forEach(q => {
    q.addEventListener('click', function () {
      const item = this.closest('.fr-faq-item');
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.fr-faq-item').forEach(i => i.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
    });
  });

});
</script>
<%- include('../../partials/footer') %>
