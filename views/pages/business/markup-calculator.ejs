<script>
var currentMode = 'price'; // 'price' | 'markup' | 'cost'

function fmtC(val) {
  var sign = val < 0 ? '−$' : '$';
  return sign + Math.abs(val).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function fmtP(val) {
  return val.toFixed(1) + '%';
}

function setMode(mode) {
  currentMode = mode;
  document.getElementById('tab-find-price').className = (mode === 'price' ? 'mode-tab active' : 'mode-tab');
  document.getElementById('tab-find-markup').className = (mode === 'markup' ? 'mode-tab active' : 'mode-tab');
  document.getElementById('tab-find-cost').className = (mode === 'cost' ? 'mode-tab active' : 'mode-tab');

  var groupCost   = document.getElementById('group-cost');
  var groupMarkup = document.getElementById('group-markup');
  var groupPrice  = document.getElementById('group-price');

  if (mode === 'price') {
    groupCost.style.display   = 'block';
    groupMarkup.style.display = 'block';
    groupPrice.style.display  = 'none';
  } else if (mode === 'markup') {
    groupCost.style.display   = 'block';
    groupMarkup.style.display = 'none';
    groupPrice.style.display  = 'block';
  } else if (mode === 'cost') {
    groupCost.style.display   = 'none';
    groupMarkup.style.display = 'block';
    groupPrice.style.display  = 'block';
  }

  calcMarkup();
}

function applyPreset(markupPct, note) {
  if (currentMode === 'markup') {
    setMode('price');
  }
  document.getElementById('mk-pct').value = markupPct;
  calcMarkup();
}

function calcMarkup() {
  var cost   = parseFloat(document.getElementById('mk-cost').value) || 0;
  var markup = parseFloat(document.getElementById('mk-pct').value) || 0;
  var price  = parseFloat(document.getElementById('mk-price').value) || 0;

  var profit = 0;
  var margin = 0;

  if (currentMode === 'price') {
    profit = cost * (markup / 100);
    price  = cost + profit;
    margin = price > 0 ? (profit / price) * 100 : 0;
  } else if (currentMode === 'markup') {
    profit = price - cost;
    markup = cost > 0 ? (profit / cost) * 100 : 0;
    margin = price > 0 ? (profit / price) * 100 : 0;
  } else if (currentMode === 'cost') {
    cost   = markup > -100 ? (price / (1 + (markup / 100))) : 0;
    profit = price - cost;
    margin = price > 0 ? (profit / price) * 100 : 0;
  }

  var multiplier = cost > 0 ? (price / cost) : 0;

  // Hero Card Update
  var heroLabel = document.getElementById('res-hero-label');
  var heroVal   = document.getElementById('res-hero-val');
  var heroSub   = document.getElementById('res-hero-sub');

  if (currentMode === 'price') {
    heroLabel.textContent = 'Recommended Retail Selling Price';
    heroVal.textContent   = fmtC(price);
    heroSub.textContent   = 'Markup: ' + fmtP(markup) + ' • Profit Margin: ' + fmtP(margin);
  } else if (currentMode === 'markup') {
    heroLabel.textContent = 'Calculated Retail Markup';
    heroVal.textContent   = fmtP(markup);
    heroSub.textContent   = 'Retail Price: ' + fmtC(price) + ' • Profit Margin: ' + fmtP(margin);
  } else if (currentMode === 'cost') {
    heroLabel.textContent = 'Maximum Wholesale Cost (COGS)';
    heroVal.textContent   = fmtC(cost);
    heroSub.textContent   = 'Yields ' + fmtP(markup) + ' markup at ' + fmtC(price) + ' shelf price';
  }

  // 4 Cards Update
  document.getElementById('res-sell-card').textContent   = fmtC(price);
  document.getElementById('res-cost-card').textContent   = fmtC(cost);
  document.getElementById('res-profit-card').textContent = fmtC(profit);
  document.getElementById('res-margin-card').textContent = fmtP(margin);

  // Showdown Card
  document.getElementById('showdown-markup').textContent = fmtP(markup);
  document.getElementById('showdown-margin').textContent = fmtP(margin);

  // Line-Item Table
  var setTxt = function(id, txt) {
    var el = document.getElementById(id);
    if (el) el.textContent = txt;
  };

  setTxt('mkl-cost', fmtC(cost));
  setTxt('mkl-profit', (profit >= 0 ? '+' : '−') + fmtC(Math.abs(profit)));
  setTxt('mkl-price', fmtC(price));
  setTxt('mkl-markup', fmtP(markup));
  setTxt('mkl-margin', fmtP(margin));
  setTxt('mkl-mult', multiplier.toFixed(2) + '× Cost');
}

function resetDefaults() {
  document.getElementById('mk-cost').value  = '50.00';
  document.getElementById('mk-pct').value   = '50.00';
  document.getElementById('mk-price').value = '75.00';
  setMode('price');
}

// Live real-time calculation listeners on keystroke/change
document.querySelectorAll('#mk-cost, #mk-pct, #mk-price').forEach(function(input) {
  input.addEventListener('input', calcMarkup);
  input.addEventListener('change', calcMarkup);
});

// Run initial calculation immediately on load
calcMarkup();

// FAQ Accordion
document.querySelectorAll('.faq-question').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var box = this.closest('.faq-box');
    var isOpen = box.classList.contains('open');
    document.querySelectorAll('.faq-box').forEach(function(b) { b.classList.remove('open'); });
    if (!isOpen) {
      box.classList.add('open');
    }
  });
});
</script>
