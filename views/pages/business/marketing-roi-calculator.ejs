<script>
function fmtC(val) {
  var sign = val < 0 ? '−$' : '$';
  return sign + Math.abs(Math.round(val)).toLocaleString('en-US');
}

function fmtP(val) {
  var sign = val < 0 ? '−' : '+';
  return sign + Math.abs(val).toFixed(1) + '%';
}

function calcMK() {
  var spend  = parseFloat(document.getElementById('mk-spend').value) || 0;
  var rev    = parseFloat(document.getElementById('mk-rev').value) || 0;
  var margin = parseFloat(document.getElementById('mk-margin').value) || 100;
  var cust   = parseInt(document.getElementById('mk-cust').value, 10) || 0;
  var ltv    = parseFloat(document.getElementById('mk-ltv').value) || 0;
  var months = parseInt(document.getElementById('mk-month').value, 10) || 1;

  // Margin-adjusted calculations
  var grossProfit = rev * (margin / 100);
  var netProfit   = grossProfit - spend;
  var topLineNet  = rev - spend;

  // Ratios
  var roiTopLine = spend > 0 ? (topLineNet / spend) * 100 : 0;
  var roiMargin  = spend > 0 ? (netProfit / spend) * 100 : 0;
  var roas       = spend > 0 ? (rev / spend) : 0;
  var cac        = cust > 0 ? (spend / cust) : 0;
  var ltvCac     = cac > 0 ? (ltv / cac) : 0;
  var totalLtv   = cust * ltv;

  // Update Hero Metric
  var roiEl = document.getElementById('mk-roi');
  roiEl.textContent = fmtP(roiTopLine);
  if (roiTopLine < 0) {
    roiEl.style.color = '#f87171';
  } else {
    roiEl.style.color = '#ffffff';
  }

  // Update Status Badge
  var badgeEl = document.getElementById('mk-roi-badge');
  if (roiTopLine >= 400) {
    badgeEl.textContent = 'Exceptional Return • High Scaling Potential';
  } else if (roiTopLine >= 200) {
    badgeEl.textContent = 'Strong Profitability • Healthy Scalability';
  } else if (roiTopLine >= 100) {
    badgeEl.textContent = 'Profitable Campaign • Monitor Unit Economics';
  } else if (roiTopLine > 0) {
    badgeEl.textContent = 'Marginal Return • Optimize Conversion Funnel';
  } else if (roiTopLine === 0) {
    badgeEl.textContent = 'Break-Even Performance';
  } else {
    badgeEl.textContent = 'Negative ROI • Review Targeting & Costs';
  }

  // Update 4 Cards
  var roasEl = document.getElementById('mk-roas');
  if (roasEl) roasEl.textContent = roas.toFixed(2) + '×';

  var roasSubEl = document.getElementById('mk-roas-sub');
  if (roasSubEl) roasSubEl.textContent = '$' + roas.toFixed(2) + ' revenue per $1 spent';

  var cpaEl = document.getElementById('mk-cpa');
  if (cpaEl) cpaEl.textContent = cust > 0 ? fmtC(cac) : '—';

  var gpEl = document.getElementById('mk-gp');
  if (gpEl) gpEl.textContent = fmtC(grossProfit);

  var gpDescEl = document.getElementById('mk-gp-desc');
  if (gpDescEl) gpDescEl.textContent = 'Revenue × ' + margin + '% Margin';

  var netEl = document.getElementById('mk-net');
  if (netEl) {
    netEl.textContent = fmtC(netProfit);
    if (netProfit < 0) {
      netEl.className = 'result-number text-danger';
    } else {
      netEl.className = 'result-number text-success';
    }
  }

  // Update Financial Breakdown Table
  var setTxt = function(id, txt) {
    var el = document.getElementById(id);
    if (el) el.textContent = txt;
  };

  setTxt('mkl-spend', fmtC(spend));
  setTxt('mkl-rev', fmtC(rev));
  setTxt('mkl-gp', fmtC(grossProfit));
  setTxt('mkl-topline-net', fmtC(topLineNet));
  setTxt('mkl-net-table', fmtC(netProfit));
  setTxt('mkl-roi', fmtP(roiTopLine));
  setTxt('mkl-margin-roi', fmtP(roiMargin));
  setTxt('mkl-roas-table', roas.toFixed(2) + '×');
  setTxt('mkl-cac-table', cust > 0 ? fmtC(cac) : '—');
  setTxt('mkl-ltv-table', ltv > 0 ? fmtC(ltv) : '—');

  var ltvCacTxt = '—';
  if (cust > 0 && ltv > 0 && cac > 0) {
    var status = ltvCac >= 3 ? ' (Scalable)' : (ltvCac >= 1.5 ? ' (Moderate)' : ' (At Risk)');
    ltvCacTxt = ltvCac.toFixed(2) + '×' + status;
  }
  setTxt('mkl-ltv-cac-table', ltvCacTxt);
  setTxt('mk-ltv-roi', fmtC(totalLtv));
}

// Preset Handler
var typeSelect = document.getElementById('mk-type');
if (typeSelect) {
  typeSelect.addEventListener('change', function() {
    var opt = this.options[this.selectedIndex];
    if (opt && opt.value !== 'custom') {
      if (opt.dataset.spend) document.getElementById('mk-spend').value = opt.dataset.spend;
      if (opt.dataset.rev) document.getElementById('mk-rev').value = opt.dataset.rev;
      if (opt.dataset.margin) document.getElementById('mk-margin').value = opt.dataset.margin;
      if (opt.dataset.cust) document.getElementById('mk-cust').value = opt.dataset.cust;
      if (opt.dataset.ltv) document.getElementById('mk-ltv').value = opt.dataset.ltv;
      if (opt.dataset.months) document.getElementById('mk-month').value = opt.dataset.months;
    }
    calcMK();
  });
}

function resetDefaults() {
  document.getElementById('mk-type').value = 'paid';
  document.getElementById('mk-spend').value = 5000;
  document.getElementById('mk-rev').value = 22000;
  document.getElementById('mk-margin').value = 60;
  document.getElementById('mk-month').value = 3;
  document.getElementById('mk-cust').value = 45;
  document.getElementById('mk-ltv').value = 800;
  calcMK();
}

// Bind live events across all inputs
document.querySelectorAll('#mk-spend, #mk-rev, #mk-margin, #mk-month, #mk-cust, #mk-ltv').forEach(function(input) {
  input.addEventListener('input', calcMK);
  input.addEventListener('change', calcMK);
});

// Run calculation immediately on load
calcMK();

// FAQ Accordion
document.querySelectorAll('.faq-question').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var box = this.closest('.faq-box');
    var isOpen = box.classList.contains('open');
    document.querySelectorAll('.faq-box').forEach(function(b) { b.classList.remove('open'); });
    if (!isOpen) {
      box.classList.add('open');
    }
  });
});
</script>
