<%- include('../../partials/header') %>
<main id="main-content" class="container">
  <div class="calculator-header">
    <h1>Illinois Closing Cost Calculator (<%= currentYear %>)</h1>
    <p class="lead-description">
      Accurately calculate buyer and seller settlement costs across Illinois. Includes <strong>City of Chicago transfer stamps ($5.25/$500)</strong>, suburban municipality taxes, Cook County tax prorations in arrears, and title insurance rates.
    </p>
  </div>

  <div class="calculator-layout">
    <!-- LEFT INPUT PANEL -->
    <div class="calculator-panel">
      <h2 class="panel-title">Illinois Property &amp; Transaction Details</h2>

      <div class="form-group">
        <label for="ilPrice">Property Purchase Price ($):</label>
        <input type="number" id="ilPrice" class="form-control" value="425000" min="20000" step="5000">
        <span class="field-hint">Chicago &amp; Illinois median residential home price.</span>
      </div>

      <div class="form-group">
        <label for="ilRole">Your Transaction Role:</label>
        <select id="ilRole" class="form-control">
          <option value="buyer" selected>Buyer (Purchasing Home)</option>
          <option value="seller">Seller (Selling Home)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="ilLocation">Municipality / Location:</label>
        <select id="ilLocation" class="form-control">
          <option value="chicago" selected>City of Chicago (Cook County) &ndash; $5.25 / $500 Tax</option>
          <option value="cook_suburb">Suburban Cook County (State &amp; County Only)</option>
          <option value="evanston">City of Evanston ($5.00 / $1,000)</option>
          <option value="naperville">City of Naperville ($1.50 / $1,000)</option>
          <option value="other_il">All Other Illinois Counties (State + County)</option>
        </select>
      </div>

      <div class="form-group" id="groupBuyerLoan">
        <label for="ilDownPct">Buyer Down Payment (%):</label>
        <select id="ilDownPct" class="form-control">
          <option value="5">5% Down Payment</option>
          <option value="10">10% Down Payment</option>
          <option value="20" selected>20% Down Payment (Standard)</option>
          <option value="0">Cash Purchase (0% Financing)</option>
        </select>
      </div>

      <div class="form-group" id="groupSellerComm" style="display:none;">
        <label for="ilAgentComm">Real Estate Broker Commission (%):</label>
        <input type="number" id="ilAgentComm" class="form-control" value="5.0" min="0" max="8.0" step="0.5">
      </div>

      <div class="form-group">
        <label for="ilAttorney">Real Estate Attorney Fee ($):</label>
        <input type="number" id="ilAttorney" class="form-control" value="850" min="0" step="50">
        <span class="field-hint">Customary representation in Illinois ($600&ndash;$1,200).</span>
      </div>

      <div class="form-group">
        <label for="ilAnnualTax">Annual Property Taxes ($):</label>
        <input type="number" id="ilAnnualTax" class="form-control" value="8500" min="0" step="250">
        <span class="field-hint">Average Illinois effective property tax rate (~2.0%&ndash;2.3%).</span>
      </div>
    </div>

    <!-- RIGHT RESULTS PANEL -->
    <div class="calculator-panel results-panel">
      <h2 class="panel-title">Your Estimated Illinois Settlement Summary</h2>

      <div class="highlight-metric">
        <div class="metric-label" id="resIlRoleLabel">Total Buyer Closing Costs</div>
        <div class="metric-value primary-value" id="resIlTotalCost">$0</div>
        <div class="metric-sub" id="resIlBottomLine">Estimated Cash Needed at Settlement: $0</div>
      </div>

      <div class="results-grid">
        <div class="result-card">
          <div class="result-title">Total Transfer Taxes</div>
          <div class="result-number" id="resIlTransferTaxes">$0</div>
          <div class="result-desc" id="resIlTransferDesc">State, County &amp; City Stamps</div>
        </div>

        <div class="result-card">
          <div class="result-title">Title Insurance &amp; Closing</div>
          <div class="result-number" id="resIlTitleFees">$0</div>
          <div class="result-desc" id="resIlTitleDesc">Title Policy &amp; Settlement Closing Fee</div>
        </div>

        <div class="result-card">
          <div class="result-title">Attorney &amp; Recording</div>
          <div class="result-number" id="resIlLegalRecording">$0</div>
          <div class="result-desc">Attorney + County Deed/Mortgage Stamps</div>
        </div>

        <div class="result-card">
          <div class="result-title" id="resIlCard4Title">Lender &amp; Escrow Prepaids</div>
          <div class="result-number" id="resIlCard4Val">$0</div>
          <div class="result-desc" id="resIlCard4Desc">Taxes in Arrears &amp; Insurance Buffer</div>
        </div>
      </div>

      <div class="summary-breakdown">
        <h3>Itemized Illinois Closing Breakdown</h3>
        <table class="summary-table">
          <tr><td>Purchase Price:</td><td id="resSumPrice">$0</td></tr>
          <tr id="rowDownPayment"><td>Buyer Down Payment:</td><td id="resSumDown">$0</td></tr>
          <tr id="rowCommission" style="display:none;"><td>Broker Commission (5%):</td><td id="resSumCommission">$0</td></tr>
          <tr><td>Illinois State Transfer Tax ($0.50/$500):</td><td id="resSumStateTax">$0</td></tr>
          <tr><td>County Transfer Tax ($0.25/$500):</td><td id="resSumCountyTax">$0</td></tr>
          <tr id="rowCityTax"><td>City / Municipal Transfer Tax:</td><td id="resSumCityTax">$0</td></tr>
          <tr><td>Title Insurance Policy:</td><td id="resSumTitle">$0</td></tr>
          <tr><td>Attorney Legal Fee:</td><td id="resSumAttorney">$0</td></tr>
          <tr id="rowEscrowPrepaids"><td>Escrow Prepaids (Tax &amp; Insurance):</td><td id="resSumEscrow">$0</td></tr>
          <tr class="highlight-row"><td><strong id="resSumFinalLabel">Total Estimated Cash to Close:</strong></td><td><strong id="resSumFinalVal">$0</strong></td></tr>
        </table>
      </div>
    </div>
  </div>

  <!-- CONTENT & GUIDES -->
  <div class="calculator-content-body">
    <div class="quick-answer-card">
      <h2>How Illinois Real Estate Closing Costs Work in <%= currentYear %></h2>
      <p>
        In Illinois, closing costs differ substantially between <strong>buyers</strong> (typically <strong>2% to 4%</strong>) and <strong>sellers</strong> (typically <strong>6% to 8.5%</strong>). Furthermore, properties within the <strong>City of Chicago</strong> are subject to one of the nation's most notable municipal transfer taxes—totaling <strong>$5.25 per $500 of value (1.05%)</strong> split between buyer ($3.75) and seller ($1.50).
      </p>
    </div>

    <h2>Illinois Real Estate Transfer Tax Rates: State, County &amp; Municipal Breakdown</h2>
    <p>Transfer tax in Illinois is charged via revenue stamps purchased at settlement:</p>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Tax Level</th>
            <th>Rate per $500 of Value</th>
            <th>Effective Tax %</th>
            <th>Standard Payer</th>
            <th>Cost on $425,000 Home</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Illinois State Transfer Tax</strong></td>
            <td>$0.50 per $500</td>
            <td>0.10%</td>
            <td>Seller</td>
            <td>$425.00</td>
          </tr>
          <tr>
            <td><strong>County Transfer Tax (e.g. Cook)</strong></td>
            <td>$0.25 per $500</td>
            <td>0.05%</td>
            <td>Seller</td>
            <td>$212.50</td>
          </tr>
          <tr>
            <td><strong>City of Chicago &ndash; Buyer Portion (CTA)</strong></td>
            <td>$3.75 per $500</td>
            <td>0.75%</td>
            <td><strong>Buyer</strong></td>
            <td><strong>$3,187.50</strong></td>
          </tr>
          <tr>
            <td><strong>City of Chicago &ndash; Seller Portion</strong></td>
            <td>$1.50 per $500</td>
            <td>0.30%</td>
            <td><strong>Seller</strong></td>
            <td><strong>$1,275.00</strong></td>
          </tr>
          <tr>
            <td><strong>Combined Chicago + State + County</strong></td>
            <td><strong>$6.00 per $500</strong></td>
            <td><strong>1.20%</strong></td>
            <td>Buyer + Seller Split</td>
            <td><strong>$5,100.00</strong></td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>Cook County Property Tax Prorations in Arrears (The 105%–110% Rule)</h2>
    <p>
      Illinois property taxes are billed and paid <strong>one year in arrears</strong> (e.g., taxes for 2025 are paid in two installments during 2026). Because the exact tax bill for the current year of sale has not yet been determined by the Cook County Assessor, settlement standard contracts (Multi-Board 7.0) require the seller to give the buyer a credit at closing equal to <strong>105% to 110% of the prior year's tax bill</strong> prorated to the exact day of closing.
    </p>

    <h2>Itemized Buyer vs. Seller Closing Cost Responsibilities in Illinois</h2>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Closing Cost Expense</th>
            <th>Buyer Pays</th>
            <th>Seller Pays</th>
            <th>Typical Amount / Benchmark</th>
          </tr>
        </thead>
        <tbody>
          <tr><td><strong>Owner Title Insurance Policy</strong></td><td>No</td><td><strong>Yes</strong></td><td>~$2,100 &ndash; $2,800 (Protects Buyer's Title)</td></tr>
          <tr><td><strong>Lender Title Insurance Policy</strong></td><td><strong>Yes</strong></td><td>No</td><td>~$500 &ndash; $750 (Simultaneous Issue Rate)</td></tr>
          <tr><td><strong>City of Chicago Transfer Stamps</strong></td><td><strong>Yes ($3.75/$500)</strong></td><td><strong>Yes ($1.50/$500)</strong></td><td>$3,188 Buyer / $1,275 Seller on $425k</td></tr>
          <tr><td><strong>State &amp; County Transfer Stamps</strong></td><td>No</td><td><strong>Yes ($0.75/$500)</strong></td><td>$637.50 total on $425k</td></tr>
          <tr><td><strong>Real Estate Broker Commission</strong></td><td>No</td><td><strong>Yes</strong></td><td>5.0% to 6.0% of total sales price</td></tr>
          <tr><td><strong>Real Estate Attorney Fee</strong></td><td><strong>Yes</strong></td><td><strong>Yes</strong></td><td>$750 &ndash; $1,200 each for independent counsel</td></tr>
          <tr><td><strong>County Recording &amp; Closing Fee</strong></td><td><strong>Yes (~$350)</strong></td><td><strong>Yes (~$450)</strong></td><td>Deed and mortgage recording fees</td></tr>
          <tr><td><strong>Property Tax Proration Credit</strong></td><td>Receives Credit</td><td><strong>Pays Credit</strong></td><td>105% &ndash; 110% of daily tax proration</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Frequently Asked Questions (FAQ)</h2>
    <div class="faq-item">
      <h4>How much are closing costs in Illinois?</h4>
      <p>In Illinois, buyer closing costs typically range from 2.0% to 4.0% of the purchase price when financing. For sellers, closing costs range from 6.0% to 8.5%, driven by real estate broker commissions (5% to 6%), the owner title policy, and state/county/city transfer taxes.</p>
    </div>
    <div class="faq-item">
      <h4>What is the City of Chicago Real Property Transfer Tax rate?</h4>
      <p>The City of Chicago imposes a total transfer tax of $5.25 per $500 of value (1.05%). By municipal code, the buyer pays $3.75 per $500 (0.75%, consisting of $1.50 City + $2.25 CTA transit portion), while the seller pays $1.50 per $500 (0.30%).</p>
    </div>
    <div class="faq-item">
      <h4>What are the Illinois State and County real estate transfer taxes?</h4>
      <p>Statewide, Illinois levies a State Transfer Tax of $0.50 per $500 of value (0.10%) and an additional County Transfer Tax of $0.25 per $500 of value (0.05%). Both of these taxes are customarily paid entirely by the seller at settlement.</p>
    </div>
    <div class="faq-item">
      <h4>Who pays for title insurance in Illinois?</h4>
      <p>Under standard Illinois residential purchase contracts (Multi-Board 7.0 / Chicago Association of REALTORS contract), the seller pays for the Owner Title Insurance Policy to prove clear title, while the buyer pays for the Lender Title Policy if obtaining a mortgage.</p>
    </div>
    <div class="faq-item">
      <h4>How do property tax prorations work in Cook County, Illinois?</h4>
      <p>In Illinois, property taxes are paid in arrears (one year behind). Because the exact tax bill for the current year is unknown at closing, the seller gives the buyer a tax credit at closing—customarily calculated at 105% to 110% of the most recently issued annual tax bill.</p>
    </div>
    <div class="faq-item">
      <h4>Is a real estate attorney required for closing in Illinois?</h4>
      <p>While not legally mandated by state statute, hiring a real estate attorney is customary practice throughout Illinois, particularly in the Chicago metro area. Attorney fees typically range from $600 to $1,200 for a standard residential closing.</p>
    </div>
    <div class="faq-item">
      <h4>What other Illinois municipalities have local real estate transfer taxes?</h4>
      <p>Beyond Chicago, several home-rule municipalities impose local transfer taxes, including Evanston ($5.00/$1k up to $1.5M, sliding up to $9.00/$1k), Naperville ($1.50/$1k), Aurora ($3.00/$1k), Highland Park ($5.00/$1k), and Oak Park ($8.00/$1k).</p>
    </div>
    <div class="faq-item">
      <h4>How much are closing costs on a $400,000 home in Chicago?</h4>
      <p>On a $400,000 Chicago home with 20% down: A buyer pays ~$12,800 (including $3,000 Chicago CTA transfer tax, $1,600 lender fees, $800 attorney, and $6,500 tax/ins escrow). A seller pays ~$28,600 (including $20,000 commission, $2,400 state/county/city transfer tax, $2,200 title policy, and attorney fee).</p>
    </div>

    <h2>Explore Related State Closing Cost Calculators</h2>
    <ul>
      <li><a href="/real-estate/closing-cost-calculator-ohio">Ohio Closing Cost Calculator</a> &mdash; Calculate county conveyance fees and title rates in the Midwest.</li>
      <li><a href="/real-estate/closing-cost-calculator-new-york">New York Closing Cost Calculator</a> &mdash; Estimate NYC transfer taxes, Mansion Tax, and mortgage recording fees.</li>
      <li><a href="/real-estate/closing-cost-calculator-pennsylvania">Pennsylvania Closing Cost Calculator</a> &mdash; Calculate PA 2% transfer tax and Philadelphia 4.278% rates.</li>
      <li><a href="/real-estate/seller-closing-cost-calculator">Seller Closing Cost Calculator</a> &mdash; Estimate net seller proceeds after broker fees and deed taxes.</li>
    </ul>
  </div>
</main>

<script>
function calculateIlCosts() {
  var price = parseFloat(document.getElementById('ilPrice').value) || 0;
  var role = document.getElementById('ilRole').value;
  var location = document.getElementById('ilLocation').value;
  var downPct = (parseFloat(document.getElementById('ilDownPct').value) || 20) / 100;
  var commPct = (parseFloat(document.getElementById('ilAgentComm').value) || 5.0) / 100;
  var attorney = parseFloat(document.getElementById('ilAttorney').value) || 850;
  var annualTax = parseFloat(document.getElementById('ilAnnualTax').value) || 8500;

  var isBuyer = (role === 'buyer');
  document.getElementById('groupBuyerLoan').style.display = isBuyer ? 'block' : 'none';
  document.getElementById('groupSellerComm').style.display = isBuyer ? 'none' : 'block';
  document.getElementById('rowDownPayment').style.display = isBuyer ? 'table-row' : 'none';
  document.getElementById('rowCommission').style.display = isBuyer ? 'none' : 'table-row';
  document.getElementById('rowEscrowPrepaids').style.display = isBuyer ? 'table-row' : 'none';

  var downPayment = isBuyer ? (price * downPct) : 0;
  var loanAmount = isBuyer ? Math.max(0, price - downPayment) : 0;

  // 1. Transfer Taxes
  var stateTax = (price / 500) * 0.50; // $0.50 per $500 (Seller)
  var countyTax = (price / 500) * 0.25; // $0.25 per $500 (Seller)
  var cityTaxBuyer = 0;
  var cityTaxSeller = 0;

  if (location === 'chicago') {
    cityTaxBuyer = (price / 500) * 3.75; // $3.75 / $500 CTA + City
    cityTaxSeller = (price / 500) * 1.50; // $1.50 / $500 City
  } else if (location === 'evanston') {
    cityTaxSeller = (price / 1000) * 5.00;
  } else if (location === 'naperville') {
    cityTaxBuyer = (price / 1000) * 1.50;
  }

  // 2. Title Insurance
  var ownerTitle = (price * 0.0055) + 300; // Seller paid in IL
  var lenderTitle = loanAmount > 0 ? 550 : 0; // Buyer paid in IL
  var closingEscrowFee = 850; // Title settlement fee

  // 3. Broker Commission (Seller)
  var commission = isBuyer ? 0 : (price * commPct);

  // 4. Lender Origination & Escrow (Buyer)
  var lenderFees = loanAmount > 0 ? 1650 : 0;
  var escrowPrepaids = isBuyer && (loanAmount > 0) ? (annualTax / 12 * 4) + 1400 : 0;

  // 5. Recording & Miscellaneous
  var recording = isBuyer ? 350 : 150;

  var totalCost = 0;
  var bottomLine = 0;

  if (isBuyer) {
    totalCost = cityTaxBuyer + lenderTitle + (closingEscrowFee / 2) + attorney + recording + lenderFees + escrowPrepaids;
    bottomLine = downPayment + totalCost;
    
    document.getElementById('resIlRoleLabel').textContent = 'Total Buyer Closing Costs';
    document.getElementById('resIlBottomLine').textContent = 'Estimated Cash Needed at Settlement: $' + Math.round(bottomLine).toLocaleString();
    document.getElementById('resIlTransferTaxes').textContent = '$' + Math.round(cityTaxBuyer).toLocaleString();
    document.getElementById('resIlTransferDesc').textContent = 'Chicago CTA / Municipal Tax';
    document.getElementById('resIlTitleFees').textContent = '$' + Math.round(lenderTitle + (closingEscrowFee / 2)).toLocaleString();
    document.getElementById('resIlTitleDesc').textContent = 'Lender Title Policy + Settlement Fee';
    document.getElementById('resIlCard4Title').textContent = 'Lender & Escrow Prepaids';
    document.getElementById('resIlCard4Val').textContent = '$' + Math.round(lenderFees + escrowPrepaids).toLocaleString();
    document.getElementById('resIlCard4Desc').textContent = 'Lender Origination & Escrow Reserves';
    document.getElementById('resSumFinalLabel').textContent = 'Total Estimated Cash to Close:';
    document.getElementById('resSumFinalVal').textContent = '$' + Math.round(bottomLine).toLocaleString();
  } else {
    totalCost = commission + stateTax + countyTax + cityTaxSeller + ownerTitle + (closingEscrowFee / 2) + attorney + recording;
    var netProceeds = price - totalCost;
    
    document.getElementById('resIlRoleLabel').textContent = 'Total Seller Closing Costs';
    document.getElementById('resIlBottomLine').textContent = 'Estimated Net Sale Proceeds: $' + Math.round(netProceeds).toLocaleString();
    document.getElementById('resIlTransferTaxes').textContent = '$' + Math.round(stateTax + countyTax + cityTaxSeller).toLocaleString();
    document.getElementById('resIlTransferDesc').textContent = 'State, County & City Stamps';
    document.getElementById('resIlTitleFees').textContent = '$' + Math.round(ownerTitle + (closingEscrowFee / 2)).toLocaleString();
    document.getElementById('resIlTitleDesc').textContent = 'Owner Title Policy (Multi-Board 7.0)';
    document.getElementById('resIlCard4Title').textContent = 'Broker Commission';
    document.getElementById('resIlCard4Val').textContent = '$' + Math.round(commission).toLocaleString();
    document.getElementById('resIlCard4Desc').textContent = (commPct * 100).toFixed(1) + '% Real Estate Commission';
    document.getElementById('resSumFinalLabel').textContent = 'Estimated Net Seller Proceeds:';
    document.getElementById('resSumFinalVal').textContent = '$' + Math.round(netProceeds).toLocaleString();
  }

  document.getElementById('resIlTotalCost').textContent = '$' + Math.round(totalCost).toLocaleString();
  document.getElementById('resIlLegalRecording').textContent = '$' + Math.round(attorney + recording).toLocaleString();

  document.getElementById('resSumPrice').textContent = '$' + Math.round(price).toLocaleString();
  document.getElementById('resSumDown').textContent = '$' + Math.round(downPayment).toLocaleString() + ' (' + (downPct * 100).toFixed(0) + '%)';
  document.getElementById('resSumCommission').textContent = '$' + Math.round(commission).toLocaleString();
  document.getElementById('resSumStateTax').textContent = '$' + Math.round(isBuyer ? 0 : stateTax).toLocaleString();
  document.getElementById('resSumCountyTax').textContent = '$' + Math.round(isBuyer ? 0 : countyTax).toLocaleString();
  document.getElementById('resSumCityTax').textContent = '$' + Math.round(isBuyer ? cityTaxBuyer : cityTaxSeller).toLocaleString();
  document.getElementById('resSumTitle').textContent = '$' + Math.round(isBuyer ? lenderTitle : ownerTitle).toLocaleString();
  document.getElementById('resSumAttorney').textContent = '$' + Math.round(attorney).toLocaleString();
  document.getElementById('resSumEscrow').textContent = '$' + Math.round(escrowPrepaids).toLocaleString();
}

document.querySelectorAll('#ilPrice, #ilRole, #ilLocation, #ilDownPct, #ilAgentComm, #ilAttorney, #ilAnnualTax').forEach(function(el) {
  el.addEventListener('input', calculateIlCosts);
  el.addEventListener('change', calculateIlCosts);
});

calculateIlCosts();
</script>
