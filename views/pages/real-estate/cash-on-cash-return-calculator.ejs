<script>
(function(){
  'use strict';
  const $ = id => document.getElementById(id);
  const fmtC = v => {
    const abs = Math.abs(Math.round(v));
    return (v < 0 ? '−' : '') + '$' + abs.toLocaleString('en-US');
  };
  const fmtP = v => (v < 0 ? '−' : '') + Math.abs(v).toFixed(2) + '%';

  // Monthly mortgage payment (P+I)
  function calcMortgagePayment(principal, annualRate, termYears) {
    if (annualRate === 0) return principal / (termYears * 12);
    const r = annualRate / 100 / 12;
    const n = termYears * 12;
    return principal * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
  }

  function calculate() {
    const price       = parseFloat($('c-price').value)       || 0;
    const downPct     = parseFloat($('c-down').value)        || 0;
    const closing     = parseFloat($('c-closing').value)     || 0;
    const repairs     = parseFloat($('c-repairs').value)     || 0;
    const intRate     = parseFloat($('c-rate').value)        || 0;
    const termYrs     = parseInt($('c-term').value)          || 30;
    const loanType    = $('c-loan-type').value;
    const monthlyRent = parseFloat($('c-rent').value)        || 0;
    const vacancyPct  = parseFloat($('c-vacancy').value)     || 0;
    const propTax     = parseFloat($('c-tax').value)         || 0;
    const insurance   = parseFloat($('c-insurance').value)   || 0;
    const maintenance = parseFloat($('c-maintenance').value) || 0;
    const mgmtPct     = parseFloat($('c-mgmt').value)        || 0;
    const hoa         = parseFloat($('c-hoa').value)         || 0;
    const other       = parseFloat($('c-other').value)       || 0;

    if (price <= 0) return;

    // Cash invested
    const downAmt       = price * (downPct / 100);
    const totalCash     = downAmt + closing + repairs;
    const loanAmt       = price - downAmt;

    // Debt service
    let annualDebtService = 0;
    let monthlyPI = 0;
    if (loanType !== 'cash' && loanAmt > 0) {
      monthlyPI        = calcMortgagePayment(loanAmt, intRate, termYrs);
      annualDebtService = monthlyPI * 12;
    }

    // Income
    const grossAnnualRent = monthlyRent * 12;
    const vacancyLoss     = grossAnnualRent * (vacancyPct / 100);
    const effectiveRent   = grossAnnualRent - vacancyLoss;

    // Expenses
    const mgmtFee      = effectiveRent * (mgmtPct / 100);
    const totalExpenses = propTax + insurance + maintenance + mgmtFee + hoa + other;

    // NOI & CoC
    const noi      = effectiveRent - totalExpenses;
    const cashFlow = noi - annualDebtService;
    const coc      = totalCash > 0 ? (cashFlow / totalCash) * 100 : 0;
    const capRate  = price > 0 ? (noi / price) * 100 : 0;
    const monthlyCF = cashFlow / 12;

    // Update results
    $('res-coc').textContent         = fmtP(coc);
    $('res-cash-invested').textContent = fmtC(totalCash);
    $('res-annual-cf').textContent   = fmtC(cashFlow);
    $('res-monthly-cf').textContent  = fmtC(monthlyCF);
    $('res-cap-rate').textContent    = fmtP(capRate);

    // CoC color
    const cocEl = $('res-coc');
    cocEl.style.color = coc >= 8 ? '#22c55e' : coc >= 4 ? '#eab308' : coc >= 0 ? '#f97316' : '#dc2626';

    // Breakdown
    $('bk-price').textContent       = fmtC(price);
    $('bk-down').textContent        = fmtC(downAmt) + ' (' + downPct + '%)';
    $('bk-closing').textContent     = fmtC(closing);
    $('bk-repairs').textContent     = fmtC(repairs);
    $('bk-total-cash').textContent  = fmtC(totalCash);
    $('bk-gross-rent').textContent  = fmtC(grossAnnualRent);
    $('bk-vacancy').textContent     = '−' + fmtC(vacancyLoss);
    $('bk-expenses').textContent    = '−' + fmtC(totalExpenses);
    $('bk-noi').textContent         = fmtC(noi);
    $('bk-debt').textContent        = annualDebtService > 0 ? '−' + fmtC(annualDebtService) : '$0 (all cash)';
    $('bk-monthly-pi').textContent  = monthlyPI > 0 ? fmtC(monthlyPI) + '/mo' : 'None';
    $('bk-cf').textContent          = fmtC(cashFlow);
    $('bk-coc').textContent         = fmtP(coc);

    // Cash flow color in breakdown
    const cfEl = $('bk-cf');
    cfEl.style.color = cashFlow >= 0 ? '#059669' : '#dc2626';
    $('bk-coc').style.color = coc >= 4 ? '#059669' : '#dc2626';

    // CoC stats color
    const cfStatEl = $('res-annual-cf');
    const moEl = $('res-monthly-cf');
    [cfStatEl, moEl].forEach(el => el.style.color = cashFlow >= 0 ? '#059669' : '#dc2626');

    // Gauge: map CoC from −10 to 20% → 0–100%
    const gaugeMin = -10, gaugeMax = 20;
    const gaugePos = Math.min(100, Math.max(0, ((coc - gaugeMin) / (gaugeMax - gaugeMin)) * 100));
    $('coc-needle').style.left = gaugePos + '%';

    // Verdict
    let verdict = '';
    if      (coc >= 12) verdict = '🌟 Outstanding return — top performer';
    else if (coc >= 8)  verdict = '🟢 Excellent — strong cash flow investment';
    else if (coc >= 6)  verdict = '🟢 Good return — solid cash flow deal';
    else if (coc >= 4)  verdict = '🟡 Decent — marginal positive cash flow';
    else if (coc >= 0)  verdict = '🟠 Very low CoC — appreciation dependent';
    else                verdict = '🔴 Negative cash flow — alligator property';
    $('coc-gauge-verdict').textContent = verdict;
    $('coc-gauge-verdict').style.color = coc >= 6 ? '#059669' : coc >= 0 ? '#d97706' : '#dc2626';

    $('coc-res-sub').textContent =
      fmtP(coc) + ' CoC · $' + Math.round(Math.abs(monthlyCF)).toLocaleString() +
      '/mo cash flow · ' + fmtP(capRate) + ' cap rate';
  }

  // Wire all inputs
  document.querySelectorAll('.coc-form-col input, .coc-form-col select').forEach(el => {
    el.addEventListener('input',  calculate);
    el.addEventListener('change', calculate);
  });
  $('coc-calc-btn').addEventListener('click', calculate);
  calculate();

  // TOC scroll spy
  const tocLinks = document.querySelectorAll('.coc-toc-list a');
  const sections = [];
  tocLinks.forEach(link => {
    const id = link.getAttribute('href').replace('#','');
    const sec = document.getElementById(id);
    if (sec) sections.push({ link, sec });
  });
  function updateTOC() {
    const y = window.scrollY + 130;
    let active = sections[0];
    sections.forEach(s => { if (s.sec && s.sec.getBoundingClientRect().top + window.scrollY <= y) active = s; });
    tocLinks.forEach(l => l.classList.remove('coc-active'));
    if (active) active.link.classList.add('coc-active');
  }
  window.addEventListener('scroll', updateTOC, { passive: true });
  updateTOC();

  // FAQ accordion
  document.querySelectorAll('.coc-faq-q').forEach(q => {
    q.addEventListener('click', function () {
      const item    = this.closest('.coc-faq-item');
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.coc-faq-item').forEach(i => i.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
    });
  });

  // Track calculator usage for analytics (optional)
  let calcCount = 0;
  $('coc-calc-btn').addEventListener('click', function() {
    calcCount++;
    if (typeof gtag !== 'undefined') {
      gtag('event', 'calculate_coc', {
        'event_category': 'calculator',
        'event_label': 'cash_on_cash_return',
        'value': calcCount
      });
    }
  });
})();
</script>
