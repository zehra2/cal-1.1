<style>
/* ═══════════════════════════════════════════════════════════════════════════════
   CRITICAL CSS (Above-the-fold only) — Inline for speed, rest in external file
   ═══════════════════════════════════════════════════════════════════════════════ */
body{background:#f5f7fa;margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;}
.coc-wrap{max-width:1320px;margin:0 auto;padding:2rem 1.5rem 4rem;display:grid;grid-template-columns:220px 1fr 260px;gap:2rem;align-items:start;}
.coc-toc{position:sticky;top:6rem;background:#fff;border-radius:12px;border:1px solid #e8edf5;box-shadow:0 2px 12px rgba(0,0,0,.04);overflow:hidden;}
.coc-toc-head{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;padding:1rem 1.25rem;font-weight:700;font-size:.85rem;text-transform:uppercase;letter-spacing:.8px;}
.coc-toc-list{list-style:none;padding:.75rem 0;margin:0;}
.coc-toc-list li a{display:block;padding:.5rem 1.25rem;font-size:.84rem;color:#475569;text-decoration:none;border-left:3px solid transparent;transition:all .18s;line-height:1.4;}
.coc-toc-list li a:hover,.coc-toc-list li a.coc-active{color:#2563eb;background:#eff6ff;border-left-color:#2563eb;}
.coc-toc-div{height:1px;background:#f1f5f9;margin:.5rem 0;}
.coc-toc-rlbl{padding:.5rem 1.25rem;font-size:.78rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;}
.coc-toc-rlist{list-style:none;padding:0;margin:0 0 .75rem;}
.coc-toc-rlist li a{display:block;padding:.4rem 1.25rem;font-size:.82rem;color:#64748b;text-decoration:none;transition:color .15s;}
.coc-toc-rlist li a:hover{color:#2563eb;}
.coc-main{min-width:0;}
.coc-hero{margin-bottom:2rem;}
.coc-hero h1{font-size:2.1rem;color:#0f172a;margin:0 0 .6rem;line-height:1.25;}
.coc-desc{font-size:1.05rem;color:#64748b;line-height:1.65;margin:0 0 .75rem;border-left:4px solid #2563eb;padding-left:1rem;}
.coc-bc{font-size:.8rem;color:#94a3b8;margin-bottom:.75rem;}
.coc-bc a{color:#64748b;text-decoration:none;}
.coc-card{background:#fff;border-radius:14px;box-shadow:0 4px 24px rgba(0,0,0,.05);border:1px solid #eef2f7;margin-bottom:2.5rem;overflow:hidden;}
.coc-card-head{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;padding:1.25rem 1.75rem;display:flex;align-items:center;gap:.75rem;}
.coc-card-head h2{font-size:1.1rem;font-weight:700;margin:0;}
.coc-inner{display:grid;grid-template-columns:1fr 1fr;}
.coc-form-col{padding:2rem;border-right:1px solid #f0f4fa;}
.coc-res-col{padding:2rem;background:linear-gradient(160deg,#eff6ff 0%,#dbeafe 100%);}
.coc-sec-lbl{font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;margin:1.25rem 0 .75rem;padding-bottom:.35rem;border-bottom:1px solid #f1f5f9;}
.coc-sec-lbl:first-child{margin-top:0;}
.coc-row2{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
.coc-row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;}
.coc-field{margin-bottom:1rem;}
.coc-field label{display:block;font-size:.88rem;font-weight:600;color:#1e293b;margin-bottom:.4rem;}
.coc-field input,.coc-field select{width:100%;padding:11px 14px;border:1.5px solid #d1dae8;border-radius:8px;font-size:.95rem;color:#0f172a;outline:none;transition:border-color .2s,box-shadow .2s;box-sizing:border-box;background:#fff;}
.coc-field input:focus,.coc-field select:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1);}
.coc-field .hint{font-size:.74rem;color:#94a3b8;margin-top:.28rem;line-height:1.4;}
.coc-btn{width:100%;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;padding:14px;border:none;border-radius:9px;font-size:1rem;font-weight:700;cursor:pointer;margin-top:.75rem;transition:opacity .2s,transform .15s;}
.coc-btn:hover{opacity:.92;transform:translateY(-1px);}
.coc-res-head{font-size:1.1rem;font-weight:700;color:#0f172a;margin:0 0 .2rem;}
.coc-res-sub{font-size:.82rem;color:#64748b;margin:0 0 1rem;}
.coc-hero-result{background:linear-gradient(135deg,#2563eb,#1d4ed8);border-radius:12px;padding:1.5rem 1.25rem;text-align:center;box-shadow:0 6px 20px rgba(37,99,235,.25);margin-bottom:.85rem;}
.coc-hero-val{display:block;font-size:2.8rem;font-weight:800;color:#fff;line-height:1;margin-bottom:.25rem;}
.coc-hero-lbl{font-size:.88rem;color:rgba(255,255,255,.85);}
.coc-gauge-wrap{background:#fff;border:1px solid #bfdbfe;border-radius:10px;padding:.9rem 1rem;margin-bottom:.85rem;}
.coc-gauge-lbl{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#94a3b8;margin-bottom:.55rem;}
.coc-gauge-bar{height:10px;border-radius:5px;background:linear-gradient(90deg,#dc2626 0%,#f97316 15%,#eab308 35%,#84cc16 55%,#22c55e 75%,#059669 100%);position:relative;margin-bottom:.4rem;}
.coc-gauge-needle{position:absolute;top:-4px;width:3px;height:18px;background:#0f172a;border-radius:2px;transform:translateX(-50%);transition:left .4s ease;}
.coc-gauge-scale{display:flex;justify-content:space-between;font-size:.65rem;color:#94a3b8;}
.coc-stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-bottom:.85rem;}
.coc-stat{background:#fff;border:1.5px solid #bfdbfe;border-radius:10px;padding:.8rem .75rem;text-align:center;}
.coc-stat-val{display:block;font-size:1.1rem;font-weight:800;color:#2563eb;margin-bottom:.15rem;}
.coc-stat.neg .coc-stat-val{color:#dc2626;}
.coc-stat-lbl{font-size:.7rem;color:#64748b;font-weight:600;line-height:1.3;}
.coc-bk{background:#fff;border:1px solid #bfdbfe;border-radius:10px;padding:.9rem 1rem;margin-bottom:.75rem;}
.coc-bk-title{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#94a3b8;margin-bottom:.5rem;}
.coc-bk-row{display:flex;justify-content:space-between;padding:.3rem 0;border-bottom:1px solid #f0f9ff;font-size:.84rem;}
.coc-bk-row:last-child{border-bottom:none;}
.coc-bk-lbl{color:#64748b;}
.coc-bk-val{font-weight:700;color:#1e293b;}
.coc-bk-row.neg .coc-bk-val{color:#dc2626;}
.coc-bk-row.pos .coc-bk-val{color:#059669;}
.coc-bk-row.sub{padding-left:.75rem;font-size:.8rem;}
.coc-bk-row.divider{border-top:2px solid #bfdbfe;margin-top:.25rem;padding-top:.5rem;}
.coc-bk-row.divider .coc-bk-lbl{font-weight:700;color:#0f172a;}
.coc-bk-row.divider .coc-bk-val{color:#2563eb;font-size:.93rem;}
.coc-disc{font-size:.72rem;color:#94a3b8;margin-top:.5rem;line-height:1.4;}
.coc-section{background:#fff;border-radius:14px;border:1px solid #eef2f7;box-shadow:0 2px 12px rgba(0,0,0,.03);padding:2.25rem;margin-bottom:2rem;scroll-margin-top:6rem;}
.coc-section h2{font-size:1.6rem;color:#0f172a;margin:0 0 1.2rem;padding-bottom:.75rem;border-bottom:2px solid #eff6ff;}
.coc-section h3{font-size:1.15rem;color:#1e293b;margin:1.6rem 0 .65rem;}
.coc-section p{color:#475569;line-height:1.75;margin-bottom:1.2rem;font-size:1rem;}
.coc-section ul,.coc-section ol{color:#475569;line-height:1.75;padding-left:1.5rem;margin-bottom:1.2rem;}
.coc-section li{margin-bottom:.45rem;}
.coc-section strong{color:#1e293b;}
.coc-section a{color:#2563eb;font-weight:600;}
.coc-formula{background:#0f172a;color:#94a3b8;font-family:'Courier New',monospace;font-size:.95rem;padding:1.1rem 1.4rem;border-radius:8px;margin:1.2rem 0;line-height:2;}
.coc-formula code{display:block;}
.coc-formula code span{color:#93c5fd;}
.coc-table{width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e8edf5;margin-bottom:1.5rem;}
.coc-table th{background:#2563eb;color:#fff;padding:12px 15px;text-align:left;font-size:.86rem;font-weight:600;}
.coc-table td{padding:10px 15px;border-bottom:1px solid #f1f5f9;font-size:.89rem;color:#334155;}
.coc-table tr:last-child td{border-bottom:none;}
.coc-table tr:nth-child(even) td{background:#f8fafc;}
.coc-info{background:#eff6ff;border-left:4px solid #2563eb;border-radius:0 8px 8px 0;padding:1rem 1.25rem;margin:1.2rem 0;font-size:.94rem;color:#1e3a8a;line-height:1.6;}
.coc-warn{background:#fffbeb;border-left:4px solid #d97706;border-radius:0 8px 8px 0;padding:1rem 1.25rem;margin:1.2rem 0;font-size:.94rem;color:#92400e;line-height:1.6;}
.coc-faq-item{border-bottom:1px solid #f0f4fa;padding-bottom:1.2rem;margin-bottom:1.2rem;}
.coc-faq-item:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0;}
.coc-faq-q{font-size:1rem;font-weight:700;color:#0f172a;margin-bottom:.55rem;cursor:pointer;display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;}
.coc-faq-q::after{content:'+';font-size:1.3rem;color:#2563eb;flex-shrink:0;}
.coc-faq-item.open .coc-faq-q::after{content:'−';}
.coc-faq-a{color:#475569;line-height:1.7;font-size:.96rem;display:none;}
.coc-faq-item.open .coc-faq-a{display:block;}
.coc-sidebar{position:sticky;top:6rem;display:flex;flex-direction:column;gap:1.25rem;}
.coc-widget{background:#fff;border-radius:12px;border:1px solid #e8edf5;box-shadow:0 4px 18px rgba(0,0,0,.05);overflow:hidden;}
.coc-widget-head{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;padding:1rem 1.25rem;}
.coc-widget-title{font-size:1rem;font-weight:700;}
.coc-widget-sub{font-size:.78rem;color:rgba(255,255,255,.78);margin-top:.15rem;}
.coc-widget-upd{font-size:.7rem;color:rgba(255,255,255,.6);margin-top:.3rem;}
.coc-widget-rows{padding:.35rem 0;}
.coc-widget-row{display:flex;justify-content:space-between;align-items:center;padding:.55rem 1.25rem;border-bottom:1px solid #f8fafc;transition:background .15s;}
.coc-widget-row:last-child{border-bottom:none;}
.coc-widget-row:hover{background:#eff6ff;}
.coc-wl{font-size:.82rem;font-weight:600;color:#334155;}
.coc-ws{font-size:.7rem;color:#94a3b8;}
.coc-wv{font-size:.92rem;font-weight:800;color:#2563eb;text-align:right;}
.coc-widget-foot{padding:.8rem 1.25rem;border-top:1px solid #f0f4fa;background:#f8fafc;}
.coc-widget-foot p{font-size:.73rem;color:#64748b;margin:0 0 .45rem;line-height:1.3;}
.coc-widget-foot a{font-size:.82rem;font-weight:700;color:#2563eb;text-decoration:none;display:flex;align-items:center;gap:.35rem;}
.coc-widget-foot a:hover{text-decoration:underline;}
.coc-quick-widget{background:#fff;border-radius:12px;border:1px solid #e8edf5;box-shadow:0 2px 12px rgba(0,0,0,.04);overflow:hidden;}
.coc-quick-head{padding:.85rem 1.25rem;background:#f8fafc;border-bottom:1px solid #f0f4fa;font-size:.82rem;font-weight:700;color:#2563eb;text-transform:uppercase;letter-spacing:.5px;}
.coc-quick-links{list-style:none;padding:.45rem 0;margin:0;}
.coc-quick-links li a{display:flex;align-items:center;gap:.5rem;padding:.6rem 1.25rem;font-size:.84rem;color:#475569;text-decoration:none;border-left:3px solid transparent;transition:all .15s;font-weight:500;}
.coc-quick-links li a:hover,.coc-quick-links li a.active{color:#2563eb;background:#eff6ff;border-left-color:#2563eb;}

/* AdSense Ad Containers */
.coc-ad-top{margin:1.5rem 0;text-align:center;min-height:90px;}
.coc-ad-mid{margin:2rem 0;text-align:center;min-height:250px;}
.coc-ad-bottom{margin:2rem 0;text-align:center;min-height:90px;}
.coc-ad-sidebar{margin:1rem 0;text-align:center;min-height:600px;}

/* Print styles */
@media print{
  .coc-toc,.coc-sidebar,.coc-ad-top,.coc-ad-mid,.coc-ad-bottom,.coc-ad-sidebar{display:none!important;}
  .coc-wrap{grid-template-columns:1fr!important;}
  .coc-card{box-shadow:none;border:1px solid #ccc;}
  body{background:#fff;}
}

/* Responsive */
@media(max-width:1200px){.coc-wrap{grid-template-columns:200px 1fr 240px;}}
@media(max-width:1024px){.coc-wrap{grid-template-columns:1fr;}.coc-toc,.coc-sidebar{position:static;}.coc-sidebar{display:grid;grid-template-columns:1fr 1fr;}}
@media(max-width:768px){.coc-wrap{padding:1rem 1rem 3rem;}.coc-inner{grid-template-columns:1fr;}.coc-form-col{border-right:none;border-bottom:1px solid #f0f4fa;}.coc-sidebar{grid-template-columns:1fr;}.coc-row2,.coc-row3{grid-template-columns:1fr;}}
</style>

