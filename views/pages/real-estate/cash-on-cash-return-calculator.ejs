    <!-- ══ CALCULATOR ══ -->
    <div class="coc-card" id="calculator">
      <div class="coc-card-head">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <h2>Cash-on-Cash Return Calculator</h2>
      </div>
      <div class="coc-inner">

        <!-- FORM -->
        <div class="coc-form-col">

          <div class="coc-sec-lbl" id="step-1">Purchase Details</div>
          <div class="coc-row2">
            <div class="coc-field">
              <label for="c-price">Purchase Price ($)</label>
              <input type="number" id="c-price" value="200000" min="0" step="1000" aria-label="Property purchase price in US dollar">
            </div>
            <div class="coc-field">
              <label for="c-down">Down Payment (%)</label>
              <input type="number" id="c-down" value="20" min="0" max="100" step="0.5" aria-label="Down payment percentage">
              <div class="hint">Conventional: 20% · FHA: 3.5% · All Cash: 100%</div>
            </div>
          </div>
          <div class="coc-row2">
            <div class="coc-field">
              <label for="c-closing">Closing Costs ($)</label>
              <input type="number" id="c-closing" value="4000" min="0" step="500" aria-label="Closing costs in US dollar">
              <div class="hint">Typically 2–5% of price</div>
            </div>
            <div class="coc-field">
              <label for="c-repair">Upfront Repairs ($)</label>
              <input type="number" id="c-repair" value="0" min="0" step="500" aria-label="Upfront repair costs in US dollar">
              <div class="hint">Rehab before first tenant</div>
            </div>
          </div>

          <div class="coc-sec-lbl" id="step-2">Mortgage / Financing</div>
          <div class="coc-row3">
            <div class="coc-field">
              <label for="c-rate">Interest Rate (%)</label>
              <input type="number" id="c-rate" value="7.25" min="0" max="25" step="0.05" aria-label="Annual mortgage interest rate">
            </div>
            <div class="coc-field">
              <label for="c-term">Loan Term (yrs)</label>
              <select id="c-term" aria-label="Loan term in year">
                <option value="30" selected>30 years</option>
                <option value="20">20 years</option>
                <option value="15">15 years</option>
                <option value="10">10 years</option>
              </select>
            </div>
            <div class="coc-field">
              <label for="c-loan-type">Loan Type</label>
              <select id="c-loan-type" aria-label="Type of mortgage loan">
                <option value="conventional" selected>Conventional</option>
                <option value="fha">FHA (3.5% down)</option>
                <option value="cash">All Cash</option>
              </select>
            </div>
          </div>

          <div class="coc-sec-lbl" id="step-3">Rental Income</div>
          <div class="coc-row2">
            <div class="coc-field">
              <label for="c-rent">Monthly Rent ($)</label>
              <input type="number" id="c-rent" value="1500" min="0" step="50" aria-label="Monthly rental income">
            </div>
            <div class="coc-field">
              <label for="c-vacancy">Vacancy Rate (%)</label>
              <input type="number" id="c-vacancy" value="5" min="0" max="50" step="0.5" aria-label="Expected vacancy rate percentage">
              <div class="hint">Typical: 5–10% · One month = 8.3%</div>
            </div>
          </div>

          <div class="coc-sec-lbl" id="step-4">Annual Operating Expenses</div>
          <div class="coc-row2">
