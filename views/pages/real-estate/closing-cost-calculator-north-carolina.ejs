    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Settlement Line Item</th>
            <th>Buyer Pays</th>
            <th>Seller Pays</th>
            <th>Typical Amount Range</th>
          </tr>
        </thead>
        <tbody>
          <tr><td><strong>NC Excise Stamp Tax</strong></td><td>No</td><td><strong>Yes</strong></td><td>$2.00 per $1,000 of sales price</td></tr>
          <tr><td><strong>Closing Attorney Legal Fee</strong></td><td><strong>Yes (~$900)</strong></td><td>Yes (~$250 doc prep)</td><td>Independent counsel representation</td></tr>
          <tr><td><strong>Title Insurance (Lender &amp; Owner)</strong></td><td><strong>Yes</strong></td><td>No</td><td>Promulgated NC rating (~$1,500 on $395k)</td></tr>
          <tr><td><strong>Boundary Survey &amp; Pest Inspection</strong></td><td><strong>Yes</strong></td><td>No</td><td>$500 &ndash; $750</td></tr>
