  </div>
</main>

<script>
function calculateNcCosts() {
  var price = parseFloat(document.getElementById('ncPrice').value) || 0;
  var role = document.getElementById('ncRole').value;
  var downPct = (parseFloat(document.getElementById('ncDownPct').value) || 20) / 100;
  var ddFee = parseFloat(document.getElementById('ncDueDiligence').value) || 0;
  var commPct = (parseFloat(document.getElementById('ncAgentComm').value) || 5.0) / 100;
  var attorney = parseFloat(document.getElementById('ncAttorney').value) || 900;
  var annualTax = parseFloat(document.getElementById('ncAnnualTax').value) || 3150;

  var isBuyer = (role === 'buyer');
  document.getElementById('groupNcDown').style.display = isBuyer ? 'block' : 'none';
  document.getElementById('groupNcComm').style.display = isBuyer ? 'none' : 'block';
  document.getElementById('rowNcDown').style.display = isBuyer ? 'table-row' : 'none';
  document.getElementById('rowNcComm').style.display = isBuyer ? 'none' : 'table-row';
  document.getElementById('rowNcEscrow').style.display = isBuyer ? 'table-row' : 'none';
  document.getElementById('rowNcDdCredit').style.display = isBuyer ? 'table-row' : 'none';

  var downPayment = isBuyer ? (price * downPct) : 0;
  var loanAmount = isBuyer ? Math.max(0, price - downPayment) : 0;

  // 1. NC Excise Stamp Tax ($1.00 per $500 / $2 per $1k) - Seller
  var exciseTax = Math.ceil(price / 500) * 1.00;

  // 2. Title Insurance (NC regulated rates)
  var titleInsurance = Math.max(600, (price * 0.0039) + 150);

  // 3. Broker Commission
  var commission = isBuyer ? 0 : (price * commPct);

  // 4. Lender Origination & Escrows
  var lenderFees = loanAmount > 0 ? 1450 : 0;
  var escrowPrepaids = isBuyer && (loanAmount > 0) ? (annualTax / 12 * 4) + 1100 : 0;
  var recording = 65;

  var totalCost = 0;
  var bottomLine = 0;

  if (isBuyer) {
    totalCost = titleInsurance + attorney + recording + lenderFees + escrowPrepaids;
    // Cash needed at close = Down payment + Closing costs - Due Diligence fee already paid
    bottomLine = Math.max(0, downPayment + totalCost - ddFee);

    document.getElementById('resNcRoleLabel').textContent = 'Total Buyer Closing Costs';
    document.getElementById('resNcBottomLine').textContent = 'Estimated Remaining Cash to Close: $' + Math.round(bottomLine).toLocaleString();
    document.getElementById('resNcCard1Title').textContent = 'Due Diligence Credit';
    document.getElementById('resNcCard1Val').textContent = '-$' + Math.round(ddFee).toLocaleString();
    document.getElementById('resNcCard1Desc').textContent = 'Credited toward cash to close';
    document.getElementById('resNcTitleFees').textContent = '$' + Math.round(titleInsurance).toLocaleString();
    document.getElementById('resNcAttorneyRecording').textContent = '$' + Math.round(attorney + recording).toLocaleString();
    document.getElementById('resNcCard4Title').textContent = 'Lender & Escrow Prepaids';
    document.getElementById('resNcCard4Val').textContent = '$' + Math.round(lenderFees + escrowPrepaids).toLocaleString();
    document.getElementById('resNcCard4Desc').textContent = 'Origination + Tax/Ins Buffer';
    document.getElementById('resSumNcFinalLabel').textContent = 'Total Remaining Cash to Close:';
    document.getElementById('resSumNcFinalVal').textContent = '$' + Math.round(bottomLine).toLocaleString();
  } else {
    totalCost = commission + exciseTax + (attorney * 0.35) + recording;
    var netProceeds = price - totalCost;

    document.getElementById('resNcRoleLabel').textContent = 'Total Seller Closing Costs';
    document.getElementById('resNcBottomLine').textContent = 'Estimated Net Sale Proceeds: $' + Math.round(netProceeds).toLocaleString();
    document.getElementById('resNcCard1Title').textContent = 'NC Excise Stamps ($2/$1k)';
    document.getElementById('resNcCard1Val').textContent = '$' + Math.round(exciseTax).toLocaleString();
    document.getElementById('resNcCard1Desc').textContent = '0.20% State Excise Deed Tax';
    document.getElementById('resNcTitleFees').textContent = '$0 (Paid by Buyer)';
    document.getElementById('resNcAttorneyRecording').textContent = '$' + Math.round((attorney * 0.35) + recording).toLocaleString();
    document.getElementById('resNcCard4Title').textContent = 'Broker Commission';
    document.getElementById('resNcCard4Val').textContent = '$' + Math.round(commission).toLocaleString();
    document.getElementById('resNcCard4Desc').textContent = (commPct * 100).toFixed(1) + '% Real Estate Commission';
    document.getElementById('resSumNcFinalLabel').textContent = 'Estimated Net Seller Proceeds:';
    document.getElementById('resSumNcFinalVal').textContent = '$' + Math.round(netProceeds).toLocaleString();
  }

  document.getElementById('resNcTotalCost').textContent = '$' + Math.round(totalCost).toLocaleString();
  document.getElementById('resSumNcPrice').textContent = '$' + Math.round(price).toLocaleString();
  document.getElementById('resSumNcDown').textContent = '$' + Math.round(downPayment).toLocaleString() + ' (' + (downPct * 100).toFixed(0) + '%)';
  document.getElementById('resSumNcComm').textContent = '$' + Math.round(commission).toLocaleString();
  document.getElementById('resSumNcExcise').textContent = '$' + Math.round(isBuyer ? 0 : exciseTax).toLocaleString();
  document.getElementById('resSumNcTitle').textContent = '$' + Math.round(isBuyer ? titleInsurance : 0).toLocaleString();
  document.getElementById('resSumNcAttorney').textContent = '$' + Math.round(isBuyer ? attorney : (attorney * 0.35)).toLocaleString();
  document.getElementById('resSumNcEscrow').textContent = '$' + Math.round(escrowPrepaids).toLocaleString();
  document.getElementById('resSumNcDdCredit').textContent = '-$' + Math.round(ddFee).toLocaleString();
}

document.querySelectorAll('#ncPrice, #ncRole, #ncDownPct, #ncDueDiligence, #ncAgentComm, #ncAttorney, #ncAnnualTax').forEach(function(el) {
  el.addEventListener('input', calculateNcCosts);
  el.addEventListener('change', calculateNcCosts);
});

calculateNcCosts();
</script>
