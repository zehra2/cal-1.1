<script>
function calculateNyCosts() {
  var price = parseFloat(document.getElementById('nyPrice').value) || 0;
  var loc = document.getElementById('nyLocation').value;
  var propType = document.getElementById('nyPropType').value;
  var role = document.getElementById('nyRole').value;
  var downPct = (parseFloat(document.getElementById('nyDownPct').value) || 0) / 100;
  var attorney = parseFloat(document.getElementById('nyAttorney').value) || 2500;
  var commPct = (parseFloat(document.getElementById('nyAgentComm').value) || 5.0) / 100;

  var downPayment = price * downPct;
  var loanAmount = Math.max(0, price - downPayment);

  // 1. Mansion Tax (Buyer paid on $1M+ sales)
  var mansionTax = 0;
  if (price >= 1000000) {
    if (loc === 'nyc') {
      if (price < 2000000) mansionTax = price * 0.0100;
      else if (price < 3000000) mansionTax = price * 0.0125;
      else if (price < 5000000) mansionTax = price * 0.0150;
      else if (price < 10000000) mansionTax = price * 0.0225;
      else if (price < 15000000) mansionTax = price * 0.0325;
      else if (price < 20000000) mansionTax = price * 0.0350;
      else if (price < 25000000) mansionTax = price * 0.0375;
      else mansionTax = price * 0.0390;
    } else {
      mansionTax = price * 0.0100;
    }
  }

  // 2. Mortgage Recording Tax (MRT) - Only if financed and NOT co-op
  var mrt = 0;
  if (loanAmount > 0 && propType !== 'coop') {
    if (loc === 'nyc') {
      if (loanAmount < 500000) {
        mrt = loanAmount * 0.0180;
      } else {
        mrt = loanAmount * 0.01925;
      }
    } else if (loc === 'commuter') {
      mrt = loanAmount * 0.0105;
    } else {
      mrt = loanAmount * 0.0075;
    }
  }

  // 3. Transfer Taxes (Seller paid customarily)
  var nysTransfer = 0;
  var nycTransfer = 0;

  // NYS Transfer Tax ($2 per $500 = 0.4%; 0.65% if $3M+ in NYC/commuter)
  if (price >= 3000000 && (loc === 'nyc' || loc === 'commuter')) {
    nysTransfer = price * 0.0065;
  } else {
    nysTransfer = price * 0.0040;
  }

  // NYC Transfer Tax (RPTT: 1.0% under $500k, 1.425% $500k+)
  if (loc === 'nyc') {
    if (price < 500000) {
      nycTransfer = price * 0.0100;
    } else {
      nycTransfer = price * 0.01425;
    }
  }
  var totalTransfer = nysTransfer + nycTransfer;

  // 4. Title Insurance (TIRSA rate approx 0.45% of price, Co-op has lien search ~$450)
  var titleFee = 0;
  if (propType === 'coop') {
    titleFee = 550; // Co-op search & UCC filing
  } else {
    titleFee = Math.max(800, price * 0.00455);
  }

  // 5. Lender / Escrow / Recording
  var lenderEscrow = loanAmount > 0 ? 3500 + (loanAmount * 0.006) : 800;
  var brokerComm = price * commPct;

  var totalCost = 0;
  var bottomAmt = 0;

  if (role === 'buyer') {
    totalCost = mansionTax + mrt + titleFee + attorney + lenderEscrow;
    bottomAmt = downPayment + totalCost;
    document.getElementById('resRoleLabel').textContent = 'Total Buyer Closing Costs';
    document.getElementById('resTransfer').textContent = '$0 (Paid by Seller)';
    document.getElementById('resBottomLabel').textContent = 'Total Cash Required at Closing (Down + Costs):';
  } else {
    totalCost = totalTransfer + brokerComm + attorney + 1200; // seller misc fees
    bottomAmt = price - totalCost;
    document.getElementById('resRoleLabel').textContent = 'Total Seller Deductions & Costs';
    document.getElementById('resTransfer').textContent = '$' + Math.round(totalTransfer).toLocaleString();
    document.getElementById('resMansion').textContent = '$0 (Paid by Buyer)';
    document.getElementById('resMrt').textContent = '$0 (Paid by Buyer)';
    document.getElementById('resBottomLabel').textContent = 'Estimated Net Proceeds to Seller (Before Loan Payoff):';
  }

  var costPct = price > 0 ? (totalCost / price) * 100 : 0;

  document.getElementById('resTotalCost').textContent = '$' + Math.round(totalCost).toLocaleString();
  document.getElementById('resCostPct').textContent = costPct.toFixed(2) + '% of Purchase Price';
  if (role === 'buyer') {
    document.getElementById('resMrt').textContent = '$' + Math.round(mrt).toLocaleString();
    document.getElementById('resMansion').textContent = '$' + Math.round(mansionTax).toLocaleString();
  }
  document.getElementById('resTitle').textContent = '$' + Math.round(titleFee).toLocaleString();
  document.getElementById('resAttorney').textContent = '$' + Math.round(attorney).toLocaleString();
  document.getElementById('resLender').textContent = '$' + Math.round(lenderEscrow).toLocaleString();
  document.getElementById('resBottomAmt').textContent = '$' + Math.round(bottomAmt).toLocaleString();
}

document.querySelectorAll('#nyPrice, #nyLocation, #nyPropType, #nyRole, #nyDownPct, #nyAttorney, #nyAgentComm').forEach(function(el) {
  el.addEventListener('input', calculateNyCosts);
  el.addEventListener('change', calculateNyCosts);
});
calculateNyCosts();
</script>
