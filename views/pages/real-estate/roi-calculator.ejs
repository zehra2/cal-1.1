<script>
function fmtC(v){return (v<0?'−':'')+'$'+Math.round(Math.abs(v)).toLocaleString();}
function fmtP(v){return v.toFixed(2)+'%';}
function calcROI(){
  var price=parseFloat(document.getElementById('r-price').value)||0;
  var down=parseFloat(document.getElementById('r-down').value)||0;
  var closing=parseFloat(document.getElementById('r-closing').value)||0;
  var repairs=parseFloat(document.getElementById('r-repairs').value)||0;
  var cf=parseFloat(document.getElementById('r-cashflow').value)||0;
  var appr=parseFloat(document.getElementById('r-appr').value)||0;
  var rate=parseFloat(document.getElementById('r-rate').value)||0;
  var term=parseInt(document.getElementById('r-term').value)||30;
  var hold=parseInt(document.getElementById('r-hold').value)||5;
  var sellPct=(parseFloat(document.getElementById('r-sell').value)||0)/100;
  var loanAmt=price-down;
  var totalCash=down+closing+repairs;
  // Principal paydown over hold period
  var r=rate/100/12,n=term*12;
  var pi=r>0?loanAmt*(r*Math.pow(1+r,n))/(Math.pow(1+r,n)-1):loanAmt/n;
  var bal=loanAmt;
  for(var m=0;m<hold*12;m++){var iP=bal*r;bal-=(pi-iP);}
  var principalPaid=loanAmt-Math.max(0,bal);
  // Appreciation
  var salePrice=price*Math.pow(1+appr/100,hold);
  var apprGain=salePrice-price;
  var sellCost=salePrice*sellPct;
  // Totals
  var totalCF=cf*hold;
  var netProfit=totalCF+apprGain+principalPaid-sellCost;
  var totalROI=totalCash>0?(netProfit/totalCash/hold)*100:0;
  var coc=totalCash>0?(cf/totalCash)*100:0;
  document.getElementById('r-roi').textContent=fmtP(totalROI);
  document.getElementById('r-roi').style.color=totalROI>=0?'#5b21b6':'#dc2626';
  document.getElementById('r-coc').textContent=fmtP(coc);
  document.getElementById('r-equity').textContent=fmtC(salePrice-Math.max(0,bal)-sellCost);
  document.getElementById('r-totalcf').textContent=fmtC(totalCF);
  document.getElementById('r-profit').textContent=fmtC(netProfit);
  document.getElementById('rl-invested').textContent=fmtC(totalCash);
  document.getElementById('rl-cf').textContent=fmtC(totalCF);
  document.getElementById('rl-appr').textContent=fmtC(apprGain);
  document.getElementById('rl-equity').textContent=fmtC(principalPaid);
  document.getElementById('rl-sell').textContent='−'+fmtC(sellCost).replace('−','').replace('$','$');
  document.getElementById('rl-profit').textContent=fmtC(netProfit);
  document.getElementById('r-result').style.display='block';
}
document.querySelectorAll('#r-price,#r-down,#r-closing,#r-repairs,#r-cashflow,#r-appr,#r-rate,#r-term,#r-hold,#r-sell').forEach(function(el){el.addEventListener('input',calcROI);});
calcROI();
document.querySelectorAll('.rc-faq-q').forEach(function(q){q.addEventListener('click',function(){var i=this.closest('.rc-faq-item'),w=i.classList.contains('open');document.querySelectorAll('.rc-faq-item').forEach(function(x){x.classList.remove('open');});if(!w)i.classList.add('open');});});
</script>
