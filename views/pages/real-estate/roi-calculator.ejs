.rc-field input:focus{border-color:#7c3aed;}
.rc-field .hint{font-size:.73rem;color:#94a3b8;margin-top:.25rem;}
.rc-btn{width:100%;background:#5b21b6;color:#fff;padding:13px;border:none;border-radius:8px;font-size:.97rem;font-weight:700;cursor:pointer;margin-top:.5rem;}
.rc-btn:hover{background:#7c3aed;}
.rc-result{background:#f5f3ff;border:1.5px solid #ddd6fe;border-radius:10px;padding:1.25rem 1.5rem;margin-top:1.25rem;}
