.rc-result-primary .val{font-size:2.4rem;font-weight:800;color:#5b21b6;display:block;line-height:1;}
.rc-result-primary .lbl{font-size:.83rem;color:#64748b;}
.rc-stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.65rem;margin-bottom:.85rem;}
.rc-stat{background:#fff;border-radius:8px;padding:.75rem;text-align:center;border:1px solid #ede9fe;}
.rc-stat .sv{display:block;font-size:.97rem;font-weight:800;color:#5b21b6;}
.rc-stat .sl{font-size:.69rem;color:#64748b;font-weight:600;line-height:1.3;}
.rc-breakdown{background:#fff;border:1px solid #ede9fe;border-radius:8px;padding:.75rem 1rem;}
.rc-line{display:flex;justify-content:space-between;padding:.3rem 0;border-bottom:1px solid #f5f3ff;font-size:.86rem;}
.rc-line:last-child{border-bottom:none;font-weight:700;}
.rc-line .ll{color:#64748b;}.rc-line .lv{font-weight:600;color:#1e293b;}
.rc-section{background:#fff;border-radius:12px;border:1px solid #e2e8f0;padding:1.75rem;margin-bottom:1.5rem;}
.rc-section h2{font-size:1.3rem;color:#0f172a;margin:0 0 .85rem;padding-bottom:.6rem;border-bottom:2px solid #f5f3ff;}
