        <tr>
          <td style="padding:10px 12px;border:1px solid #fde68a;"><strong>The 1% Rule</strong></td>
          <td style="padding:10px 12px;border:1px solid #fde68a;">Monthly Rent &divide; Purchase Price &times; 100</td>
          <td style="padding:10px 12px;border:1px solid #fde68a;">&ge; 1.0% (e.g., $2,000/mo on a $200k property)</td>
        </tr>
