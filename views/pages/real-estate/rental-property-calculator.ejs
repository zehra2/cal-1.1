<script>
function fmtC(v){return (v<0?'−':'')+'$'+Math.round(Math.abs(v)).toLocaleString();}
function fmtP(v){return v.toFixed(2)+'%';}
function calcRP(){
  var price=parseFloat(document.getElementById('rp-price').value)||0;
  var downPct=parseFloat(document.getElementById('rp-down').value)||0;
  var rate=parseFloat(document.getElementById('rp-rate').value)||0;
  var term=parseInt(document.getElementById('rp-term').value)||30;
  var rent=parseFloat(document.getElementById('rp-rent').value)||0;
  var vac=parseFloat(document.getElementById('rp-vac').value)||0;
  var tax=parseFloat(document.getElementById('rp-tax').value)||0;
  var ins=parseFloat(document.getElementById('rp-ins').value)||0;
  var maint=parseFloat(document.getElementById('rp-maint').value)||0;
  var mgmt=parseFloat(document.getElementById('rp-mgmt').value)||0;
  var hoa=parseFloat(document.getElementById('rp-hoa').value)||0;
  var loanAmt=price*(1-downPct/100);
  var cashInvested=price*(downPct/100);
  var r=rate/100/12,n=term*12;
  var pi=r>0?loanAmt*(r*Math.pow(1+r,n))/(Math.pow(1+r,n)-1):loanAmt/n;
  var grossRent=rent*12;
  var vacLoss=grossRent*(vac/100);
  var egi=grossRent-vacLoss;
  var mgmtFee=egi*(mgmt/100);
  var totalExp=tax+ins+maint+mgmtFee+hoa;
  var noi=egi-totalExp;
  var annDebt=pi*12;
  var annCF=noi-annDebt;
  var moCF=annCF/12;
  var capRate=price>0?(noi/price)*100:0;
  var coc=cashInvested>0?(annCF/cashInvested)*100:0;
  var yield_=price>0?(grossRent/price)*100:0;
  document.getElementById('rp-cashflow').textContent=fmtC(moCF);
  document.getElementById('rp-cashflow').style.color=moCF>=0?'#92400e':'#dc2626';
  document.getElementById('rp-caprate').textContent=fmtP(capRate);
  document.getElementById('rp-coc').textContent=fmtP(coc);
  document.getElementById('rp-yield').textContent=fmtP(yield_);
  document.getElementById('rp-noi').textContent=fmtC(noi);
  document.getElementById('rp-pi').textContent=fmtC(pi);
  document.getElementById('rl-rent').textContent=fmtC(grossRent);
  document.getElementById('rl-egi').textContent=fmtC(egi);
  document.getElementById('rl-exp').textContent='−'+fmtC(totalExp).replace('−','').replace('$','$');
  document.getElementById('rl-noi').textContent=fmtC(noi);
  document.getElementById('rl-debt').textContent='−'+fmtC(annDebt).replace('−','').replace('$','$');
  document.getElementById('rl-cf').textContent=fmtC(annCF);
  document.getElementById('rl-cf').style.color=annCF>=0?'#92400e':'#dc2626';
  document.getElementById('rp-result').style.display='block';
}
document.querySelectorAll('#rp-price,#rp-down,#rp-rate,#rp-term,#rp-rent,#rp-vac,#rp-tax,#rp-ins,#rp-maint,#rp-mgmt,#rp-hoa').forEach(function(el){el.addEventListener('input',calcRP);el.addEventListener('change',calcRP);});
calcRP();
document.querySelectorAll('.rc-faq-q').forEach(function(q){q.addEventListener('click',function(){var i=this.closest('.rc-faq-item'),w=i.classList.contains('open');document.querySelectorAll('.rc-faq-item').forEach(function(x){x.classList.remove('open');});if(!w)i.classList.add('open');});});
</script>
