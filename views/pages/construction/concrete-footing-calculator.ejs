<script>
document.addEventListener('DOMContentLoaded',function(){
  const tabs=document.querySelectorAll('button.cf-tab');
  const panels=document.querySelectorAll('.cf-panel');
  let mode='fp-strip';
  
  tabs.forEach(t=>t.addEventListener('click',()=>{
    tabs.forEach(x=>x.classList.remove('active'));
    panels.forEach(p=>p.classList.remove('active'));
    t.classList.add('active');
    mode=t.getAttribute('data-panel');
    const target=document.getElementById(mode);
    if(target) target.classList.add('active');
    calc();
  }));

  function calc(){
    const price=parseFloat(document.getElementById('cf_price')?.value)||160;
    const waste=parseFloat(document.getElementById('cf_waste')?.value)||10;
    let cfUnit=0, qty=1;
    if(mode==='fp-strip'){
      const L=parseFloat(document.getElementById('st_l')?.value)||0;
      const W=parseFloat(document.getElementById('st_w')?.value)||0;
      const D=parseFloat(document.getElementById('st_d')?.value)||0;
      cfUnit=L*W*D; qty=1;
    } else if(mode==='fp-pad'){
      const L=parseFloat(document.getElementById('pp_l')?.value)||0;
      const W=parseFloat(document.getElementById('pp_w')?.value)||0;
      const D=parseFloat(document.getElementById('pp_d')?.value)||0;
      qty=parseInt(document.getElementById('pp_q')?.value)||1;
      cfUnit=L*W*D;
    } else {
      const d=parseFloat(document.getElementById('ph_d')?.value)||0;
      const dep=parseFloat(document.getElementById('ph_dep')?.value)||0;
      qty=parseInt(document.getElementById('ph_q')?.value)||1;
      const r=(d/12)/2;
      cfUnit=Math.PI*r*r*(dep/12);
    }
    if(cfUnit<=0) return;
    const cfNet=cfUnit*qty;
    const cfW=cfNet*(1+waste/100);
    const cyW=cfW/27;
    const cost=cyW*price;
    const b60=Math.ceil(cfW/0.45);
    const b80=Math.ceil(cfW/0.60);
    const fmtC=v=>'$'+Math.round(v).toLocaleString('en-US');
    const fmtN=(v,d=2)=>Number(v).toFixed(d);

    const setTxt=(id,txt)=>{
      const el=document.getElementById(id);
      if(el) el.textContent=txt;
    };

    setTxt('cf-yard', fmtN(cyW,2)+' yd³');
    setTxt('cf-yards', fmtN(cyW,2)+' yd³');
    setTxt('cf-cf', fmtN(cfW,1)+' ft³');
    setTxt('cf-cost', fmtC(cost));
    setTxt('cf-b60', b60.toLocaleString());
    setTxt('cf-b80', b80.toLocaleString());
    setTxt('cf-per-unit', fmtN(cfUnit,3)+' ft³');
    setTxt('cf-unit', qty);
    setTxt('cf-units', qty);
    setTxt('cf-total-net', fmtN(cfNet,2)+' ft³ / '+fmtN(cfNet/27,2)+' yd³');
    setTxt('cf-waste-amt', fmtN(cfW-cfNet,2)+' ft³ ('+waste+'%)');
    setTxt('cf-order', fmtN(cyW,2)+' yd³');
    setTxt('cf-sub', qty+' unit(s) × '+fmtN(cfUnit,2)+' ft³ + '+waste+'% waste');
  }

  document.querySelectorAll('.cf-field input,.cf-field select').forEach(el=>{
    el.addEventListener('input',calc);
    el.addEventListener('change',calc);
    el.addEventListener('keyup',calc);
  });
  const btn = document.getElementById('cf-btn');
  if(btn) btn.addEventListener('click',calc);
  calc();
  document.querySelectorAll('.cf-faq-q').forEach(q=>{
    q.addEventListener('click',function(){
      const i=this.closest('.cf-faq-item');
      if(!i) return;
      const w=i.classList.contains('open');
      document.querySelectorAll('.cf-faq-item').forEach(x=>x.classList.remove('open'));
      if(!w)i.classList.add('open');
    });
  });
});
</script>
