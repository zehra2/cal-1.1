      <div class="cf-bc"><a href="<%= baseUrl %>/index.php">Home</a> › <a href="<%= baseUrl %>/construction/">Construction</a> › <a href="<%= baseUrl %>/construction/concrete-calculator">Concrete Calculator</a> › Footing Calculator</div>
      <h1>Concrete Footing Calculator (<%= currentYear %>) – Strip, Pad &amp; Post Hole</h1>
      <p class="cf-desc">Calculate concrete for strip footings, pad footings, and round post holes. Get cubic yards, bag counts, and material cost — with frost depth guidance by US region.</p>
    </div>

    <div class="cf-card" id="calculator">
      <div class="cf-tabs">
        <button class="cf-tab active" data-panel="fp-strip">📏 Strip Footing</button>
        <button class="cf-tab" data-panel="fp-pad">⬛ Pad Footing</button>
        <button class="cf-tab" data-panel="fp-post">🪵 Post Holes</button>
      </div>
      <div class="cf-inner">
        <div class="cf-form">
          <!-- Strip Footing -->
          <div id="fp-strip" class="cf-panel active">
            <p style="font-size:.85rem;color:#64748b;margin-bottom:1.5rem;">For continuous foundation footings, retaining wall footings, and building perimeter footings.</p>
            <div class="cf-row2">
              <div class="cf-field"><label for="st_l">Total Length (ft)</label><input type="number" id="st_l" value="80" min="0.1" step="0.1"><div class="cf-hint">Perimeter of building or total linear footage</div></div>
              <div class="cf-field"><label for="st_w">Width (ft)</label><input type="number" id="st_w" value="1.5" min="0.1" step="0.1"><div class="cf-hint">Typical: 1.0–2.0 ft wide</div></div>
            </div>
            <div class="cf-field"><label for="st_d">Depth (ft)</label><input type="number" id="st_d" value="1.0" min="0.1" step="0.1"><div class="cf-hint">Must be below frost line — see guide below</div></div>
          </div>
          <!-- Pad Footing -->
          <div id="fp-pad" class="cf-panel">
            <p style="font-size:.85rem;color:#64748b;margin-bottom:1.5rem;">For isolated column footings, post bases, and deck piers (square or rectangular).</p>
            <div class="cf-row2">
              <div class="cf-field"><label for="pp_l">Length (ft)</label><input type="number" id="pp_l" value="2" min="0.1" step="0.1"></div>
              <div class="cf-field"><label for="pp_w">Width (ft)</label><input type="number" id="pp_w" value="2" min="0.1" step="0.1"></div>
            </div>
            <div class="cf-row2">
              <div class="cf-field"><label for="pp_d">Depth (ft)</label><input type="number" id="pp_d" value="1" min="0.1" step="0.1"></div>
              <div class="cf-field"><label for="pp_q">Quantity</label><input type="number" id="pp_q" value="4" min="1" step="1"></div>
            </div>
          </div>
          <!-- Post Holes -->
          <div id="fp-post" class="cf-panel">
            <p style="font-size:.85rem;color:#64748b;margin-bottom:1.5rem;">For fence posts, deck posts, mailbox posts, and any round concrete-filled hole.</p>
            <div class="cf-row2">
              <div class="cf-field"><label for="ph_d">Hole Diameter (in)</label><input type="number" id="ph_d" value="10" min="2" step="1"><div class="cf-hint">4×4 post: 8–10 in · 6×6 post: 12 in</div></div>
              <div class="cf-field"><label for="ph_dep">Hole Depth (in)</label><input type="number" id="ph_dep" value="24" min="4" step="1"><div class="cf-hint">Minimum 1/3 of post length above grade</div></div>
            </div>
            <div class="cf-field"><label for="ph_q">Number of Holes</label><input type="number" id="ph_q" value="10" min="1" step="1"></div>
          </div>

          <div style="border-top:1px dashed #e2e8f0;margin-top:1.25rem;padding-top:1.25rem;">
            <div class="cf-row2">
              <div class="cf-field"><label for="cf_price">Price ($/yd³)</label><input type="number" id="cf_price" value="160" min="50" step="5"></div>
              <div class="cf-field"><label for="cf_waste">Waste (%)</label><input type="number" id="cf_waste" value="10" min="0" max="30" step="1"></div>
            </div>
          </div>
          <button class="cf-btn" id="cf-btn">⚡ Calculate Footing</button>
        </div>

        <div class="cf-res">
          <h3 style="font-size:1.15rem;font-weight:700;color:#0f172a;margin:0 0 .25rem;">Footing Results</h3>
          <p style="font-size:.84rem;color:#64748b;margin:0 0 1.25rem;" id="cf-sub">Live calculation active</p>
          <div class="cf-primary">
