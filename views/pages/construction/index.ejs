<script>
document.querySelectorAll('.hub-faq-q').forEach(function(q){
  q.addEventListener('click',function(){
    var item=this.closest('.hub-faq-item');
    var wasOpen=item.classList.contains('open');
    document.querySelectorAll('.hub-faq-item').forEach(function(x){x.classList.remove('open');});
    if(!wasOpen) item.classList.add('open');
  });
});
