.hub-card-icon{font-size:2rem;line-height:1;}
.hub-card-name{font-size:1.05rem;font-weight:700;color:#0f172a;}
.hub-card-desc{font-size:.87rem;color:#64748b;line-height:1.6;flex:1;}
.hub-card-cta{font-size:.82rem;font-weight:700;color:#d97706;display:flex;align-items:center;gap:.3rem;}
.hub-card-cta::after{content:'→';}
.hub-card.featured{border-color:#f59e0b;background:linear-gradient(135deg,#fffbeb 0%,#fff 60%);}
.hub-card.featured .hub-card-name{color:#92400e;}
.hub-info{background:#fff;border-radius:12px;border:1px solid #e2e8f0;padding:1.75rem;margin-bottom:1.5rem;}
.hub-info h2{font-size:1.2rem;color:#0f172a;margin:0 0 .85rem;padding-bottom:.5rem;border-bottom:2px solid #fef3c7;}
.hub-info p{color:#475569;line-height:1.72;font-size:.95rem;margin-bottom:.85rem;}
.hub-info p:last-child{margin-bottom:0;}
.hub-faq-item{border-bottom:1px solid #f1f5f9;padding:.8rem 0;}
.hub-faq-item:last-child{border-bottom:none;}
.hub-faq-q{font-size:.95rem;font-weight:700;color:#0f172a;cursor:pointer;display:flex;justify-content:space-between;gap:1rem;padding:.25rem 0;}
.hub-faq-q::after{content:'+';color:#d97706;font-size:1.2rem;flex-shrink:0;}
.hub-faq-item.open .hub-faq-q::after{content:'−';}
.hub-faq-a{display:none;color:#475569;font-size:.9rem;line-height:1.68;padding-top:.5rem;}
.hub-faq-item.open .hub-faq-a{display:block;}
.hub-tip{background:#fef3c7;border:1.5px solid #fde68a;border-radius:10px;padding:1.1rem 1.4rem;font-size:.9rem;color:#78350f;line-height:1.65;margin-top:1.5rem;}
@media(max-width:640px){.hub-hero h1{font-size:1.55rem;}}
