<script>
// ==========================================================================
// REAL-TIME STAIR CALCULATOR JAVASCRIPT ENGINE
// ==========================================================================

function calcStairs() {
  const totalRise = parseFloat(document.getElementById('total_rise').value) || 0;
  const idealRise = parseFloat(document.getElementById('ideal_rise').value) || 7.5;
  const idealRun  = parseFloat(document.getElementById('ideal_run').value) || 10.5;

  if (totalRise <= 0 || idealRise <= 0 || idealRun <= 0) return;

  const numRisers = Math.max(1, Math.round(totalRise / idealRise));
  const actualRise = totalRise / numRisers;
  const numTreads  = Math.max(0, numRisers - 1);
  const totalRun   = numTreads * idealRun;
  const stringerLength = Math.sqrt(Math.pow(totalRise, 2) + Math.pow(totalRun, 2));
  const angle = totalRun > 0 ? Math.atan(totalRise / totalRun) * (180 / Math.PI) : 0;
  const comfort = (2 * actualRise) + idealRun;

  // Update Answer Row Elements
  document.getElementById('res_num_risers').textContent = numRisers + ' Risers';
  document.getElementById('res_actual_rise').textContent = actualRise.toFixed(2);
  document.getElementById('res_num_treads').textContent  = numTreads + ' Treads';
  document.getElementById('res_tread_depth').textContent = idealRun.toFixed(1);
  document.getElementById('res_total_run').textContent   = totalRun.toFixed(1) + '"';
  document.getElementById('res_total_run_ft').textContent = (totalRun / 12).toFixed(2);
  document.getElementById('res_stringer').textContent    = stringerLength.toFixed(1) + '"';
  document.getElementById('res_stringer_ft').textContent = (stringerLength / 12).toFixed(2);
  document.getElementById('res_angle').textContent       = angle.toFixed(1) + '°';

  // Code Status Check
  const isCodeCompliant = actualRise <= 7.75 && idealRun >= 10.0;
  const badgeEl = document.getElementById('res_code_badge');
  if (isCodeCompliant) {
    badgeEl.textContent = '✓ IRC Code Pass';
    badgeEl.style.color = '#059669';
  } else {
    badgeEl.textContent = '⚠️ Check IRC Code';
    badgeEl.style.color = '#dc2626';
  }

  // Comfort Rule (2R + T)
  document.getElementById('res_comfort').textContent = comfort.toFixed(1) + '"';
  const comfortDescEl = document.getElementById('res_comfort_desc');
  if (comfort >= 24 && comfort <= 25.5) {
    comfortDescEl.textContent = 'Ideal Stride Comfort';
    comfortDescEl.style.color = '#059669';
  } else if (comfort < 24) {
    comfortDescEl.textContent = 'Shallow / Short Stride';
    comfortDescEl.style.color = '#b45309';
  } else {
    comfortDescEl.textContent = 'Steep / Long Stride';
    comfortDescEl.style.color = '#b45309';
  }

  // Lumber Length Recommendation
  const minLumberFt = Math.ceil((stringerLength / 12) + 0.5);
  // Standard lumber lengths are even numbers (10, 12, 14, 16, 18, 20)
  const standardLumberFt = minLumberFt % 2 === 0 ? minLumberFt : minLumberFt + 1;
  document.getElementById('res_lumber').textContent = 'Order ' + Math.max(8, standardLumberFt) + ' ft 2x12 boards';
}

function stSetHeight(inches) {
  document.getElementById('total_rise').value = inches;
  calcStairs();
}

function stReset() {
  document.getElementById('total_rise').value = 108;
  document.getElementById('ideal_rise').value = 7.5;
  document.getElementById('ideal_run').value = 10.5;
  calcStairs();
}

function stToggleFaq(el) {
  const card = el.closest('.st-faq-card');
  const wasOpen = card.classList.contains('open');
  document.querySelectorAll('.st-faq-card').forEach(c => c.classList.remove('open'));
  if (!wasOpen) card.classList.add('open');
}

// Initial calculation on page load
document.addEventListener('DOMContentLoaded', function() {
  calcStairs();
});
</script>
