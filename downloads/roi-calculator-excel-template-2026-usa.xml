 <Row/>
 <Row><Cell ss:MergeAcross="2" ss:StyleID="note"><Data ss:Type="String">Source: AmericaCalculator.com/business/roi-calculator — Free ROI Calculator 2026 USA</Data></Cell></Row>
</Table>
