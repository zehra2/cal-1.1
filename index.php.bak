<script>
// â”€â”€ Homepage mini calculator â”€â”€
(function () {
  var expr = document.getElementById('hp-expr');
  var val  = document.getElementById('hp-val');
  if (!expr || !val) return;

  var cur = '0', mem = null, op = null, fresh = false;

  function upd() { val.textContent = cur; }

  window.hpNum = function (n) {
    if (fresh || cur === '0') { cur = n; fresh = false; }
    else if (cur.length < 12) cur += n;
    upd();
  };
  window.hpDot = function () {
    if (fresh) { cur = '0.'; fresh = false; upd(); return; }
    if (!cur.includes('.')) { cur += '.'; upd(); }
  };
  window.hpAC = function () {
    cur = '0'; mem = null; op = null; fresh = false;
    expr.innerHTML = '&nbsp;'; upd();
  };
  window.hpSign = function () {
    cur = String(parseFloat(cur) * -1); upd();
  };
  window.hpPct = function () {
    cur = String(parseFloat(cur) / 100); upd();
  };
  window.hpOp = function (o) {
    mem = parseFloat(cur); op = o; fresh = true;
    var sym = {'/':'Ã·','*':'Ã—','-':'âˆ’','+':'+'}[o] || o;
    expr.textContent = mem + ' ' + sym;
  };
  window.hpEq = function () {
    if (mem === null || !op) return;
    var b = parseFloat(cur), r;
    if (op === '/' && b === 0) { cur = 'Error'; expr.innerHTML = '&nbsp;'; op = null; upd(); return; }
    if (op === '+') r = mem + b;
    else if (op === '-') r = mem - b;
    else if (op === '*') r = mem * b;
    else if (op === '/') r = mem / b;
    else r = b;
    expr.textContent = mem + ' ' + cur + ' =';
    cur = String(parseFloat(r.toFixed(10)));
    mem = null; op = null; fresh = true;
    upd();
  };
})();

// â”€â”€ FAQ accordion â”€â”€
document.querySelectorAll('.faq-q').forEach(function (q) {
  q.addEventListener('click', function () {
    var item    = this.closest('.faq-item');
    var wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(function (i) { i.classList.remove('open'); });
    if (!wasOpen) item.classList.add('open');
  });
});
</script>

